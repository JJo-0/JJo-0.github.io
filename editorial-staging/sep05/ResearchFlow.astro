---
interface Step { title: string; detail: string }
interface Props { title: string; steps: Step[]; caption: string; source: string; mode?: 'sequence' | 'comparison' }
const { title, steps, caption, source, mode = 'sequence' } = Astro.props;
---
<figure class:list={['research-flow', mode]} data-research-flow>
  <div class="flow-title">{title}</div>
  <ol class="flow-steps">
    {steps.map((step, index) => <li>
      {mode === 'sequence' && <span class="flow-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
      <strong>{step.title}</strong><p>{step.detail}</p>
    </li>)}
  </ol>
  <figcaption>{caption} <a href={source} target="_blank" rel="noopener noreferrer">근거 자료</a></figcaption>
</figure>
<style>
  .research-flow { width:100%; min-width:0; margin:2rem 0; padding:1.1rem; border:1px solid var(--color-border); border-radius:.6rem; }
  .flow-title { font-size:1.02rem; font-weight:750; line-height:1.7; margin-bottom:1rem; }
  .flow-steps { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:.8rem; list-style:none; padding:0; margin:0; }
  .flow-steps li { min-width:0; margin:0; padding:1rem; background:var(--color-muted); border:1px solid var(--color-border); border-radius:.35rem; }
  .flow-number { display:block; margin-bottom:.4rem; font-size:.75rem; color:var(--color-muted-foreground); }
  .flow-steps strong { display:block; font-size:.98rem; line-height:1.65; }
  .flow-steps p { margin:.5rem 0 0; font-size:.93rem; line-height:1.85; overflow-wrap:anywhere; }
  figcaption { margin-top:1rem; font-size:.86rem; line-height:1.85; color:var(--color-muted-foreground); }
  figcaption a { text-decoration:underline; }
  @media (max-width:540px) { .flow-steps { grid-template-columns:1fr; } .research-flow { padding:.8rem; } }
</style>
