      "linkPolicy": "caption-summary-plus-profile-link-or-story-link",
      "musicPolicy": "original-or-documented-platform-cleared-only"
    }
  },
  "brand": {
    "promise": "처음 보는 독자가 개념을 이해하고 다음 행동까지 선택하게 한다.",
    "voice": ["한국어 우선", "결론 먼저", "과정과 용어를 먼저 설명", "근거와 한계를 분리"],
