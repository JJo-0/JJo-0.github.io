{
  "version": 1,
  "name": "JJo reader-first publishing harness",
  "controlPlane": {
    "type": "google-sheets",
    "spreadsheetId": "1-5g02pG6aQgNJ6uceDNrDChxeojaYmvaLzneT4ZsM3c",
    "queueSheet": "편집대기열",
    "channelSheet": "채널발행",
    "agentSheet": "에이전트운영",
    "rightsSheet": "미디어저작권",
    "runLogSheet": "실행로그"
  },
  "channels": {
    "gitblog": {
      "enabled": true,
      "canonicalByDefault": true,
      "baseUrl": "https://jjo-0.github.io",
      "publishMode": "git-reviewed-push"
    },
    "blogger": {
      "enabled": true,
      "baseUrl": "https://jjo-0.blogspot.com",
      "publishMode": "blogger-api-with-explicit-publish-flag"
    },
    "instagram": {
      "enabled": false,
      "publishMode": "export-only-until-meta-api-connected",
      "formats": ["feed-4x5", "carousel-4x5", "reel-9x16", "story-9x16"],
      "linkPolicy": "caption-summary-plus-profile-link-or-story-link",
      "musicPolicy": "original-or-documented-platform-cleared-only"
    }
  },
  "brand": {
    "promise": "처음 보는 독자가 개념을 이해하고 다음 행동까지 선택하게 한다.",
    "voice": ["한국어 우선", "결론 먼저", "과정과 용어를 먼저 설명", "근거와 한계를 분리"],
    "visualSystem": {
      "palette": ["#1F4E78", "#D9EAF7", "#F3EFE4", "#315E51", "#1D211C"],
      "coverRule": "한 장에 핵심 질문 하나, 고유 도식 하나, 12단어 이하 제목",
      "diagramRule": "원본 도식 또는 재사용 권리가 확인된 도식만 사용",
      "motionRule": "9:16 세로, 첫 2초 질문, 3단계 설명, 마지막에 원문 경로",
      "forbidden": [
        "출처 불명 이미지",
        "워터마크 제거",
        "검색 결과 이미지 재업로드",
        "권리 불명 음악"
      ]
    }
  },
  "gates": [
    "reader-brief",
    "source-evidence",
    "media-rights",
    "channel-link",
    "human-approval",
    "live-qa"
  ],
  "agents": [
    { "id": "editor-in-chief", "role": "운영 편집장", "owns": "우선순위, 단계 전환, 승인 요청" },
    { "id": "search-intent", "role": "검색 수요", "owns": "실제 검색어, 의도 분류, 공백 탐지" },
    { "id": "reader-journey", "role": "독자 설계", "owns": "한 줄 답, 초보 흐름, 다음 글 이동" },
    { "id": "evidence", "role": "출처 검증", "owns": "공식 자료, 사실, 인용, 최신성" },
    { "id": "writer", "role": "원천 글 작성", "owns": "GitBlog 중심 원고와 설명 구조" },
    {
      "id": "media-director",
      "role": "미디어 디렉터",
      "owns": "도식, 이미지, 영상 스토리보드, 대체 텍스트"
    },
    {
      "id": "rights",
      "role": "저작권 관리자",
      "owns": "소유자, 라이선스, 허용 범위, 표시 문구, 만료"
    },
    {
      "id": "channel-adapter",
      "role": "채널 변환",
      "owns": "Blogger HTML, Instagram 카드·릴스·캡션"
    },
    {
      "id": "qa-publisher",
      "role": "검수·발행",
      "owns": "링크, 렌더링, 승인, 배포, 실페이지 확인"
    },
    { "id": "analytics", "role": "성과 분석", "owns": "Google·Naver·Instagram 지표와 다음 실험" }
  ],
  "cadence": {
    "daily": ["broken-link-on-new-content", "publish-queue-state"],
    "weekly": ["search-query-refresh", "reader-path-review", "instagram-pack-review"],
    "monthly": ["copyright-and-license-recheck", "cluster-gap-review", "performance-retrospective"]
  }
}
