---
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { postPath } from '@/lib/i18n';
import NewsFigure from '@/components/post/NewsFigure.astro';
import translations from '../../site/translations.json';
import catalogue from '../../site/news-media.json';

const posts = (await getPublishedPosts('en')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const mediaIds = Object.keys(catalogue) as Array<keyof typeof catalogue>;
const cards = posts.map((post) => {
  const pair = translations.pairs.find((item) => item.enSlug === getPostSlug(post));
  if (!pair) throw new Error(`Unpaired English NEWS post: ${getPostSlug(post)}`);
  const mediaId = mediaIds.find((id) => catalogue[id].slug === pair.koSlug);
  if (!mediaId) throw new Error(`Missing representative image: ${pair.koSlug}`);
  return { post, mediaId };
});
---

<div class="english-news-list">
  {cards.map(({ post, mediaId }) => (
    <div class="english-news-card" data-en-news-card>
      <div class="english-news-image">
        <NewsFigure media={mediaId} lang="en" compact />
      </div>
      <div>
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
        <h2><a href={postPath(post)}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <a href={postPath(post)} class="english-news-read">Read the full explanation →</a>
      </div>
    </div>
  ))}
</div>

<style>
  .english-news-card { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 1.5rem; padding: 1.7rem 0; border-bottom: 1px solid var(--color-border); }
  .english-news-image { min-width: 0; }
  .english-news-card time { font-size: .75rem; color: var(--color-muted-foreground); }
  .english-news-card h2 { font-family: var(--font-editorial); font-size: 1.7rem; line-height: 1.2; margin: .5rem 0; }
  .english-news-card h2 a { text-decoration: none; }
  .english-news-card p { line-height: 1.75; color: var(--color-muted-foreground); margin: .7rem 0; }
  .english-news-read { font-size: .85rem; }
  @media (max-width: 640px) { .english-news-card { grid-template-columns: 1fr; gap: 1rem; } }
</style>
