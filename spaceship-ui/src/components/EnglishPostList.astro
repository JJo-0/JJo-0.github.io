---
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { postPath } from '@/lib/i18n';
import translations from '../../site/translations.json';
import catalogue from '../../site/news-media.json';
import englishCaptions from '../../site/news-media-en.json';
const posts = (await getPublishedPosts('en')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<div class="english-news-list">
{posts.map((post) => {
  const pair = translations.pairs.find((item) => item.enSlug === getPostSlug(post));
  const media = pair ? Object.values(catalogue).find((item) => item.slug === pair.koSlug) : undefined;
  const mediaId = pair ? Object.entries(catalogue).find(([, item]) => item.slug === pair.koSlug)?.[0] : undefined;
  const caption = mediaId ? (englishCaptions as Record<string, { alt?: string }>)[mediaId] : undefined;
  return <div class="english-news-card" data-en-news-card>
    {media && <a href={postPath(post)} class="english-news-image"><img src={media.src} alt={caption?.alt || post.data.title} width={media.width} height={media.height} loading="lazy" decoding="async" /></a>}
    <div><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0,10)}</time>
    <h2><a href={postPath(post)}>{post.data.title}</a></h2><p>{post.data.description}</p>
    <a href={postPath(post)} class="english-news-read">Read the full explanation →</a></div>
  </div>;
})}
</div>
<style>
.english-news-card{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:1.5rem;padding:1.7rem 0;border-bottom:1px solid var(--color-border)}
.english-news-image{display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid var(--color-border);border-radius:.6rem;overflow:hidden}
.english-news-image img{width:100%;height:12rem;object-fit:contain}.english-news-card time{font-size:.75rem;color:var(--color-muted-foreground)}
.english-news-card h2{font-family:var(--font-editorial);font-size:1.7rem;line-height:1.2;margin:.5rem 0}.english-news-card h2 a{text-decoration:none}
.english-news-card p{line-height:1.75;color:var(--color-muted-foreground);margin:.7rem 0}.english-news-read{font-size:.85rem}
@media(max-width:640px){.english-news-card{grid-template-columns:1fr;gap:1rem}.english-news-image img{height:auto;max-height:16rem}}
</style>
