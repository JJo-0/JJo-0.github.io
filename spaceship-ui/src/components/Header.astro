---
import { SITE } from '@/config';
import { englishSwitchPath, nativeAlternates } from '@/lib/locales';
import { getEnglishPosts } from '@/lib/english';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Search from '@/components/Search.svelte';
import { getCollection } from 'astro:content';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';

interface NavLink {
  name: string;
  href: string;
}

interface Props {
  pageLang?: string;
  englishPath?: string;
}

const { englishPath } = Astro.props;
const isKoreanPage = !Astro.url.pathname.startsWith('/en/');
const showEnglishLink = isKoreanPage && typeof englishPath === 'string' && englishPath.length > 0;
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en/');
const localePrefix = isEnglish ? '/en' : '';
const postPrefix = `${localePrefix}/posts/`;
const koreanPath = nativeAlternates(currentPath)['ko-KR'] || '/';
const currentPostSlug = currentPath.startsWith(postPrefix)
  ? decodeURIComponent(currentPath.slice(postPrefix.length).replace(/\/$/, ''))
  : null;

const [projects, appearances, currentPost] = await Promise.all([
  SITE.publicSections.projects ? getCollection('projects') : Promise.resolve([]),
  SITE.publicSections.appearances ? getCollection('appearances') : Promise.resolve([]),
  currentPostSlug
    ? isEnglish
      ? getEnglishPosts().then((posts) => posts.find((post) => post.data.slug === currentPostSlug))
      : getPublishedPosts().then((posts) => posts.find((post) => getPostSlug(post) === currentPostSlug))
    : Promise.resolve(undefined),
]);

const currentPostIsNews = Boolean(currentPost?.data.tags.some((tag) => tag === 'frontier-one' || tag === 'frontier-candidate'));

const navLinks: NavLink[] = isEnglish ? [
  { name: 'Research', href: '/en/research/' }, { name: 'Writing', href: '/en/posts/' },
  { name: 'News', href: '/en/news/' }, { name: 'About', href: '/en/about/' },
] : [
  { name: 'Research', href: '/research' },
  { name: 'Writing', href: '/posts' },
  { name: 'News', href: '/news' },
  ...(SITE.publicSections.projects && projects.length > 0
    ? [{ name: 'Projects', href: '/projects' }]
    : []),
  ...(SITE.publicSections.appearances && appearances.length > 0
    ? [{ name: 'Appearances', href: '/appearances' }]
    : []),
  { name: 'About', href: '/about' },
];

const isActive = (href: string) => {
  if (currentPostIsNews) return href === `${localePrefix}/news` || href === `${localePrefix}/news/`;
  const target = href.replace(/\/$/, '');
  return currentPath.replace(/\/$/, '') === target || currentPath.startsWith(`${target}/`);
};

const navClass = (href: string) => [
  'site-nav-link px-1 py-2 text-[0.66rem] font-bold uppercase tracking-[0.16em] transition-colors shrink-0 no-underline',
  isActive(href) ? 'text-foreground' : 'text-muted-foreground hover:text-primary',
];
---

<header
  data-site-header
  class="site-header sticky top-0 z-50 overflow-visible border-b border-border bg-background/90 py-3 backdrop-blur-md transition-colors duration-300 sm:py-4"
>
  <div data-header-inner class="px-2 sm:px-2 lg:px-3">
    <div class="flex items-center justify-between gap-2 sm:gap-3">
      <a
        href={isEnglish ? "/en/" : "/"}
        aria-label={`${SITE.author} home`}
        data-site-brand
        class="site-brand shrink-0 whitespace-nowrap text-foreground no-underline hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        <span>{SITE.author}</span>
        <small>Research notes · Seoul</small>
      </a>

      <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-4 lg:gap-6">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-astro-reload={link.href === '/about' || link.href.startsWith('/en/') ? true : undefined}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={navClass(link.href)}
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-1 sm:gap-2">
        {
          showEnglishLink && (
            <a
              href={englishPath}
              data-locale-choice="en" data-astro-reload
              hreflang="en"
              class="language-header-switch"
              aria-label="View this page in English"
              title="View in English"
            >
              EN
            </a>
          )
        }
        {isEnglish && <a href={koreanPath} data-locale-choice="ko" data-astro-reload lang="ko" hreflang="ko-KR" class="language-header-switch" aria-label="한국어로 보기">KO</a>}
        {isKoreanPage && !showEnglishLink && <a href={englishSwitchPath(currentPath)} data-locale-choice="en" data-astro-reload class="language-header-switch" aria-label="English edition and translation availability" title="English edition — check translation availability">EN</a>}
        <Search client:load />
        <ThemeToggle />
      </div>
    </div>

    <nav
      aria-label="Primary navigation mobile"
      class="mt-3 flex items-center gap-4 overflow-x-auto overscroll-x-contain border-t border-border/60 pt-2 pb-0.5 md:hidden"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-astro-reload={link.href === '/about' || link.href.startsWith('/en/') ? true : undefined}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={navClass(link.href)}
          >
            {link.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-background) 72%, transparent);
  }

  .site-brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .site-brand span {
    font-family: var(--font-editorial);
    font-size: clamp(1.12rem, 1.8vw, 1.42rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .site-brand small {
    color: var(--color-muted-foreground);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-nav-link {
    position: relative;
  }

  .language-header-switch {
    min-width: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted-foreground);
    padding: 0.42rem 0.5rem;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
    cursor: pointer;
  }

  .language-header-switch:hover,
  .language-header-switch:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .site-nav-link[aria-current='page']::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-primary);
    content: '';
  }

  @media (max-width: 520px) {
    .site-brand small {
      display: none;
    }
  }
</style>
