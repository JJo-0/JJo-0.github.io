---
import { SITE } from '@/config';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Search from '@/components/Search.svelte';
import { getCollection } from 'astro:content';
import '@/styles/editorial.css';
import '@/styles/editorial-layout.css';
import '@/styles/topology.css';

interface NavLink {
  name: string;
  href: string;
}

const [projects, appearances] = await Promise.all([
  SITE.publicSections.projects ? getCollection('projects') : Promise.resolve([]),
  SITE.publicSections.appearances ? getCollection('appearances') : Promise.resolve([]),
]);

const navLinks: NavLink[] = [
  { name: 'Research', href: '/research' },
  { name: 'Writing', href: '/posts' },
  ...(SITE.publicSections.projects && projects.length > 0
    ? [{ name: 'Projects', href: '/projects' }]
    : []),
  ...(SITE.publicSections.appearances && appearances.length > 0
    ? [{ name: 'Appearances', href: '/appearances' }]
    : []),
  { name: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

const navClass = (href: string) => [
  'px-2 py-1.5 rounded-md text-xs font-bold uppercase tracking-widest transition-colors shrink-0 no-underline',
  isActive(href)
    ? 'bg-secondary text-foreground'
    : 'text-muted-foreground hover:bg-accent hover:text-primary',
];
---

<header
  data-site-header
  class="sticky top-0 z-50 overflow-visible border-b border-border bg-background/85 py-3 backdrop-blur-md transition-colors duration-300 sm:py-4"
>
  <div data-header-inner class="px-2 sm:px-2 lg:px-3">
    <div class="flex items-center justify-between gap-2 sm:gap-3">
      <a
        href="/"
        aria-label={`${SITE.author} home`}
        data-site-brand
        class="shrink-0 whitespace-nowrap rounded-sm text-[0.95rem] font-black text-foreground no-underline hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:text-xl"
      >
        {SITE.author}
      </a>

      <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-1 lg:gap-2">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={navClass(link.href)}
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-1 sm:gap-2">
        <Search client:load />
        <ThemeToggle />
      </div>
    </div>

    <nav
      aria-label="Primary navigation mobile"
      class="mt-3 flex items-center gap-1 overflow-x-auto overscroll-x-contain pb-0.5 md:hidden"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={navClass(link.href)}
          >
            {link.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>
