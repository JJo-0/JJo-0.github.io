---
import { SITE } from '@/config';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Search from '@/components/Search.svelte';
import { getCollection } from 'astro:content';

interface NavLink {
  name: string;
  href: string;
}

const [projects, appearances] = await Promise.all([
  SITE.publicSections.projects ? getCollection('projects') : Promise.resolve([]),
  SITE.publicSections.appearances ? getCollection('appearances') : Promise.resolve([]),
]);

const navLinks: NavLink[] = [
  { name: 'Research', href: '/research' },
  { name: 'Writing', href: '/posts' },
  ...(SITE.publicSections.projects && projects.length > 0
    ? [{ name: 'Projects', href: '/projects' }]
    : []),
  ...(SITE.publicSections.appearances && appearances.length > 0
    ? [{ name: 'Appearances', href: '/appearances' }]
    : []),
  { name: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

const navClass = (href: string) => [
  'site-nav-link px-1 py-2 text-[0.66rem] font-bold uppercase tracking-[0.16em] transition-colors shrink-0 no-underline',
  isActive(href) ? 'text-foreground' : 'text-muted-foreground hover:text-primary',
];
---

<header
  data-site-header
  class="site-header sticky top-0 z-50 overflow-visible border-b border-border bg-background/90 py-3 backdrop-blur-md transition-colors duration-300 sm:py-4"
>
  <div data-header-inner class="px-2 sm:px-2 lg:px-3">
    <div class="flex items-center justify-between gap-2 sm:gap-3">
      <a
        href="/"
        aria-label={`${SITE.author} home`}
        data-site-brand
        class="site-brand shrink-0 whitespace-nowrap text-foreground no-underline hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        <span>{SITE.author}</span>
        <small>Research notes · Seoul</small>
      </a>

      <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-4 lg:gap-6">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={navClass(link.href)}
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-1 sm:gap-2">
        <Search client:load />
        <ThemeToggle />
      </div>
    </div>

    <nav
      aria-label="Primary navigation mobile"
      class="mt-3 flex items-center gap-4 overflow-x-auto overscroll-x-contain border-t border-border/60 pt-2 pb-0.5 md:hidden"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={navClass(link.href)}
          >
            {link.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-background) 72%, transparent);
  }

  .site-brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .site-brand span {
    font-family: var(--font-editorial);
    font-size: clamp(1.12rem, 1.8vw, 1.42rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .site-brand small {
    color: var(--color-muted-foreground);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-nav-link {
    position: relative;
  }

  .site-nav-link[aria-current='page']::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-primary);
    content: '';
  }

  @media (max-width: 520px) {
    .site-brand small {
      display: none;
    }
  }
</style>
