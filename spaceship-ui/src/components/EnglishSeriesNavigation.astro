---
import type { EnglishPost } from '@/lib/english';
import { englishPostPath } from '@/lib/english';
import { seriesForEnglish } from '@/lib/english-series';
interface Props { post: EnglishPost; }
const { post } = Astro.props;
const series = await seriesForEnglish(post);
---
{series && <nav aria-label="Series reading order" class="english-series-navigation">
  <p><strong>{series.title}</strong> · {series.translated} of {series.entries.length} articles available in English</p>
  <ol>{series.entries.map(entry => <li>{entry.translation
    ? entry.translation.data.slug === post.data.slug
      ? <span aria-current="page">{entry.translation.data.title}</span>
      : <a href={englishPostPath(entry.translation)}>{entry.translation.data.title}</a>
    : <a href={`/posts/${entry.sourceSlug}/`} lang="ko" data-astro-reload>{entry.original.data.title} <small>— Korean original; English translation in progress</small></a>
  }</li>)}</ol>
</nav>}
<style>
.english-series-navigation { margin:2rem 0; padding:1rem 1.25rem; border:1px solid var(--color-border); border-radius:.6rem; line-height:1.7; }
ol { padding-left:1.5rem; margin-top:.6rem; } li { padding:.2rem 0; } a { text-decoration:underline; text-underline-offset:.2em; } [aria-current] { font-weight:650; } small { color:var(--color-muted-foreground); }
</style>
