---
interface Props { lang?: 'ko' | 'en'; }
const { lang = 'ko' } = Astro.props;
---

<a
  class="support-link"
  href="https://buymeacoffee.com/qkrwlgh613z"
  target="_blank"
  rel="noopener noreferrer"
>
  {lang === 'en' ? 'Support my writing with a coffee' : '커피 한 잔으로 응원하기'}
  <span aria-hidden="true">↗</span>
  <span class="sr-only">{lang === 'en' ? ' (opens in a new tab)' : ' (새 탭에서 열림)'}</span>
</a>

<style>
  .support-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0;
    color: var(--color-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .support-link:hover {
    text-decoration-thickness: 2px;
  }

  .support-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
