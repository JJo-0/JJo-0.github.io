---
import type { CollectionEntry } from 'astro:content';
import WritingListItem from './WritingListItem.astro';
import SeriesGroup from './SeriesGroup.astro';
import { getPostSlug, getPostSeriesId, compareSeriesPosts } from '@/lib/utils/posts';
import { ENGLISH_SERIES_TITLES } from '@/lib/english-series';
import { getReadTime } from '@/lib/utils/readTime';
import { getSelfImprovingPart, selfImprovingSeries } from '@/lib/self-improving-series';
import aiBenchmarkSeries from '@/data/ai-benchmark-series.json';
interface Props { posts: CollectionEntry<'posts'>[]; en?: boolean; }
const { posts, en = false } = Astro.props;
const names: Record<string, string> = {
  'modern-artificial-intelligence': '현대 인공지능',
  'ai-consciousness-deep-research': 'AI가 의식이 있는가?',
  'data-structures-coding-tests': '자료구조·코딩테스트',
  supplements: '영양제 · 마그네슘·비타민B·오메가3',
  'soc-from-code-to-chip': '코드에서 칩까지',
  'human-motion-study': 'Human and Robotics',
  'rl-robot-learning': '강화학습',
  'self-improving-ai': '자가개선 AI',
  segmentation: 'Segmentation',
};
const grouped = new Map<string, CollectionEntry<'posts'>[]>();
for (const post of posts) { const key = getPostSeriesId(post); if (key) grouped.set(key, [...(grouped.get(key) || []), post]); }
const emitted = new Set<string>();
interface ListItem { post: CollectionEntry<'posts'>; key?: string; title?: string; description?: string; members: CollectionEntry<'posts'>[]; }
const items = posts.flatMap<ListItem>(post => {
  const key = getPostSeriesId(post);
  if (!key || ((grouped.get(key)?.length || 0) < 2 && key !== 'human-motion-study' && key !== 'rl-robot-learning' && key !== 'segmentation' && key !== selfImprovingSeries.id && key !== aiBenchmarkSeries.id)) return [{ post, key: undefined, members: [] }];
  if (emitted.has(key)) return [];
  emitted.add(key);
  const members = [...grouped.get(key)!].sort((a, b) => compareSeriesPosts(a, b, key));
  if (key === selfImprovingSeries.id) {
    return selfImprovingSeries.parts.flatMap(part => {
      const partMembers = members.filter(member => getSelfImprovingPart(member.data.series)?.number === part.number);
      return partMembers.length ? [{ post: partMembers[0], key: part.groupId, title: en ? part.englishTitle : part.title, description: en ? part.englishDescription : part.description, members: partMembers }] : [];
    });
  }
  if (key === aiBenchmarkSeries.id) {
    return aiBenchmarkSeries.parts.flatMap(part => {
      const orders = new Set(part.entries.map(entry => entry.order));
      const partMembers = members.filter(member => orders.has(member.data.series?.order ?? 0));
      const title = en ? `AI Benchmark — Part ${part.roman}. ${part.englishTitle}` : `AI 벤치마크 — Part ${part.roman}. ${part.title}`;
      return partMembers.length ? [{ post: partMembers[0], key: part.groupId, title, description: en ? `${part.entries.length} planned chapters` : `${part.entries.length}편 구성`, members: partMembers }] : [];
    });
  }
  return [{ post, key, members }];
});
---
{items.map(({ post, key, title, description, members }) => key ? <SeriesGroup {en} groupId={key} title={title || (en ? ENGLISH_SERIES_TITLES[key] : names[key]) || post.data.title.split(' — ')[0]} {description} count={members.length}>{members.map(member => <WritingListItem {en} post={member} slug={getPostSlug(member)} readTime={getReadTime(member.body || '')} />)}</SeriesGroup> : <WritingListItem {en} {post} slug={getPostSlug(post)} readTime={getReadTime(post.body || '')} />)}
