---
import type { CollectionEntry } from 'astro:content';
import WritingListItem from './WritingListItem.astro';
import SeriesGroup from './SeriesGroup.astro';
import { getPostSlug, getPostSeriesId, compareSeriesPosts } from '@/lib/utils/posts';
import { getReadTime } from '@/lib/utils/readTime';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
const names: Record<string, string> = {
  'modern-artificial-intelligence': '현대 인공지능',
  'ai-consciousness-deep-research': 'AI가 의식이 있는가?',
  'data-structures-coding-tests': '자료구조·코딩테스트',
  supplements: '영양제 · 마그네슘·비타민B·오메가3',
  'soc-from-code-to-chip': '코드에서 칩까지',
  'human-motion-study': 'Human and Robotics',
  'rl-robot-learning': '강화학습',
  segmentation: 'Segmentation',
};
const grouped = new Map<string, CollectionEntry<'posts'>[]>();
for (const post of posts) { const key = getPostSeriesId(post); if (key) grouped.set(key, [...(grouped.get(key) || []), post]); }
const emitted = new Set<string>();
interface ListItem { post: CollectionEntry<'posts'>; key?: string; members: CollectionEntry<'posts'>[]; }
const items = posts.flatMap<ListItem>(post => {
  const key = getPostSeriesId(post);
  if (!key || ((grouped.get(key)?.length || 0) < 2 && key !== 'human-motion-study' && key !== 'rl-robot-learning' && key !== 'segmentation')) return [{ post, key: undefined, members: [] }];
  if (emitted.has(key)) return [];
  emitted.add(key);
  const members = [...grouped.get(key)!].sort((a, b) => compareSeriesPosts(a, b, key));
  return [{ post, key, members }];
});
---
{items.map(({ post, key, members }) => key ? <SeriesGroup groupId={key} title={names[key] || post.data.title.split(' — ')[0]} count={members.length}>{members.map(member => <WritingListItem post={member} slug={getPostSlug(member)} readTime={getReadTime(member.body || '')} />)}</SeriesGroup> : <WritingListItem {post} slug={getPostSlug(post)} readTime={getReadTime(post.body || '')} />)}
