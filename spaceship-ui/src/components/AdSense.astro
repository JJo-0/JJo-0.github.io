---
interface Props {
  clientId: string;
  adSlot: string;
}

const { clientId, adSlot } = Astro.props;
const validClientId = /^ca-pub-\d{16}$/.test(clientId);
const validAdSlot = /^\d+$/.test(adSlot);
const enabled = validClientId && validAdSlot;
---

{
  enabled && (
    <aside class="my-12 text-center" aria-label="광고">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={clientId}
        data-ad-slot={adSlot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}
