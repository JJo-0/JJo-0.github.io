---
import { SITE } from '@/config';
---

<footer class="site-footer py-10 mt-24 sm:mt-32 lg:mt-40 border-t border-border">
  <div class="flex flex-col md:flex-row justify-between md:items-end gap-8 sm:gap-6">
    <div>
      <p class="site-footer__title">Notes on systems that perceive, reason, and act.</p>
      <div class="mt-2 text-[0.62rem] font-bold text-muted-foreground uppercase tracking-[0.18em]">
        &copy; {new Date().getFullYear()}
        {SITE.author} · Built as a public research archive
      </div>
    </div>

    <nav aria-label="Social links" class="flex flex-wrap justify-center gap-6 sm:gap-8">
      {
        Object.entries(SITE.social).map(([name, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${SITE.author}'s ${name} page`}
            class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted-foreground hover:text-primary no-underline"
          >
            {name}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer__title {
    max-width: 30rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }
</style>
