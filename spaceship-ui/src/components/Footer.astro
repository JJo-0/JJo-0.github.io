---
import { SITE } from '@/config';
---

<footer class="site-footer py-10 mt-24 sm:mt-32 lg:mt-40 border-t border-border">
  <div class="flex flex-col md:flex-row justify-between md:items-end gap-8 sm:gap-6">
    <div>
      <p class="site-footer__title">Notes on systems that perceive, reason, and act.</p>
      <div class="mt-2 text-[0.62rem] font-bold text-muted-foreground uppercase tracking-[0.18em]">
        &copy; {new Date().getFullYear()}
        {SITE.author} · Built as a public research archive
      </div>
    </div>

    <nav aria-label="Social links" class="flex flex-wrap justify-center gap-6 sm:gap-8">
      {
        Object.entries(SITE.social).map(([name, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${SITE.author}'s ${name} page`}
            class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted-foreground hover:text-primary no-underline"
          >
            {name}
          </a>
        ))
      }
    </nav>
  </div>
  <nav lang="ko" aria-label="공지와 콘텐츠 정책" class="mt-6 flex flex-wrap gap-x-5 gap-y-3 border-t border-border/60 pt-5 text-xs text-muted-foreground">
    <a href="/notices/2026-09-11-biblical-studies-and-policies/" class="underline underline-offset-4 hover:text-foreground">공지 선언문</a>
    <a href="/policies/" class="underline underline-offset-4 hover:text-foreground">운영·AI 활용 원칙</a>
    <a href="/policies/disclaimer/" class="underline underline-offset-4 hover:text-foreground">면책 안내</a>
    <a href="/policies/copyright/" class="underline underline-offset-4 hover:text-foreground">저작권·재사용</a>
    <a href="/bible/reading-guide/" class="underline underline-offset-4 hover:text-foreground">성경 글을 읽기 전에</a>
  </nav>
</footer>

<style>
  .site-footer__title {
    max-width: 30rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }
</style>
