---
import { RESEARCH_FOCUS } from '@/lib/research';
import ExperienceCanvas from './ExperienceCanvas.astro';
import type { PostGraph } from '@/lib/experience/post-graph';

interface Props {
  graph: PostGraph;
}
const { graph } = Astro.props;
---

<nav class="research-map" aria-label="Research focus map" data-motion="hero-visual">
  <ExperienceCanvas variant="research" graph={graph} />
  <div class="research-map__hud" aria-hidden="true">
    <span>Public Research / Writing Atlas</span><span>{graph.nodes.length} Articles</span>
  </div>
  <div class="sr-only">
    {
      RESEARCH_FOCUS.map((focus) => (
        <a
          href={`#${focus.id}`}
          data-constellation-node={focus.id}
          data-world-target={focus.id}
        >
          Jump to {focus.title}
        </a>
      ))
    }
  </div>
</nav>
