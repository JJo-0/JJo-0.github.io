---
import { RESEARCH_FOCUS } from '@/lib/research';
import ExperienceCanvas from './ExperienceCanvas.astro';
import type { PostGraph } from '@/lib/experience/post-graph';

interface Props {
  graph: PostGraph;
}
const { graph } = Astro.props;
const en = /^\/en(?:\/|$)/.test(Astro.url.pathname);
---

<nav id="writing-atlas" class="research-map" aria-label="Research focus map" data-motion="hero-visual">
  <ExperienceCanvas variant="research" graph={graph} />
  <div class="research-map__hud" aria-hidden="true">
    <span>Writing Atlas</span>
    <span>{en
      ? `${graph.nodes.length} articles · ${graph.edges.length} links`
      : `글 ${graph.nodes.length}편 · 연결 ${graph.edges.length}개`}</span>
  </div>
  <div class="sr-only">
    {
      RESEARCH_FOCUS.map((focus) => (
        <a
          href={`#${focus.id}`}
          data-constellation-node={focus.id}
          data-world-target={focus.id}
        >
          Jump to {focus.title}
        </a>
      ))
    }
  </div>
</nav>
