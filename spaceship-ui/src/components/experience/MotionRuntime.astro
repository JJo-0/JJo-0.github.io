---
interface Props {
  scope: 'home' | 'research';
}

const { scope } = Astro.props;
---

<div class="experience-scroll-progress" data-experience-runtime={scope} aria-hidden="true">
  <span></span>
</div>

<script>
  import { installExperienceMotion } from '@/lib/experience/motion';

  // HTML anchors are natively keyboard-focusable, while SVG anchor focus
  // behavior has differed across browser engines. Keep one explicit contract
  // for every DOM node that drives the shared Research state.
  document.querySelectorAll('[data-constellation-node]').forEach((node) => {
    node.setAttribute('tabindex', '0');
  });

  installExperienceMotion();
</script>
