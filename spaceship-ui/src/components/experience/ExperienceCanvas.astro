---
import '@/styles/renderer.css';
import type { PostGraph } from '@/lib/experience/post-graph';
import { createHash } from 'node:crypto';
import { graphVisual } from '@/lib/experience/graph-visuals.mjs';
import { getPostCategoryMeta } from '@/lib/taxonomy.mjs';

interface Props {
  variant: 'home' | 'research';
  graph?: PostGraph;
}
const { variant, graph } = Astro.props;
const en = /^\/en(?:\/|$)/.test(Astro.url.pathname);
const archive = en ? '/en/posts/' : '/posts';
const graphVersion = graph ? createHash('sha256').update(JSON.stringify(graph)).digest('hex').slice(0, 16) : '';
const graphUrl = '/writing-graph/' + (en ? 'en' : 'ko') + '.json?v=' + graphVersion;
const edition = en ? 'en' : 'ko';
const previewUrl = (theme: 'light' | 'dark') => `/atlas-preview/${edition}-${theme}.svg?v=${graphVersion}`;
const categories = [...new Set(graph?.nodes.map(node => node.category) ?? [])]
  .map(id => ({ id, label: getPostCategoryMeta(id, en).shortLabel, ...graphVisual(id) }))
  .sort((a, b) => a.index - b.index);

// The reticle belongs to the instrument. Only the article stars rotate.
const ticks = Array.from({ length: 72 }, (_, i) => {
  const angle = i * Math.PI / 36;
  const radius = i % 6 === 0 ? 183 : 186;
  const point = (r: number) => `${(200 + r * Math.cos(angle)).toFixed(1)} ${(200 + r * Math.sin(angle)).toFixed(1)}`;
  return `M${point(radius)}L${point(188)}`;
}).join('');
---

<div
  class={`experience-renderer experience-renderer--${variant}`}
  data-experience-canvas={variant}
  data-renderer-status={graph ? 'fallback' : 'idle'}
  data-renderer-tier="safe"
  data-ascii-graph={graph ? 'true' : undefined}
  data-graph-url={graph ? graphUrl : undefined}
  data-graph-state={graph ? 'preview' : undefined}
  data-graph-count={graph?.nodes.length}
  data-graph-edges={graph?.edges.length}
  data-graph-auto={graph ? 'visible-idle' : undefined}
  aria-label={graph ? (en ? 'Interactive writing graph' : '인터랙티브 연구 지도') : undefined}
  aria-hidden={graph ? undefined : 'true'}
>
  {graph && (
    <>
      <div class="post-graph-field" aria-hidden="true">
        <svg class="post-graph-graticule" viewBox="0 0 400 400" fill="none" focusable="false">
          <circle cx="200" cy="200" r="188" />
          <path d={ticks} />
          <g transform="rotate(-23 200 200)">
            <circle cx="200" cy="200" r="174" stroke-dasharray="1 5" />
            <ellipse cx="200" cy="200" rx="174" ry="53" />
            <ellipse cx="200" cy="200" rx="67" ry="174" stroke-dasharray="2 5" />
          </g>
        </svg>
        <div class="post-graph-preview" data-graph-preview
          style={`--preview-light:url('${previewUrl('light')}');--preview-dark:url('${previewUrl('dark')}')`}></div>
      </div>
      <div class="post-graph-legend" aria-label={en ? 'Article categories' : '게시글 카테고리'}>
        {categories.map(category => <button type="button" data-graph-category={category.id} aria-pressed="false" disabled
          style={`--graph-light:${category.light};--graph-dark:${category.dark}`}>
          <span class="post-graph-category-ink" aria-hidden="true">{category.glyph}</span>{category.label}
        </button>)}
      </div>
      <div class="post-graph-loading" data-graph-loading aria-hidden="true">
        <span class="post-graph-loader-glyph" aria-hidden="true">+</span>
        <span>{en ? 'Building atlas…' : '지도 불러오는 중…'}</span>
      </div>
      <div class="post-graph-controls">
        <span class="post-graph-hint">{en ? 'Drag to rotate · Solid within topics · Dashed between topics' : '드래그로 회전 · 같은 분야는 실선, 다른 분야는 점선'}</span>
        <div class="post-graph-view-controls" data-graph-view-controls hidden>
          <button type="button" data-graph-rotate="-1" aria-label={en ? 'Rotate left' : '왼쪽 회전'}>←</button>
          <button type="button" data-graph-rotate="1" aria-label={en ? 'Rotate right' : '오른쪽 회전'}>→</button>
          <button type="button" data-graph-reset aria-label={en ? 'Reset map view' : '지도 초기화'}>↺</button>
        </div>
        <button type="button" class="post-graph-activate" data-graph-activate hidden
          data-loading-label={en ? 'Loading map…' : '지도 불러오는 중…'}
          data-retry-label={en ? 'Retry map' : '지도 다시 열기'}>{en ? 'Retry map' : '지도 다시 열기'}</button>
        <a href={archive}>{en ? 'Writing archive ↗' : '전체 글 ↗'}</a>
        <span data-graph-message role="status" class="sr-only" data-ready-label={en ? 'Map ready' : '지도 준비 완료'}
          data-error-label={en ? 'Map unavailable. Retry or open the archive.' : '지도를 불러오지 못했습니다. 다시 시도하거나 전체 글을 여세요.'}></span>
      </div>
    </>
  )}
  <canvas class="experience-renderer__gpu" data-experience-canvas-element tabindex="-1"></canvas>
  <canvas class="experience-renderer__ascii" data-ascii-art tabindex="-1"></canvas>
  {graph && (
    <>
      <nav class="post-graph-links" aria-label={en ? 'Writing graph articles' : '연구 지도 게시글'}></nav>
      <output class="post-graph-tooltip" data-post-graph-tooltip aria-live="polite" />
    </>
  )}
  <span class="experience-renderer__status">
    GPU <span data-renderer-label>SVG</span>
  </span>
</div>

<script>
  import { installGraphLoader } from '@/lib/experience/graph-loader';
  import { installExperienceRendererRuntime } from '@/lib/experience/renderer-runtime';
  installGraphLoader();
  installExperienceRendererRuntime();
</script>
