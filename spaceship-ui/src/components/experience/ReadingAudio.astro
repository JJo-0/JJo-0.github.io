---
interface Props {
  en: boolean;
  atlas?: boolean;
}
const { en, atlas = false } = Astro.props;
const title = en ? 'Reading sounds' : '읽기 배경음';
---

<section data-reading-audio data-lang={en ? 'en' : 'ko'} hidden aria-label={title}>
  <div class="audio-bar">
    <span class="audio-name">{title}</span>
    <button type="button" data-audio-play aria-pressed="false">{en ? 'Play' : '재생'}</button>
    <select data-audio-track aria-label={en ? 'Choose audio' : '음원 선택'}></select>
    <details>
      <summary>{en ? 'Settings' : '설정'}</summary>
      <div class="audio-options">
        <label
          >{en ? 'Volume' : '음량'}
          <input data-audio-volume type="range" min="0" max="1" step=".05" value=".35" /></label
        >
        {
          atlas && (
            <label>
              <input type="checkbox" data-audio-react />
              {en ? 'Stars react to sound' : '소리에 맞춰 별 밝기 변경'}
            </label>
          )
        }
        <p data-audio-credit></p>
      </div>
    </details>
  </div>
  <p data-audio-message role="status" hidden></p>
</section>
<script>
  import { installReadingAudio } from '@/lib/experience/reading-player';
  installReadingAudio();
</script>
<style>
  [data-reading-audio] {
    position: relative;
    z-index: 6;
    margin-block: 0.5rem;
    color: var(--color-foreground);
  }
  .audio-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.55rem;
    padding: 0.32rem 0;
    border-block: 1px solid var(--color-border);
  }
  .audio-name {
    margin-right: auto;
    font-weight: 650;
    font-size: 0.8rem;
  }
  .audio-bar :is(button, select, summary) {
    cursor: pointer;
    font: inherit;
    font-size: 0.77rem;
  }
  .audio-bar button {
    padding: 0.42rem 0.74rem;
    border-radius: 0.24rem;
    color: var(--color-background);
    background: var(--color-foreground);
  }
  .audio-bar select {
    max-width: min(48%, 18rem);
    border: 0;
    color: inherit;
    background: var(--color-background);
  }
  .audio-bar summary {
    padding: 0.42rem 0.2rem;
  }
  .audio-options {
    position: absolute;
    z-index: 2;
    top: 100%;
    right: 0;
    width: min(19rem, 100%);
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    background: var(--color-background);
    box-shadow: 0 0.5rem 1.8rem #0002;
  }
  .audio-options label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    margin: 0.2rem 0 0.65rem;
    font-size: 0.8rem;
  }
  .audio-options label:has([type='checkbox']) {
    justify-content: flex-start;
  }
  .audio-options input {
    accent-color: var(--color-foreground);
  }
  .audio-options p,
  [data-audio-message] {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
  [data-audio-credit] :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  [data-reading-audio] :is(button, select, summary, input):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  @media (max-width: 430px) {
    .audio-bar {
      gap: 0.3rem;
    }
    .audio-bar select {
      min-width: 0;
      flex: 1;
    }
  }
</style>
