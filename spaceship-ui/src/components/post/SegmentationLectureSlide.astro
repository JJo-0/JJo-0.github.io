---
interface Props { page: number; caption: string; priority?: boolean; }
const { page, caption, priority = false } = Astro.props;
if (!Number.isInteger(page) || page < 32 || page > 64) throw new Error('Invalid segmentation source page');
const label = `P${String(page).padStart(3, '0')}`;
const source = `https://cs231n.stanford.edu/slides/2026/lecture_9.pdf#page=${page}`;
const src = `/assets/posts/segmentation-from-pixels-to-robot-observations/slides/slide-${String(page).padStart(3, '0')}.webp`;
---
<figure class="segmentation-slide" data-segmentation-slide={label} aria-labelledby={`segmentation-${label}`}>
  <a href={source} target="_blank" rel="noopener noreferrer" aria-label={`${label} 원본 PDF 열기`}>
    <img src={src} alt={`${label}: ${caption}. Stanford CS231n 2026 Lecture 9 원본 슬라이드.`} width="1400" height="788" loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
  </a>
  <figcaption id={`segmentation-${label}`}>{label} · {caption} · Stanford CS231n, Lecture 9 (2026-04-28). <a href={source} target="_blank" rel="noopener noreferrer">원본 PDF {page}쪽</a></figcaption>
</figure>
<style>
.segmentation-slide { width:100%; min-width:0; margin:2.5rem 0 1.25rem; }
.segmentation-slide img { display:block; width:100%; max-width:100%; height:auto; margin:0; border:1px solid var(--color-border); background:white; }
.segmentation-slide figcaption { margin-top:.5rem; font-size:12px; line-height:1.7; color:var(--color-muted-foreground); }
.segmentation-slide figcaption a { text-decoration:underline; }
</style>
