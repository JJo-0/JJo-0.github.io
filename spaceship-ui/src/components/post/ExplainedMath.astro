---
import BaseMath from './Math.astro';
import FormulaGuide from './FormulaGuide.astro';
import { formulaCardTitle } from '@/lib/modern-ai-formula-guide.mjs';

interface Props {
  formulaId: string;
  tex: string;
  display?: boolean;
  label?: string;
}

const { formulaId, tex, label } = Astro.props;
const title = formulaCardTitle({ formulaId, tex });
const aria = label || `${title}, ${formulaId}`;
---

<figure
  class="explained-formula my-8 overflow-hidden rounded-2xl border border-border/80 bg-card/55 shadow-sm"
  data-formula-id={formulaId}
  data-formula-guide="rich"
  data-formula-part="1"
>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/70 bg-muted/25 px-4 py-3 sm:px-5">
    <div class="min-w-0">
      <p class="m-0 text-[0.68rem] font-black uppercase tracking-[0.14em] text-primary/80">Part I · 학습 수식</p>
      <figcaption class="mt-1 text-base font-black leading-6 text-foreground">{title}</figcaption>
    </div>
    <button
      type="button"
      class="formula-copy rounded-full border border-border bg-background px-3 py-1.5 text-xs font-bold text-muted-foreground transition hover:border-primary/40 hover:text-primary"
      data-copy-tex={tex}
      aria-label={`${formulaId} LaTeX 복사`}
    >수식 복사</button>
  </div>

  <div class="overflow-x-auto overflow-y-hidden px-3 py-2 sm:px-5">
    <BaseMath tex={tex} display label={aria} />
  </div>

  <FormulaGuide
    formulaId={formulaId}
    tex={tex}
    part={1}
    sourceLabel={`현대 인공지능 I · ${formulaId}`}
  />
</figure>
