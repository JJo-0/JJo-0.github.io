---
interface Props { report: 1 | 2 | 3; }
const { report } = Astro.props;
const perspectives = ['Greek, textual criticism, and intertextuality', 'Literary, rhetorical, and discourse analysis', 'Social science, canonical theology, and reception'];
---
<section data-bible-source-guide="acts" class="not-prose rounded-xl border border-border bg-card p-5 sm:p-8">
  <h2 class="text-2xl font-bold">Acts 2:14–37 · Sources and research materials</h2>
  <p class="mt-4 leading-relaxed text-muted-foreground">This page introduces the {perspectives[report - 1]} perspective. The completed research text, tables, and references for all three perspectives are linked on the author’s Korean Naver blog.</p>
  <p class="mt-6"><a data-bible-original href="https://blog.naver.com/jjo_09_/224428120204" target="_blank" rel="noopener noreferrer" class="inline-block rounded-lg border border-primary px-5 py-3 font-bold text-primary underline underline-offset-4">Read the full Korean research on Naver ↗</a></p>
  <p data-dashboard-pending class="mt-5 text-sm leading-relaxed text-muted-foreground">Interactive materials for this passage have not been published. This English edition preserves the source-guide scope of the original page; it does not present the linked Korean research as translated.</p>
  <nav aria-label="Acts 2:14–37 research perspectives" class="mt-6 border-t border-border pt-5"><ul class="space-y-3">{perspectives.map((perspective, index) => <li>{report === index + 1 ? <span aria-current="page">{index + 1}. {perspective}</span> : <a class="underline underline-offset-4" href={`/en/posts/acts-2-14-37-${index + 1}/`}>{index + 1}. {perspective}</a>}</li>)}</ul></nav>
  <p class="mt-6 text-sm"><a href="/bible/" class="underline underline-offset-4">Korean study catalogue</a>{' · '}<a href="/bible/reading-guide/" class="underline underline-offset-4">Korean guide to reading these studies</a></p>
</section>
