---
import BibleResearchDocument from '@/components/post/BibleResearchDocument.astro';
import report1Html from '@/data/ezekiel-reports/report-1.html?raw';
import report2Html from '@/data/ezekiel-reports/report-2.html?raw';
import report3Html from '@/data/ezekiel-reports/report-3.html?raw';

interface Props { report: 1 | 2 | 3; }
const { report } = Astro.props;
const perspectives = ['원어·역사·본문비평', '문학·수사·신체성', '사회과학·트라우마·수용사'];
const reportHtml = [report1Html, report2Html, report3Html][report - 1];
const perspective = perspectives[report - 1];
---

<section
  data-bible-source-guide="ezekiel"
  data-ezekiel-report={report}
  class="not-prose min-w-0 rounded-xl border border-border bg-card p-4 sm:p-6 lg:p-8"
>
  <header class="border-b border-border pb-5">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">Ezekiel 2:1–3:11 · Report {report} of 3</p>
    <h2 class="mt-2 text-2xl font-bold sm:text-3xl">{perspective}</h2>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-muted-foreground">
      외부 원문으로 이동하지 않아도 아래에서 검증된 전체 연구 본문·표·이미지·참고문헌을 바로 읽을 수 있습니다.
      Naver 원문은 비교·출처 확인용으로 마지막에 별도 보존합니다.
    </p>
  </header>

  <nav aria-label="에스겔 2:1–3:11 연구 관점" class="my-5 border-b border-border pb-5">
    <ol class="grid gap-2 sm:grid-cols-3">
      {perspectives.map((item, index) => (
        <li>
          {report === index + 1 ? (
            <span aria-current="page" class="block rounded-lg border border-primary bg-primary/5 px-3 py-2 font-semibold">
              {index + 1}. {item}
            </span>
          ) : (
            <a class="block rounded-lg border border-border px-3 py-2 underline underline-offset-4 hover:border-primary" href={`/posts/ezekiel-2-1-3-11-${index + 1}/`}>
              {index + 1}. {item}
            </a>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <BibleResearchDocument label={`에스겔 2:1–3:11 ${perspective} 전체 연구 본문`}>
    <div data-ezekiel-research-body set:html={reportHtml} />
  </BibleResearchDocument>

  <details data-ezekiel-original class="mt-8 border-t border-border pt-5 text-sm leading-7">
    <summary class="cursor-pointer font-semibold">원문·출처 확인</summary>
    <p class="mt-3 text-muted-foreground">
      이 페이지의 전체 연구 본문은 2026-10-01에 확보·검증한 작성자 원문을 정제한 사본입니다.
      표와 하단 인용 출처를 보존하고 실행 스크립트·onclick 속성은 포함하지 않습니다.
    </p>
    <p class="mt-3">
      <a data-bible-original href="https://blog.naver.com/jjo_09_/224428051487" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary underline underline-offset-4">
        Naver 원문과 대조하기 ↗
      </a>
      {' · '}
      <a href="/bible/" class="underline underline-offset-4">성경 연구 목록</a>
      {' · '}
      <a href="/bible/reading-guide/" class="underline underline-offset-4">성경 글을 읽기 전에</a>
    </p>
  </details>
</section>

<style>
  [data-ezekiel-research-body] :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto .75rem;
    border-radius: var(--radius-md);
  }
  [data-ezekiel-research-body] :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: .2em;
    overflow-wrap: anywhere;
  }
  [data-ezekiel-research-body] :global([id^='reference-ezekiel-']) {
    scroll-margin-top: 7rem;
  }
  [data-ezekiel-research-body] :global(hr) {
    margin: 2rem 0;
    border-color: var(--color-border);
  }
  :is(a, summary):focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 4px;
  }
  :global(.article-layout:has([data-ezekiel-report]) > .w-52) {
    display: none;
  }
  :global(.article-prose:has([data-ezekiel-report])) {
    max-width: none;
  }
</style>
