---
import BibleResearchDocument from '@/components/post/BibleResearchDocument.astro';
import IsaiahDashboard from '@/components/post/IsaiahDashboard.astro';
import { illustrateIsaiahReport } from '@/lib/isaiah43-images.mjs';
import report1 from '@/data/isaiah43/reports/1.html?raw';
import report2 from '@/data/isaiah43/reports/2.html?raw';
import report3 from '@/data/isaiah43/reports/3.html?raw';
interface Props { report: 1 | 2 | 3; }
const { report } = Astro.props;
const perspectives = ['역사·문법·통합 연구', '문학·수사·담화·은유 비평', '사회과학·기억론·신학·수용사'];
const html = illustrateIsaiahReport([report1, report2, report3][report - 1], report);
---
<section data-isaiah-study={report}>
  <nav aria-label="이사야 43:18–21 연구 1·2·3" class="not-prose mb-8 grid gap-3 sm:grid-cols-3">
    {perspectives.map((title, i) => <a href={`/posts/isaiah-43-18-21-${i + 1}/`} aria-current={i + 1 === report ? 'page' : undefined} class="rounded border border-border p-3 text-sm leading-6">{i + 1}. {title}</a>)}
  </nav>
  <h2>연구 {report} · 대시보드</h2>
  <IsaiahDashboard order={report} />
  <h2 id="gemini-chat-body">Gemini 채팅 본문</h2>
  <p>작성자가 제공한 전체 연구 본문입니다. 대시보드와 별도로 본문·표·인용 출처를 보존했습니다. 원자료의 학술 주장과 평가 수치는 독립적인 동료심사나 출처 검증 완료를 뜻하지 않으며, 자료 접근의 한계는 본문에 함께 남겼습니다.</p>
  <BibleResearchDocument label={`이사야 43:18–21 연구 ${report} 전체 본문`}>
    <div data-isaiah-research-body set:html={html} />
  </BibleResearchDocument>
  <details data-isaiah-original class="mt-8 border-t border-border pt-5 text-sm leading-7">
    <summary class="cursor-pointer font-semibold">원문·출처 확인</summary>
    <p><a href="https://blog.naver.com/jjo_09_/224436720898" target="_blank" rel="noopener noreferrer">Naver 전체 연구 원문 · 이사야 43:18–21 ↗</a></p>
  </details>
</section>
<style>
  nav a[aria-current='page'] { border-color:var(--color-primary); color:var(--color-primary); font-weight:700; }
  section :global(figure[data-isaiah-image]) { margin:2rem 0; padding:1rem; border:1px solid var(--color-border); border-radius:var(--radius-md); }
  section :global(figure[data-isaiah-image] img) { display:block; width:100%; height:auto; max-height:38rem; object-fit:contain; }
  section :global(figure[data-isaiah-image] figcaption) { margin-top:.8rem; font-size:.85rem; line-height:1.7; color:var(--color-muted-foreground); }
  #gemini-chat-body { margin-top:3rem; }
</style>
