---
import media from '@/data/soc-00-real-media.json';
interface Props { kind: 'board' | 'datasheet'; lang?: 'ko' | 'en'; }
const { kind, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const t = (ko: string, english: string) => en ? english : ko;
const asset = media[kind];
const id = `soc-source-${kind}-${lang}`;
const board = kind === 'board';
const title = board
  ? t('보드, 칩, CPU는 같은 물건이 아닙니다.', 'The board, chip and CPU are not the same object.')
  : t('검은 칩 안을, 제조사의 그림으로 읽어봅시다.', 'Read inside the chip using the manufacturer’s diagram.');
const alt = board
  ? t('Raspberry Pi Pico의 실제 상면 사진. 녹색 기판 가운데 RP2040 패키지가 있고 오른쪽에는 USB 커넥터가 있다. 내부 CPU 코어는 사진으로 보이지 않는다.', 'Real top-view photograph of a Raspberry Pi Pico. The RP2040 package is near the middle of the green board and the USB connector is on the right. Its CPU cores are not visible in this photograph.')
  : t('RP2040 데이터시트 Figure 2 원문 발췌. 오른쪽 위 Proc0·Proc1, 중앙 Bus Fabric, 오른쪽 아래 SRAM, 왼쪽 Peripherals가 연결된 기능 구조도.', 'Unmodified Figure 2 excerpt from the RP2040 datasheet: Proc0 and Proc1 at upper right, Bus Fabric in the centre, SRAM below right, and Peripherals at left. This is a functional diagram, not a die photograph.');
const steps = board ? [
  [t('초록색 기판 전체', 'The whole green board'), t('Raspberry Pi Pico 보드입니다. 칩뿐 아니라 USB 커넥터와 여러 부품이 함께 있습니다.', 'This is the Raspberry Pi Pico board, containing a chip, USB connector and other components.')],
  [t('가운데의 검은 정사각형', 'The black square near the centre'), t('RP2040 MCU의 패키지입니다. 이 패키지 안에 CPU 코어와 다른 회로가 들어갑니다.', 'This is the RP2040 MCU package. It contains CPU cores and other circuits.')],
  [t('CPU 코어는 어디에?', 'Where are the CPU cores?'), t('사진 표면에서는 보이지 않습니다. 두 Cortex-M0+ 코어는 다음 데이터시트 그림에서 확인합니다.', 'They are not visible on the package surface. Locate the two Cortex-M0+ cores in the next datasheet figure.')]
] : [
  ['Proc0 / Proc1', t('오른쪽 위. 명령을 실행하는 두 프로세서 코어부터 찾습니다.', 'Upper right: first locate the two processor cores that execute instructions.')],
  ['Bus Fabric', t('가운데 큰 상자. 코어와 메모리·주변장치가 요청과 데이터를 주고받는 연결 구조입니다.', 'The large middle box: connections that carry requests and data between cores, memory and peripherals.')],
  ['Memory / SRAM', t('오른쪽 아래. 작업 중인 데이터나 코드를 둘 수 있는 내부 메모리입니다.', 'Lower right: internal memory that can hold working data or code.')],
  ['Peripherals', t('왼쪽 가운데. SPI·UART·I²C처럼 외부 장치와 통신하는 회로도 CPU와 별도로 존재합니다.', 'Middle left: communication hardware such as SPI, UART and I²C exists alongside the CPU cores.')]
];
---
<figure class:list={['soc-source', { 'soc-source--board': board }]} data-soc-source={kind} aria-labelledby={id}>
  <header class="soc-source__header">
    <span class="soc-source__eyebrow">{board ? t('실물 사진 · 먼저 눈으로 보기', 'REAL PHOTOGRAPH · START WITH THE OBJECT') : t('제조사 데이터시트 · 같은 칩의 내부 구조', 'MANUFACTURER DATASHEET · INSIDE THE SAME CHIP')}</span>
    <h3>{title}</h3>
  </header>
  <div class="soc-source__layout">
    <div class="soc-source__visual">
      <a class="soc-source__image-link" href={asset.src} target="_blank" rel="noopener noreferrer" data-soc-zoom={kind} aria-label={t('고해상도 이미지 크게 보기 — 새 탭', 'Open the full-resolution image in a new tab')}>
        <img src={asset.src} width={asset.width} height={asset.height} alt={alt} loading={board ? 'eager' : 'lazy'} decoding="async" />
        <span class="soc-source__zoom">{t('이미지 크게 보기 ↗', 'View full image ↗')}</span>
      </a>
      <p class="soc-source__takeaway">{board
        ? t('Pico는 보드, RP2040은 칩, Cortex-M0+는 그 안의 코어입니다.', 'Pico is the board. RP2040 is the chip. Cortex-M0+ is a core inside it.')
        : t('CPU는 전체 그림이 아니라, 전체 그림 안의 두 작은 블록입니다.', 'The CPUs are two blocks within this system—not the whole system.')}</p>
    </div>
    <div class="soc-source__guide">
      <p class="soc-source__guide-title">{t('이 순서로 보세요', 'LOOK IN THIS ORDER')}</p>
      <ol>{steps.map(([label, explanation]) => <li><strong>{label}</strong><span>{explanation}</span></li>)}</ol>
    </div>
  </div>
  <figcaption id={id} class="soc-source__caption">
    {board ? <>
      <span>{t('실제 Raspberry Pi Pico 상면. 사진은 패키지 밖을 보여주며 칩 내부 회로의 배치를 증명하지 않습니다.', 'Actual Raspberry Pi Pico, top view. This photograph shows the package exterior, not the arrangement of circuits inside the silicon.')}</span>
      <span class="soc-source__credit">Photo © Phiarc · <a href="https://commons.wikimedia.org/wiki/File:Raspberry_Pi_Pico_top.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a> · {t('크기 조정·WebP 변환. 그래픽 추가 없음.', 'Resized and converted to WebP; no graphical additions.')}</span>
    </> : <>
      <span>{t('Raspberry Pi Ltd, RP2040 Datasheet, Figure 2. 인쇄 쪽수 10 / PDF 11번째 페이지. 원문 그림 발췌이며 실제 다이 사진이나 물리 배치도가 아닙니다.', 'Raspberry Pi Ltd, RP2040 Datasheet, Figure 2. Printed page 10 / PDF page 11. An unchanged figure excerpt, not a die photograph or physical layout.')}</span>
      <span class="soc-source__credit">© Raspberry Pi Ltd · <a href="https://datasheets.raspberrypi.com/rp2040/rp2040-datasheet.pdf#page=11" target="_blank" rel="noopener noreferrer">{t('공식 PDF 해당 페이지 ↗', 'Official PDF page ↗')}</a> · <a href="/images/posts/soc-00/rp2040-page-10.webp" target="_blank" rel="noopener noreferrer">{t('전체 원문 페이지', 'Complete original page')}</a> · <a href="https://creativecommons.org/licenses/by-nd/4.0/" target="_blank" rel="noopener noreferrer">CC BY-ND 4.0</a></span>
      <span class="soc-source__edition">{t('확인 판본', 'Reviewed edition')}: 2025-02-20 · 3184e62-clean. {t('원문 라벨·연결선 변경 없음. 한글 해설은 그림 밖에 분리했습니다.', 'Original labels and connections are unchanged. Explanatory text is separate from the figure.')}</span>
    </>}
  </figcaption>
</figure>
<style>
  .soc-source{--source-ink:#182d39;--source-muted:#485f6c;--source-line:#cbd9dc;--source-paper:#f3f7f7;--source-accent:#155f62;box-sizing:border-box;margin:2.3rem 0 2.8rem;border:1px solid var(--source-line);border-radius:18px;overflow:hidden;background:var(--source-paper);color:var(--source-ink);font-size:1rem;line-height:1.7;}
  .soc-source *{box-sizing:border-box;}
  .soc-source__header{padding:1.4rem 1.5rem 1rem;}
  .soc-source__eyebrow{color:var(--source-accent);font-size:.78rem;font-weight:750;letter-spacing:.07em;}
  .soc-source__header h3{margin:.4rem 0 0!important;font-size:clamp(1.24rem,2.3vw,1.6rem)!important;line-height:1.4;letter-spacing:-.035em;color:inherit!important;}
  .soc-source__layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:1.4rem;padding:0 1.5rem 1.4rem;align-items:start;}
  .soc-source__visual,.soc-source__guide{min-width:0;}
  .soc-source__image-link{display:block;position:relative;background:white;border:1px solid var(--source-line);border-radius:10px;overflow:hidden;color:#163641!important;text-decoration:none!important;}
  .soc-source__image-link img{display:block;width:100%;height:auto;max-width:100%;margin:0!important;border-radius:0!important;filter:none!important;}
  .soc-source__zoom{display:block;text-align:right;padding:.48rem .8rem;border-top:1px solid #e2e7e8;background:#fff;font-size:.78rem;font-weight:650;}
  .soc-source__takeaway{margin:.8rem 0 0!important;font-size:1.02rem;font-weight:720;line-height:1.6;color:inherit;}
  .soc-source__guide-title{margin:0 0 .65rem!important;color:var(--source-muted);font-size:.76rem;font-weight:750;letter-spacing:.045em;}
  .soc-source__guide ol{padding:0!important;margin:0!important;list-style:none;counter-reset:source-step;}
  .soc-source__guide li{counter-increment:source-step;position:relative;padding:0 0 .8rem 2rem!important;margin:0 0 .8rem!important;border-bottom:1px solid var(--source-line);}
  .soc-source__guide li:last-child{padding-bottom:0!important;margin-bottom:0!important;border:0;}
  .soc-source__guide li::before{content:counter(source-step);position:absolute;left:0;top:.06rem;display:grid;place-items:center;width:1.35rem;height:1.35rem;border:1px solid var(--source-line);border-radius:50%;color:var(--source-accent);font-weight:750;font-size:.8rem;}
  .soc-source__guide strong{display:block;font-size:.96rem;line-height:1.5;}
  .soc-source__guide li span{display:block;font-size:.88rem;line-height:1.65;color:var(--source-muted);margin-top:.2rem;overflow-wrap:anywhere;}
  .soc-source__caption{display:block;margin:0!important;padding:1rem 1.5rem;border-top:1px solid var(--source-line);font-size:.85rem;line-height:1.7;text-align:left!important;color:var(--source-muted);}
  .soc-source__caption>span{display:block;}
  .soc-source__credit{margin-top:.4rem;}
  .soc-source__caption a{color:var(--source-accent);text-decoration:underline;text-underline-offset:3px;}
  .soc-source__edition{font-size:.78rem;margin-top:.35rem;}
  .soc-source a:focus-visible{outline:3px solid var(--source-accent);outline-offset:3px;}
  :global(.dark) .soc-source{--source-ink:#ebf3f5;--source-muted:#c1d2d8;--source-line:#3b525b;--source-paper:#1d3039;--source-accent:#9fe2db;}
  @media(max-width:760px){.soc-source__layout{grid-template-columns:1fr;gap:1.15rem;padding:0 1rem 1.2rem;}.soc-source__header{padding:1.1rem 1rem .9rem;}.soc-source__caption{padding:.9rem 1rem;}.soc-source__guide ol{display:grid;gap:.75rem;}.soc-source__guide li{margin:0!important;padding-bottom:.65rem!important;}.soc-source__guide li span{font-size:.94rem;}.soc-source__header h3{font-size:1.24rem!important;}.soc-source{border-radius:13px;}}
</style>
