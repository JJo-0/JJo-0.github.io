---
interface Props {
  title: string;
  eyebrow?: string;
}
const { title, eyebrow = '처음 읽는 분' } = Astro.props;
---

<details class="beginner-guide" data-beginner-guide>
  <summary>
    <span class="beginner-guide__eyebrow">{eyebrow}</span>
    <strong>{title}</strong>
    <span class="beginner-guide__hint">그림으로 보기</span>
  </summary>
  <div class="beginner-guide__body">
    <slot />
  </div>
</details>

<style>
  .beginner-guide {
    margin: 1.4rem 0 2rem;
    overflow: clip;
    border: 1px solid color-mix(in srgb, var(--color-border) 82%, var(--color-foreground) 18%);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-muted) 28%, transparent);
  }
  .beginner-guide summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.55rem 0.8rem;
    align-items: center;
    padding: 1rem 1.05rem;
    cursor: pointer;
    list-style: none;
  }
  .beginner-guide summary::-webkit-details-marker { display: none; }
  .beginner-guide__eyebrow {
    padding: 0.2rem 0.48rem;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .beginner-guide summary strong {
    min-width: 0;
    color: var(--color-foreground);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .beginner-guide__hint {
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .beginner-guide__hint::before { content: '+ '; font-weight: 800; }
  .beginner-guide[open] .beginner-guide__hint::before { content: '− '; }
  .beginner-guide__body {
    padding: 0 1.05rem 1.15rem;
    border-top: 1px solid var(--color-border);
  }
  .beginner-guide__body :global(.news-figure) { margin: 1rem 0 1.2rem; }
  .beginner-guide__body :global(p),
  .beginner-guide__body :global(li) { line-height: 1.8; }
  .beginner-guide__body :global(ul) { margin: 0.8rem 0 1rem; }
  @media (max-width: 560px) {
    .beginner-guide summary { grid-template-columns: auto 1fr; }
    .beginner-guide__hint { grid-column: 2; }
  }
</style>
