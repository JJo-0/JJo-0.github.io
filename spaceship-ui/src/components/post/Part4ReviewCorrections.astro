---
import SourceFormula from '@/components/post/SourceFormula.astro';
import { part4ReviewCorrections } from '@/lib/modern-ai-part4';
---

<section
  class="not-prose my-12 rounded-3xl border border-amber-500/30 bg-amber-500/[0.05] p-5 sm:p-7"
  data-part4-review-corrections
  aria-labelledby="part4-review-corrections-title"
>
  <div class="max-w-3xl">
    <p class="m-0 text-xs font-black uppercase tracking-[0.16em] text-amber-700 dark:text-amber-300">
      Adversarial review · source-preserving corrections
    </p>
    <h2 id="part4-review-corrections-title" class="mb-0 mt-2 text-2xl font-black text-foreground">
      추가 적대적 검토 교정
    </h2>
    <p class="mb-0 mt-3 text-sm leading-7 text-muted-foreground">
      아래 식은 PDF 원문을 덮어쓰지 않는다. 검토에서 수학적 문제가 확인된 원문 ID는
      <code>source-suspect</code> 상태로 그대로 남기고, 각 교정식은 별도 ID와 <code>corrects</code>
      링크를 가진다.
    </p>
  </div>

  <div class="mt-6 space-y-6">
    {part4ReviewCorrections.map((formula) => (
      <div data-part4-review-correction={formula.formulaId} data-corrects={formula.corrects}>
        <SourceFormula formula={formula} part={4} />
      </div>
    ))}
  </div>
</section>
