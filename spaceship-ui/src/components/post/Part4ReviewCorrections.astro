---
import SourceFormula from '@/components/post/SourceFormula.astro';
import { part4ReviewCorrections } from '@/lib/modern-ai-part4';
---

<section
  class="not-prose my-12 rounded-3xl border border-border bg-card/45 p-5 sm:p-7"
  data-part4-review-corrections
  aria-labelledby="part4-review-corrections-title"
>
  <div class="max-w-3xl">
    <h2 id="part4-review-corrections-title" class="m-0 text-2xl font-black text-foreground">
      추가 수학적 교정
    </h2>
    <p class="mb-0 mt-3 text-sm leading-7 text-muted-foreground">
      본문의 일부 식은 후속 수학 검토에서 더 정확한 형태가 확인되어 아래 교정식을 함께 제시한다.
    </p>
  </div>

  <div class="mt-6 space-y-6">
    {part4ReviewCorrections.map((formula) => (
      <div data-part4-review-correction={formula.formulaId} data-corrects={formula.corrects}>
        <SourceFormula formula={formula} part={4} />
      </div>
    ))}
  </div>
</section>
