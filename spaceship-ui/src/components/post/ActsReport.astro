---
import BibleResearchDocument from './BibleResearchDocument.astro';
import report1 from '@/data/acts-reports/report-1.html?raw';
import report2 from '@/data/acts-reports/report-2.html?raw';
import report3 from '@/data/acts-reports/report-3.html?raw';
interface Props { report: 1 | 2 | 3; }
const { report } = Astro.props;
const reports = { 1: report1, 2: report2, 3: report3 };
---
<aside class="not-prose mb-8 rounded-lg border border-border bg-card p-5 leading-relaxed">
  <p>사도행전 2:14–37 · 전체 연구 {report} / 3</p>
  <p class="mt-3 text-sm text-muted-foreground">작성자가 제공한 공개 연구의 전체 본문·표·인용을 보존한 읽기용 편집본입니다. 원자료의 학술 판정은 개별 출처에 대한 독립 검증이나 전문가 동료심사 완료를 뜻하지 않습니다.</p>
  <p class="mt-3 text-sm text-muted-foreground">기존 1:1–14 연구와 구별되는 본문 범위입니다. 사도행전 1:15–26과 2:1–13은 아직 자료가 제공되지 않았습니다.</p>
  <div class="mt-4 flex flex-wrap gap-4 text-sm underline underline-offset-4">
    <a href="/bible">전체 연구 범위</a>
    <a href="/bible/reading-guide">성경 글을 읽기 전에</a>
    {report > 1 && <a href={`/posts/acts-2-14-37-${report - 1}`}>← 이전 연구</a>}
    {report < 3 && <a href={`/posts/acts-2-14-37-${report + 1}`}>다음 연구 →</a>}
  </div>
  <details class="mt-4 text-sm"><summary>원문·출처 펼쳐보기</summary><p class="mt-2"><a href="https://blog.naver.com/jjo_09_/224428120204" target="_blank" rel="noopener noreferrer">공개된 Naver 전체 원문 ↗</a> · 2026-10-01 원문 스냅샷. 보고서별 인용 출처는 글 하단에 모았습니다.</p></details>
</aside>
<BibleResearchDocument label={`사도행전 2:14–37 전체 연구 ${report}`}>
  <div data-acts-report={report} set:html={reports[report]} />
</BibleResearchDocument>
