---
import NavierEquationMap from './NavierEquationMap.astro';
import catalogue from '../../../site/news-diagrams.json';
import englishDiagrams from '../../../site/news-diagrams-en.json';

interface Props {
  diagram: keyof typeof catalogue;
  lang?: 'ko' | 'en';
}

const { diagram, lang = 'ko' } = Astro.props;
const source = catalogue[diagram];
if (!source) throw new Error(`Unknown NEWS diagram: ${diagram}`);
const translation = (englishDiagrams as Record<string, Pick<typeof source, 'src' | 'alt' | 'caption'>>)[diagram];
if (lang === 'en' && !translation) throw new Error(`Missing English NEWS diagram: ${diagram}`);
const item = lang === 'en' ? { ...source, ...translation } : source;
---

{diagram === 'navier-equation-map' && lang === 'ko' ? (
  <div data-news-diagram={diagram}><NavierEquationMap /></div>
) : (
<figure class="news-figure news-diagram" data-news-diagram={diagram}>
  <a
    class="news-figure__image"
    href={item.src}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${item.alt} — ${lang === 'en' ? 'View full size' : '크게 보기'}`}
  >
    <img
      src={item.src}
      alt={item.alt}
      width={item.width}
      height={item.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    <strong>{lang === 'en' ? 'Original explanatory diagram' : '자체 제작 설명 도식'}</strong>
    <span>{item.caption}</span>
    <small>{lang === 'en' ? 'JJo · Illustrated from the sources cited in the article. The diagram explains the concept and does not show measured results.' : 'JJo · 기사에서 확인한 원문을 바탕으로 재구성 · 실제 측정 Figure가 아님'}</small>
  </figcaption>
</figure>
)}

<style>
  .news-figure {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 2rem 0;
  }
  .news-figure__image {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    background: #f3efe4;
  }
  .news-figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
  }
  .news-figure figcaption {
    margin-top: 0.8rem;
    color: var(--color-muted-foreground);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .news-figure figcaption strong,
  .news-figure figcaption span,
  .news-figure figcaption small {
    display: block;
  }
  .news-figure figcaption strong {
    color: var(--color-foreground);
  }
  .news-figure figcaption span {
    margin-top: 0.25rem;
  }
  .news-figure figcaption small {
    margin-top: 0.25rem;
    font-size: 0.72rem;
  }
</style>
