---
interface Props { id: string; label: string; }
const { id, label } = Astro.props;
if (!id || !label || !Astro.slots.has('default')) throw new Error('A labelled, authored table is required.');
---
<div class="wetlab-table" data-wetlab-table={id} role="region" aria-label={label} tabindex="0">
  <slot />
</div>
<style>
  .wetlab-table { max-width:100%; overflow-x:auto; margin:1.5rem 0; border:1px solid var(--color-border); border-radius:0.5rem; }
  .wetlab-table:focus-visible { outline:2px solid var(--color-primary); outline-offset:3px; }
  /* These four compact tables are cheaper to lay out than to re-estimate
     their heights during native fragment navigation and history restoration. */
  .wetlab-table :global(table) { display:table; width:100%; min-width:32rem; max-width:none; table-layout:fixed; margin:0 !important; font-size:0.88rem; content-visibility:visible; contain-intrinsic-size:none; font-variant-numeric:tabular-nums; }
  .wetlab-table :global(th), .wetlab-table :global(td) { min-width:0; max-width:none; white-space:normal; overflow-wrap:anywhere; padding:0.7rem !important; text-align:left; vertical-align:top; line-height:1.7; }
  .wetlab-table :global(tr > :first-child) { min-width:0; max-width:none; }
  .wetlab-table :global(th) { font-weight:700; }
  .wetlab-table[data-wetlab-table="wetlab-results"] :global(table) { min-width:0; font-size:0.84rem; }
  .wetlab-table[data-wetlab-table="wetlab-results"] :global(th:first-child) { width:42%; }
  .wetlab-table[data-wetlab-table="wetlab-results"] :global(th:nth-child(2)) { width:32%; }
  .wetlab-table[data-wetlab-table="wetlab-results"] :global(th:nth-child(3)) { width:26%; }
</style>
