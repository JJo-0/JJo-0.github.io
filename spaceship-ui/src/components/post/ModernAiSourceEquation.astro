---
import Math from './Math.astro';

interface Props {
  id: string;
  part: 6 | 7 | 8;
  page: number;
  tex: string;
  title: string;
  hash: string;
}

const { id, part, page, tex, title, hash } = Astro.props;
---

<figure
  class="source-equation my-8 overflow-hidden rounded-2xl border border-border/80 bg-card/55 shadow-sm"
  data-formula-id={id}
  data-formula-part={String(part)}
  data-source-page={String(page)}
  data-formula-hash={hash}
>
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-border/70 bg-muted/25 px-4 py-3 sm:px-5"
  >
    <figcaption class="text-base font-black leading-6 text-foreground">{title}</figcaption>
    <button
      type="button"
      class="formula-copy rounded-full border border-border bg-background px-3 py-1.5 text-xs font-bold text-muted-foreground transition hover:border-primary/40 hover:text-primary"
      data-copy-tex={tex}
      aria-label={`${title} LaTeX 복사`}>수식 복사</button
    >
  </div>
  <div class="overflow-x-auto overflow-y-hidden px-3 py-3 sm:px-5">
    <Math tex={tex} display label={title} />
  </div>
</figure>
