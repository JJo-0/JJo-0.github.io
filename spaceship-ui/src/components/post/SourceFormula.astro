---
import Math from './Math.astro';

interface FormulaRecord {
  formulaId: string;
  pdfPage: number;
  sourceEquationNumber?: string | null;
  sourceLatex: string;
  articleSection: string;
  status: 'source-exact' | 'source-suspect' | 'editorially-completed' | 'corrected-variant';
  display: 'inline' | 'display';
  note?: string | null;
  corrects?: string | null;
  sha256: string;
}

interface Props {
  formula: FormulaRecord;
  display?: boolean;
}

const { formula, display = formula.display === 'display' } = Astro.props;
const statusLabel = {
  'source-exact': '원자료',
  'source-suspect': '원자료 · 검증 필요',
  'editorially-completed': '편집 완성식',
  'corrected-variant': '교정식',
}[formula.status];
const aria = `${formula.formulaId}, PDF page ${formula.pdfPage}, ${statusLabel}`;
---

{
  display ? (
    <figure
      class:list={[
        'source-formula my-6 rounded-xl border px-4 py-3',
        formula.status === 'source-suspect' && 'border-amber-500/40 bg-amber-500/5',
        formula.status === 'editorially-completed' && 'border-sky-500/40 bg-sky-500/5',
        formula.status === 'corrected-variant' && 'border-emerald-500/40 bg-emerald-500/5',
        formula.status === 'source-exact' && 'border-border bg-card/40',
      ]}
      data-formula-id={formula.formulaId}
      data-source-page={formula.pdfPage}
      data-formula-status={formula.status}
      data-formula-hash={formula.sha256}
    >
      <figcaption class="mb-1 flex flex-wrap gap-x-2 text-[0.68rem] font-bold uppercase tracking-[0.11em] text-muted-foreground">
        <span>{formula.formulaId}</span>
        <span>PDF p.{formula.pdfPage}</span>
        {formula.sourceEquationNumber && <span>source {formula.sourceEquationNumber}</span>}
        <span>{statusLabel}</span>
      </figcaption>
      <Math tex={formula.sourceLatex} display label={aria} />
      {formula.note && <p class="mt-2 text-xs leading-5 text-muted-foreground">{formula.note}</p>}
    </figure>
  ) : (
    <span
      class="source-formula-inline"
      data-formula-id={formula.formulaId}
      data-source-page={formula.pdfPage}
      data-formula-status={formula.status}
      data-formula-hash={formula.sha256}
      title={`${formula.formulaId} · PDF p.${formula.pdfPage} · ${statusLabel}`}
    >
      <Math tex={formula.sourceLatex} label={aria} />
    </span>
  )
}
