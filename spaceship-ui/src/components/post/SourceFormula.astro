---
import Math from './Math.astro';
import FormulaGuide from './FormulaGuide.astro';
import { formulaCardTitle } from '@/lib/modern-ai-formula-guide.mjs';

interface FormulaRecord {
  formulaId: string;
  pdfPage: number;
  sourceEquationNumber?: string | null;
  sourceLatex: string;
  articleSection: string;
  status: 'source-exact' | 'source-suspect' | 'editorially-completed' | 'corrected-variant';
  display: 'inline' | 'display';
  note?: string | null;
  corrects?: string | null;
  sha256: string;
}

interface Props {
  formula: FormulaRecord;
  display?: boolean;
}

const { formula, display = formula.display === 'display' } = Astro.props;
const title = formulaCardTitle({
  formulaId: formula.formulaId,
  section: formula.articleSection,
  tex: formula.sourceLatex,
});

const statusLabel = {
  'source-exact': '원자료 수식',
  'source-suspect': '원자료 표기 확인 필요',
  'editorially-completed': '원자료 빈칸의 완성식',
  'corrected-variant': '수학적 교정식',
}[formula.status];

const sourceLabel = `PDF ${formula.pdfPage}쪽${formula.sourceEquationNumber ? ` · 식 ${formula.sourceEquationNumber}` : ''}`;
const guideNote = formula.note || (
  formula.status === 'source-exact'
    ? null
    : '원자료의 빈칸·표기 문제를 숨기지 않고 원문과 완성식·교정식을 분리해 표시한다.'
);
const aria = `${title}, ${sourceLabel}, ${statusLabel}`;
---

{
  display ? (
    <figure
      class:list={[
        'source-formula my-8 overflow-hidden rounded-2xl border bg-card/55 shadow-sm',
        formula.status === 'source-suspect' && 'border-amber-500/40',
        formula.status === 'editorially-completed' && 'border-sky-500/40',
        formula.status === 'corrected-variant' && 'border-emerald-500/40',
        formula.status === 'source-exact' && 'border-border/80',
      ]}
      data-formula-id={formula.formulaId}
      data-source-page={formula.pdfPage}
      data-formula-status={formula.status}
      data-formula-hash={formula.sha256}
      data-formula-guide="rich"
      data-formula-part="2"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/70 bg-muted/25 px-4 py-3 sm:px-5">
        <div class="min-w-0">
          <p class="m-0 text-[0.68rem] font-black uppercase tracking-[0.14em] text-primary/80">{statusLabel} · {sourceLabel}</p>
          <figcaption class="mt-1 text-base font-black leading-6 text-foreground">{title}</figcaption>
        </div>
        <button
          type="button"
          class="formula-copy rounded-full border border-border bg-background px-3 py-1.5 text-xs font-bold text-muted-foreground transition hover:border-primary/40 hover:text-primary"
          data-copy-tex={formula.sourceLatex}
          aria-label={`${title} LaTeX 복사`}
        >수식 복사</button>
      </div>

      <div class="overflow-x-auto overflow-y-hidden px-3 py-2 sm:px-5">
        <Math tex={formula.sourceLatex} display label={aria} />
      </div>

      <FormulaGuide
        formulaId={formula.formulaId}
        tex={formula.sourceLatex}
        section={formula.articleSection}
        part={2}
        sourceLabel={`${sourceLabel} · ${formula.articleSection}`}
        note={guideNote}
        statusLabel={statusLabel}
      />
    </figure>
  ) : (
    <span
      class="source-formula-inline"
      data-formula-id={formula.formulaId}
      data-source-page={formula.pdfPage}
      data-formula-status={formula.status}
      data-formula-hash={formula.sha256}
      title={`${sourceLabel} · ${statusLabel}`}
    >
      <Math tex={formula.sourceLatex} label={aria} />
    </span>
  )
}
