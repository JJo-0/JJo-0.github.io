---
import Math from './Math.astro';
const terms = [
  { title: '시간 변화', tex: String.raw`\frac{\partial\mathbf u}{\partial t}`, body: '한 위치에서 관찰한 속도의 시간 변화' },
  { title: '이동에 따른 변화', tex: String.raw`(\mathbf u\!\cdot\!\nabla)\mathbf u`, body: '유체 입자가 이동하며 겪는 가속도' },
  { title: '압력', tex: String.raw`-\nabla p`, body: '압력 차이가 만드는 가속도' },
  { title: '점성', tex: String.raw`\nu\Delta\mathbf u`, body: '속도 차이를 퍼뜨리는 효과' },
  { title: '외력', tex: String.raw`\mathbf f`, body: '단위 질량에 외부에서 가하는 힘' },
];
---
<section class="equation-map" aria-label="나비에–스토크스 방정식의 다섯 항" data-typeset-equation-map>
  <p class="equation-map__eyebrow">MOMENTUM BALANCE</p>
  <h3>흐름을 만드는 다섯 항</h3>
  <Math display label="외력을 포함한 나비에–스토크스 운동량 방정식" tex={String.raw`\frac{\partial\mathbf u}{\partial t}+(\mathbf u\!\cdot\!\nabla)\mathbf u=-\nabla p+\nu\Delta\mathbf u+\mathbf f`} />
  <p class="equation-map__constraint">비압축성 조건 <Math tex={String.raw`\nabla\!\cdot\!\mathbf u=0`} /></p>
  <div class="equation-map__terms">
    {terms.map((term) => <div class="equation-map__term"><strong>{term.title}</strong><Math display tex={term.tex} label={term.title} /><p>{term.body}</p></div>)}
  </div>
  <p class="equation-map__question">방정식을 쓰는 것과 모든 해의 매끄러움을 보장하는 것은 다른 문제다.</p>
</section>
<style>
  .equation-map { margin: 2rem 0; padding: clamp(1rem, 3vw, 1.75rem); border: 1px solid var(--color-border); border-radius: .8rem; background: color-mix(in srgb, var(--color-card) 75%, transparent); }
  .equation-map__eyebrow { color: var(--color-muted-foreground); font-size: .65rem; letter-spacing: .18em; font-weight: 800; }
  .equation-map h3 { margin: .65rem 0 0; font-size: 1.25rem; font-weight: 800; }
  .equation-map__constraint { display: flex; justify-content: center; gap: 1rem; align-items: center; font-size: .85rem; }
  .equation-map__terms { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .75rem; margin-top: 1.5rem; }
  .equation-map__term { min-width: 0; padding: 1rem .7rem; border: 1px solid var(--color-border); border-radius: .45rem; }
  .equation-map__term strong { display:block; font-size: .82rem; text-align: center; }
  .equation-map__term p { margin: 0; font-size:.78rem; line-height:1.7; color:var(--color-muted-foreground); }
  .equation-map__term :global(.math-display) { padding:.5rem 0; border:0; background:none; margin:.4rem 0; }
  .equation-map__term :global(.katex) { font-size:1em; }
  .equation-map__question { margin-top:1.25rem; border-top:1px solid var(--color-border); padding-top:1rem; font-size:.85rem; line-height:1.8; }
  @media(max-width:640px){ .equation-map__terms { grid-template-columns:minmax(0,1fr); } .equation-map__term { display:grid;grid-template-columns:1fr 1.2fr;gap:.4rem 1rem;align-items:center; } .equation-map__term p { grid-column:1 / -1;text-align:center; } }
</style>
