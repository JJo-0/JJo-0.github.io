---
interface Props { id: string; label: string; }
const { id, label } = Astro.props;
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id) || !label.trim() || !Astro.slots.has('default')) throw new Error('An authored table needs an ID and label.');
---
<div class="candidate-table" data-candidate-table={id} role="region" aria-label={label} tabindex="0"><slot /></div>
<style>
.candidate-table { max-width:100%; overflow-x:auto; margin:1.5rem 0; border:1px solid var(--color-border); border-radius:.5rem; }
.candidate-table:focus-visible { outline:2px solid var(--color-primary); outline-offset:3px; }
.candidate-table :global(table) { display:table; width:100%; min-width:32rem; max-width:none; table-layout:fixed; margin:0 !important; font-size:.85rem; content-visibility:visible; contain-intrinsic-size:none; font-variant-numeric:tabular-nums; }
.candidate-table :global(th), .candidate-table :global(td) { min-width:0; max-width:none; white-space:normal; overflow-wrap:anywhere; padding:.65rem !important; text-align:left; vertical-align:top; line-height:1.7; }
.candidate-table :global(tr > :first-child) { min-width:0; max-width:none; }
.candidate-table[data-candidate-table="whisker-results"] :global(th:first-child) { width:30%; }
.candidate-table[data-candidate-table="whisker-results"] :global(th:not(:first-child)), .candidate-table[data-candidate-table="whisker-results"] :global(td:not(:first-child)) { text-align:right; }
</style>
