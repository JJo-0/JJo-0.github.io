---
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  display?: boolean;
  label?: string;
}

const { tex, display = false, label } = Astro.props;
const html = katex.renderToString(tex, {
  displayMode: display,
  throwOnError: false,
  strict: 'warn',
  trust: false,
  output: 'htmlAndMathml',
});
---

{
  display ? (
    <div class="math-display" aria-label={label} tabindex="0" set:html={html} />
  ) : (
    <span class="math-inline" aria-label={label} set:html={html} />
  )
}

<style>
  .math-display {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin: 1.65rem 0;
    padding: 1rem .7rem;
    overflow-x: auto;
    overflow-y: hidden;
    color: var(--color-foreground);
    border-block: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card) 58%, transparent);
    border-radius: .35rem;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .math-display:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .math-display :global(.katex-display) { margin: .2rem 0; }
  .math-display :global(.katex) { font-size: 1.12em; }
  .math-inline :global(.katex) { font-size: 1.04em; }
  @media (max-width: 640px) {
    .math-display { padding: .9rem .35rem; margin: 1.35rem 0; }
    .math-display :global(.katex) { font-size: 1.04em; }
  }
</style>
