---
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  display?: boolean;
  label?: string;
}

const { tex, display = false, label } = Astro.props;
const html = katex.renderToString(tex, {
  displayMode: display,
  throwOnError: false,
  strict: 'warn',
  trust: false,
  output: 'htmlAndMathml',
});
---

{
  display ? (
    <div
      class="math-display my-6 overflow-x-auto overflow-y-hidden py-2"
      aria-label={label}
      set:html={html}
    />
  ) : (
    <span class="math-inline" aria-label={label} set:html={html} />
  )
}
