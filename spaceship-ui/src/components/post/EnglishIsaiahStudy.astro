---
import BibleResearchDocument from '@/components/post/BibleResearchDocument.astro';
import IsaiahDashboard from '@/components/post/IsaiahDashboard.astro';
import { illustrateIsaiahReport } from '@/lib/isaiah43-images.en.mjs';
import report1 from '@/data/bible-english/isaiah-report-1.html?raw';
import report2 from '@/data/bible-english/isaiah-report-2.html?raw';
import report3 from '@/data/bible-english/isaiah-report-3.html?raw';
interface Props { report: 1 | 2 | 3; }
const { report } = Astro.props;
const perspectives = ['History, grammar, and integrated study', 'Literature, rhetoric, discourse, and metaphor', 'Social science, memory, theology, and reception'];
const html = illustrateIsaiahReport([report1, report2, report3][report - 1], report);
---
<section data-isaiah-study={report}>
  <nav aria-label="Isaiah 43:18–21: Studies 1–3" class="not-prose mb-8 grid gap-3 sm:grid-cols-3">
    {perspectives.map((title, i) => <a href={`/en/posts/isaiah-43-18-21-${i + 1}/`} aria-current={i + 1 === report ? 'page' : undefined} class="rounded border border-border p-3 text-sm leading-6">{i + 1}. {title}</a>)}
  </nav>
  <h2>Study {report} · Dashboard</h2>
  <IsaiahDashboard order={report} />
  <h2 id="gemini-chat-body">Full research text from the supplied Gemini chat</h2>
  <p>The author’s full research text is translated separately from the dashboard, retaining tables, citations, and source-access limitations. Claims and scores are the original draft’s assessments, not independently verified peer-review findings. Scripture quotations marked WEB use the public-domain World English Bible; other Hebrew renderings are lexical explanations.</p>
  <p><a href="https://ebible.org/engwebp/ISA43.htm">World English Bible: Isaiah 43</a> · <a href="https://ebible.org/engwebp/copyright.htm">Public-domain notice</a></p>
  <BibleResearchDocument label={`Isaiah 43:18–21 — Study ${report}: Full text`}>
    <div data-isaiah-research-body set:html={html} />
  </BibleResearchDocument>
  <details data-isaiah-original class="mt-8 border-t border-border pt-5 text-sm leading-7">
    <summary class="cursor-pointer font-semibold">Original and sources</summary>
    <p><a href="https://blog.naver.com/jjo_09_/224436720898" target="_blank" rel="noopener noreferrer">Full Korean Naver original · Isaiah 43:18–21 ↗</a></p>
  </details>
</section>
<style>
  nav a[aria-current='page'] { border-color:var(--color-primary); color:var(--color-primary); font-weight:700; }
  section :global(figure[data-isaiah-image]) { margin:2rem 0; padding:1rem; border:1px solid var(--color-border); border-radius:var(--radius-md); }
  section :global(figure[data-isaiah-image] img) { display:block; width:100%; height:auto; max-height:38rem; object-fit:contain; }
  section :global(figure[data-isaiah-image] figcaption) { margin-top:.8rem; font-size:.85rem; line-height:1.7; color:var(--color-muted-foreground); }
  #gemini-chat-body { margin-top:3rem; }
</style>
