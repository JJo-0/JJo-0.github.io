---
interface Props {
  family: string;
  formulaId: string;
}

const { family, formulaId } = Astro.props;

const kindByFamily: Record<string, string> = {
  'linear-system': 'linear',
  matrix: 'linear',
  inverse: 'linear',
  norm: 'linear',
  'dot-product': 'linear',
  'normal-equation': 'linear',
  covariance: 'covariance',
  gaussian: 'probability',
  expectation: 'probability',
  variance: 'probability',
  probability: 'probability',
  bayes: 'probability',
  'naive-bayes': 'probability',
  risk: 'probability',
  gradient: 'optimization',
  'gradient-descent': 'optimization',
  'optimization-objective': 'optimization',
  mse: 'optimization',
  regularization: 'optimization',
  convolution: 'convolution',
  hyperplane: 'classifier',
  'distance-classifier': 'classifier',
  sigmoid: 'classifier',
  kernel: 'classifier',
  'dimension-growth': 'data',
  kfold: 'data',
};

const visualCopy: Record<string, { title: string; note: string }> = {
  linear: {
    title: '벡터와 행렬이 실제로 무엇을 바꾸는지 본다',
    note: '슬라이더로 행렬 계수를 바꾸면 입력 벡터와 변환된 벡터가 동시에 움직인다.',
  },
  covariance: {
    title: '데이터 구름·공분산·고유축을 한 화면에서 연결한다',
    note: 'PCA 설명처럼 정사영 축을 돌리며 어느 방향에 분산이 가장 많이 남는지 확인한다.',
  },
  probability: {
    title: '확률분포의 모양과 계산값을 같이 움직인다',
    note: '평균과 퍼짐을 바꾸면 밀도곡선, 구간확률, 대표값이 어떻게 달라지는지 즉시 계산한다.',
  },
  optimization: {
    title: '손실 표면 위에서 한 단계씩 내려가 본다',
    note: '학습률을 바꾸며 느린 수렴, 안정적인 수렴, 진동과 발산의 차이를 확인한다.',
  },
  classifier: {
    title: '결정경계가 점들을 어떻게 나누는지 본다',
    note: '가중치와 편향을 바꾸면 경계의 방향·위치와 각 점의 점수가 함께 달라진다.',
  },
  convolution: {
    title: '커널을 움직이며 곱하고 더하는 과정을 본다',
    note: '출력 위치를 바꾸면 겹치는 입력 패치, 원소별 곱, 합산 결과가 순서대로 표시된다.',
  },
  data: {
    title: '차원과 데이터 분할이 계산량에 미치는 영향을 본다',
    note: '차원 수 또는 fold를 움직이며 표본 수와 평가 절차가 어떻게 커지는지 확인한다.',
  },
  generic: {
    title: '기호의 입력과 출력 관계를 수직선에서 확인한다',
    note: '값을 움직여 수식의 입력이 출력으로 바뀌는 방향과 크기를 확인한다.',
  },
};

const kind = kindByFamily[family] || 'generic';
const copy = visualCopy[kind];
---

<section
  class="formula-visual rounded-2xl border border-violet-500/25 bg-violet-500/[0.055]"
  data-formula-visual={kind}
  data-formula-family={family}
  data-visual-formula-id={formulaId}
  data-formula-visual-mounted="false"
>
  <div class="border-b border-violet-500/20 px-4 py-4 sm:px-5">
    <p class="m-0 text-[0.68rem] font-black uppercase tracking-[0.14em] text-violet-700 dark:text-violet-300">
      Direct manipulation visual
    </p>
    <h5 class="mb-0 mt-1 text-base font-black text-foreground">직접 움직여 보기 — {copy.title}</h5>
    <p class="mb-0 mt-1 text-sm leading-6 text-muted-foreground">{copy.note}</p>
  </div>
  <div class="formula-visual-stage min-h-64 px-3 py-4 sm:px-5" data-formula-visual-stage aria-live="polite">
    <div class="grid min-h-56 place-items-center rounded-xl border border-dashed border-violet-500/25 bg-background/65 px-5 text-center text-sm leading-6 text-muted-foreground">
      이 설명을 열면 현재 수식 유형에 맞는 시각화를 필요한 순간에만 생성한다.
    </div>
  </div>
</section>

<script>
  import '@/scripts/formula-visual-runtime.js';
</script>

<style>
  :global(.formula-visual-grid){display:grid;grid-template-columns:minmax(0,1.55fr) minmax(15rem,.75fr);gap:.85rem;align-items:start}
  :global(.formula-visual-canvas){min-width:0;overflow-x:auto;border:1px solid color-mix(in srgb,var(--color-border) 80%,transparent);border-radius:1rem;background:var(--color-background);padding:.45rem}
  :global(.formula-visual-svg){display:block;width:100%;min-width:34rem;height:auto}
  :global(.formula-visual-controls){display:grid;gap:.6rem;padding:.8rem;border:1px solid color-mix(in srgb,var(--color-border) 80%,transparent);border-radius:1rem;background:color-mix(in srgb,var(--color-background) 88%,transparent)}
  :global(.formula-visual-controls label){display:grid;grid-template-columns:1fr auto;gap:.3rem;font-size:.75rem;font-weight:800;color:var(--color-foreground)}
  :global(.formula-visual-controls output){color:var(--color-primary)}
  :global(.formula-visual-controls input[type=range]){grid-column:1/-1;width:100%;min-height:30px}
  :global(.formula-visual-controls button){min-height:44px;border:1px solid color-mix(in srgb,var(--color-primary) 30%,var(--color-border));border-radius:.75rem;background:color-mix(in srgb,var(--color-primary) 8%,var(--color-background));color:var(--color-foreground);font-size:.75rem;font-weight:900}
  :global(.formula-visual-status){margin-top:.2rem;padding:.75rem;border-radius:.75rem;background:color-mix(in srgb,var(--color-muted) 45%,transparent);color:var(--color-muted-foreground);font-size:.74rem;line-height:1.55}
  :global(.conv-board){display:grid;grid-template-columns:auto auto auto auto auto;gap:.7rem;align-items:center;justify-content:center;min-width:34rem;padding:1.5rem 1rem;color:#0f172a}.conv-board b{display:block;margin-bottom:.4rem;text-align:center}.conv-grid{display:grid;gap:3px}.conv-grid.input{grid-template-columns:repeat(4,3.8rem)}.conv-grid.kernel{grid-template-columns:repeat(2,3.8rem)}.conv-grid span{display:grid;min-height:3.8rem;place-items:center;border:1px solid #cbd5e1;border-radius:.45rem;background:#fff;font-weight:800}.conv-grid span.active{border-color:#f97316;background:#ffedd5}.conv-grid small{display:block;font-size:.58rem;color:#9a3412}.conv-op{font-size:1.6rem;font-weight:900}.conv-board strong{display:grid;width:5rem;height:5rem;place-items:center;border-radius:1rem;background:#7c3aed;color:white;font-size:1.5rem}
  :global(.data-visual){display:grid;gap:1rem;min-width:34rem;padding:1.5rem}.dimension-cubes{display:flex;flex-wrap:wrap;gap:4px;align-content:flex-start;min-height:8rem}.dimension-cubes i{width:1rem;height:1rem;border-radius:.2rem;background:#7c3aed}.dimension-cubes b{align-self:center;margin-left:.4rem;color:#7c3aed}.fold-strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(4rem,1fr);gap:.3rem}.fold-strip span{display:grid;min-height:3.2rem;place-items:center;border-radius:.55rem;background:#dbeafe;color:#1e3a8a;font-size:.72rem;font-weight:900}.fold-strip span.test{background:#fed7aa;color:#9a3412}
  @media(max-width:820px){:global(.formula-visual-grid){grid-template-columns:1fr}.formula-visual-stage{padding:.65rem}:global(.formula-visual-svg),:global(.conv-board),:global(.data-visual){min-width:37rem}}
  @media(prefers-reduced-motion:reduce){:global(.formula-visual *){scroll-behavior:auto!important;transition:none!important}}
</style>
