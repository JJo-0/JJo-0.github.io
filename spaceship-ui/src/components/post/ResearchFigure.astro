---
interface Props {
  src: string;
  alt: string;
  caption: string;
  source: string;
  credit: string;
  width?: number;
  height?: number;
  minWidth?: number;
}
const { src, alt, caption, source, credit, width, height, minWidth = 0 } = Astro.props;
---
<figure class="research-figure" data-research-figure>
  <div class="figure-viewport" tabindex={minWidth ? 0 : undefined} role={minWidth ? 'region' : undefined} aria-label={minWidth ? `${alt} — 좌우로 이동해 읽기` : undefined}>
    <a href={src} target="_blank" rel="noopener noreferrer" aria-label={`${alt} — 이미지 크게 보기`} style={minWidth ? `min-width:${minWidth}px` : undefined}>
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </a>
  </div>
  <figcaption>
    <span>{caption}</span>
    <small>{credit} · <a href={source} target="_blank" rel="noopener noreferrer">원문 보기</a> · <a href={src} target="_blank" rel="noopener noreferrer">그림 크게 보기</a></small>
    {minWidth > 0 && <small>좁은 화면에서는 그림 영역을 좌우로 이동해 축과 범례를 읽을 수 있습니다.</small>}
  </figcaption>
</figure>
<style>
  .research-figure { min-width:0; width:100%; margin:2rem 0; }
  .figure-viewport { max-width:100%; overflow-x:auto; overscroll-behavior-x:contain; border:1px solid var(--color-border); border-radius:.5rem; background:white; }
  .figure-viewport:focus-visible { outline:2px solid var(--color-primary); outline-offset:3px; }
  .figure-viewport a { display:block; width:100%; padding:.3rem; }
  .figure-viewport img { display:block; width:100%; height:auto; margin:0; object-fit:contain; }
  figcaption { margin-top:.85rem; font-size:.93rem; line-height:1.9; }
  figcaption span, figcaption small { display:block; }
  figcaption small { margin-top:.4rem; font-size:.8rem; line-height:1.8; color:var(--color-muted-foreground); overflow-wrap:anywhere; }
  figcaption a { text-decoration:underline; text-underline-offset:.17em; }
</style>
