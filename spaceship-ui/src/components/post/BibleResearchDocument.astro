---
interface Props { label?: string; }
const { label = '성경 연구 전체 본문' } = Astro.props;
---
<div class="bible-research-document" aria-label={label}>
  <slot />
</div>
<style>
  .bible-research-document { min-width: 0; line-height: 1.85; }
  .bible-research-document :global(h2) { margin: 2.5rem 0 1rem; line-height: 1.4; }
  .bible-research-document :global(h3) { margin: 2rem 0 .85rem; line-height: 1.45; }
  .bible-research-document :global(h4) { margin: 1.5rem 0 .75rem; line-height: 1.5; }
  .bible-research-document :global(p) { margin: .85rem 0; }
  .bible-research-document :global(ul) { list-style: disc; margin: .85rem 0; padding-inline-start: 1.6rem; }
  .bible-research-document :global(ol) { list-style: decimal; margin: .85rem 0; padding-inline-start: 1.8rem; }
  .bible-research-document :global(li) { margin: .35rem 0; padding-inline-start: .15rem; }
  .bible-research-document :global(.bible-table-scroll) { max-width: 100%; overflow-x: auto; margin: 1.5rem 0; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .bible-research-document :global(table) { width: 100%; table-layout: auto; border-collapse: collapse; margin: 0; font-size: .9rem; line-height: 1.7; }
  .bible-research-document :global(th), .bible-research-document :global(td) { padding: .8rem 1rem; text-align: start; vertical-align: top; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
  .bible-research-document :global(th) { background: var(--color-card); color: var(--color-foreground); font-weight: 700; }
  .bible-research-document :global(tr:last-child td) { border-bottom: 0; }
  .bible-research-document :global(td:first-child), .bible-research-document :global(th:first-child) { min-width: 6rem; }
  .bible-research-document :global(.bible-references) { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--color-border); font-size: .9rem; overflow-wrap: anywhere; }
  .bible-research-document :global(a[href^="#reference-"]) { font-variant-numeric: tabular-nums; text-underline-offset: .2em; }
  @media (max-width: 640px) {
    .bible-research-document :global(table) { font-size: .85rem; min-width: max(100%, calc(var(--bible-table-columns, 3) * 8rem)); }
    .bible-research-document :global(th), .bible-research-document :global(td) { padding: .65rem .75rem; min-width: 8rem; }
  }
</style>
