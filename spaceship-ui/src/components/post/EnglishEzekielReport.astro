---
import BibleResearchDocument from '@/components/post/BibleResearchDocument.astro';
import report1Html from '@/data/bible-english/ezekiel-report-1.html?raw';
import report2Html from '@/data/bible-english/ezekiel-report-2.html?raw';
import report3Html from '@/data/bible-english/ezekiel-report-3.html?raw';

interface Props { report: 1 | 2 | 3; }
const { report } = Astro.props;
const perspectives = ['Hebrew, history, and textual criticism', 'Literature, rhetoric, and embodiment', 'Social science, trauma, and reception'];
const imageDimensions = new Map<string, [number, number]>([
  ['/assets/en/posts/ezekiel-2-1-3-11/01-babylon-lion-met-31-13-2.jpg', [3811, 1656]],
  ['/assets/en/posts/ezekiel-2-1-3-11/02-nebuchadnezzar-cylinder-met-86-11-60-original.jpg', [3895, 2318]],
  ['/assets/en/posts/ezekiel-2-1-3-11/03-babylon-city-map-commons.png', [800, 694]],
]);
const reserveImageSpace = (html: string) => {
  let rendered = html;
  for (const [src, [width, height]] of imageDimensions) {
    rendered = rendered.replaceAll(
      `<img src="${src}"`,
      `<img src="${src}" width="${width}" height="${height}"`
    );
  }
  return rendered;
};
const reportHtml = reserveImageSpace([report1Html, report2Html, report3Html][report - 1]);
const perspective = perspectives[report - 1];
---

<section
  data-bible-source-guide="ezekiel"
  data-ezekiel-report={report}
  class="not-prose min-w-0 rounded-xl border border-border bg-card p-4 sm:p-6 lg:p-8"
>
  <header class="border-b border-border pb-5">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">Ezekiel 2:1–3:11 · Report {report} of 3</p>
    <h2 class="mt-2 text-2xl font-bold sm:text-3xl">{perspective}</h2>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-muted-foreground">
      Read the translated research, tables, images, and bibliography below. Scholarly claims and ratings remain the supplied draft’s assessments, rather than independently verified peer-review findings.
      The Korean Naver original is preserved below for comparison. Hebrew terms are retained; scriptural phrases are translated lexical glosses or identified public-domain WEB excerpts, rather than reproductions of an unverified copyrighted English edition.
    </p>
  </header>

  <nav aria-label="Ezekiel 2:1–3:11 research perspectives" class="my-5 border-b border-border pb-5">
    <ol class="grid gap-2 sm:grid-cols-3">
      {perspectives.map((item, index) => (
        <li>
          {report === index + 1 ? (
            <span aria-current="page" class="block rounded-lg border border-primary bg-primary/5 px-3 py-2 font-semibold">
              {index + 1}. {item}
            </span>
          ) : (
            <a class="block rounded-lg border border-border px-3 py-2 underline underline-offset-4 hover:border-primary" href={`/en/posts/ezekiel-2-1-3-11-${index + 1}/`}>
              {index + 1}. {item}
            </a>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <p><a href="https://ebible.org/engwebp/EZK02.htm">World English Bible: Ezekiel 2</a> · <a href="https://ebible.org/engwebp/copyright.htm">Public-domain notice</a></p>
  <BibleResearchDocument label={`Ezekiel 2:1–3:11 — ${perspective}: Full research text`}>
    <div data-ezekiel-research-body set:html={reportHtml} />
  </BibleResearchDocument>

  <details data-ezekiel-original class="mt-8 border-t border-border pt-5 text-sm leading-7">
    <summary class="cursor-pointer font-semibold">Original and sources</summary>
    <p class="mt-3 text-muted-foreground">
      This English text translates the author’s research copy obtained on 2026-10-01.
      Tables and cited sources are retained; executable scripts and onclick attributes are excluded.
    </p>
    <p class="mt-3">
      <a data-bible-original href="https://blog.naver.com/jjo_09_/224428051487" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary underline underline-offset-4">
        Compare with the Korean Naver original ↗
      </a>
      {' · '}
      <a href="/bible/" class="underline underline-offset-4">Korean Bible-study catalogue</a>
      {' · '}
      <a href="/bible/reading-guide/" class="underline underline-offset-4">Korean reading guide</a>
    </p>
  </details>
</section>

<style>
  [data-ezekiel-research-body] :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto .75rem;
    border-radius: var(--radius-md);
  }
  [data-ezekiel-research-body] :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: .2em;
    overflow-wrap: anywhere;
  }
  [data-ezekiel-research-body] :global([id^='reference-ezekiel-']) {
    scroll-margin-top: 7rem;
  }
  [data-ezekiel-research-body] :global(hr) {
    margin: 2rem 0;
    border-color: var(--color-border);
  }
  :is(a, summary):focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 4px;
  }
  :global(.article-layout:has([data-ezekiel-report]) > .w-52) {
    display: none;
  }
  :global(.article-prose:has([data-ezekiel-report])) {
    max-width: none;
  }
</style>
