---
import { getFormulaLessonSpec } from '@/lib/formula-lessons/lesson-specs.mjs';

interface LessonRef {
  formulaId: string;
  lessonId: string | null;
  focus: string | null;
  state: string;
  mode: string;
  renderer: string | null;
  reason?: string | null;
  source: Record<string, unknown>;
}

interface Props { lesson: LessonRef; }
const { lesson } = Astro.props;
if (!lesson.lessonId || !lesson.focus || !lesson.renderer) {
  throw new Error(`Incomplete approved formula lesson: ${lesson.formulaId}`);
}
const lessonId = lesson.lessonId;
const focus = lesson.focus;
const renderer = lesson.renderer;
const spec = getFormulaLessonSpec(lessonId);
if (!spec) throw new Error(`Unknown formula lesson spec: ${lessonId}`);
const payload = JSON.stringify({ lesson, spec }).replaceAll('<', '\\u003c');
const modeLabels: Record<string,string> = {interactive:'직접 조작',derivation:'유도 단계 동기화',structure:'구조 해설',none:'시각화 없음'};
const modeLabel=modeLabels[lesson.mode]||'수식별 학습';
---
<section class="formula-lesson mt-6 overflow-hidden rounded-2xl border border-violet-500/30 bg-violet-500/[0.055]" data-formula-lesson data-lesson-formula-id={lesson.formulaId} data-lesson-id={lessonId} data-lesson-focus={focus} data-lesson-renderer={renderer} data-lesson-mounted="false">
  <header class="border-b border-violet-500/20 px-4 py-4 sm:px-5">
    <div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><p class="m-0 text-[0.68rem] font-black uppercase tracking-[0.14em] text-violet-700 dark:text-violet-300">Formula-specific lesson</p><h5 class="mb-0 mt-1 text-base font-black text-foreground">{spec.title}</h5><p class="mb-0 mt-1 text-sm leading-6 text-muted-foreground">{spec.description}</p></div><span class="rounded-full border border-violet-500/25 bg-background px-3 py-1 text-xs font-black text-violet-700 dark:text-violet-300">{modeLabel}</span></div>
  </header>
  <div class="min-h-80 px-3 py-4 sm:px-5" data-formula-lesson-stage aria-live="polite"><div class="grid min-h-72 place-items-center rounded-xl border border-dashed border-violet-500/25 bg-background/70 px-6 text-center text-sm leading-7 text-muted-foreground">현재 수식의 정확한 ID와 유도 단계에 맞춘 학습 장면을 불러오는 중입니다.</div></div>
  <script is:inline type="application/json" data-formula-lesson-payload set:html={payload}></script>
</section>
<script>import '@/scripts/formula-lesson-runtime.js';</script>
