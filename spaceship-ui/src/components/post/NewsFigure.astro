---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import catalogue from '../../../site/news-media.json';
import englishCaptions from '../../../site/news-media-en.json';

interface Props {
  media: keyof typeof catalogue;
  priority?: boolean;
  compact?: boolean;
  thumbnail?: boolean;
  lang?: 'ko' | 'en';
}
const { media, priority = false, compact = false, thumbnail = false, lang = 'ko' } = Astro.props;
const source = catalogue[media];
if (!source) throw new Error(`Unknown NEWS media: ${media}`);
const captions = lang === 'en' ? (englishCaptions as Record<string, Partial<typeof source>>)[media] : undefined;
if (lang === 'en' && !captions) throw new Error(`Missing English caption: ${media}`);
const item = { ...source, ...captions };
// Only archive thumbnails use derivatives. A compact article figure still
// retains the registered original bytes, panels, dimensions and credits.
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../../site/assets/assets/posts/**/*.{png,jpg,jpeg,webp}'
);
const loadImage = thumbnail ? localImages[`../../../site/assets${item.src}`] : undefined;
const original = loadImage ? (await loadImage()).default : undefined;
const preview = original ? await getImage({
  src: original, width: Math.min(640, original.width), format: 'webp', quality: 85,
}) : undefined;
---

<figure class:list={['news-figure', compact && 'news-figure--compact']} data-news-figure={media}
  data-preview-src={preview?.src} data-preview-width={preview?.attributes.width}
  data-preview-height={preview?.attributes.height}>
  <a class="news-figure__image" href={item.src} target="_blank" rel="noopener noreferrer" aria-label={`${item.alt} — ${lang === "en" ? "Open full image" : "원본 크게 보기"}`}>
    <img
      src={preview?.src ?? item.src}
      data-original-src={item.src}
      alt={item.alt}
      width={item.width}
      height={item.height}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
      referrerpolicy="no-referrer"
    />
  </a>
  <figcaption>
    <strong>{item.kind}</strong>
    {!compact && <span class="news-figure__caption">{item.caption}</span>}
    <span class="news-figure__credit">
      {item.credit} · <a href={item.source} target="_blank" rel="noopener noreferrer">{lang === "en" ? "Source" : "출처"}</a> ·
      <a href={item.rights} target="_blank" rel="noopener noreferrer">{item.license}</a>
      {!compact && <> · {item.changes}</>}
    </span>
  </figcaption>
</figure>

<style>
  .news-figure { display: block; width: 100%; max-width: 100%; margin: 2rem 0; }
  .news-figure__image { display: block; overflow: hidden; border: 1px solid var(--color-border); border-radius: 0.65rem; background: #fff; }
  .news-figure img { display: block; width: 100%; max-width: 100%; height: auto; max-height: 38rem; object-fit: contain; margin: 0; }
  .news-figure figcaption { margin-top: 0.8rem; font-size: 0.8rem; line-height: 1.7; color: var(--color-muted-foreground); overflow-wrap: anywhere; }
  .news-figure figcaption strong { color: var(--color-foreground); }
  .news-figure__caption, .news-figure__credit { display: block; margin-top: 0.25rem; }
  .news-figure__credit a { text-decoration: underline; text-underline-offset: 0.15em; }
  .news-figure--compact { margin: 0; }
  .news-figure--compact img { height: 12rem; object-fit: contain; }
  .news-figure--compact figcaption { font-size: 0.7rem; }
</style>
