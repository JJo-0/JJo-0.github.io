---
import type { CollectionEntry } from 'astro:content';
import roadmap from '@/data/ai-benchmark-series.json';
import { getPostSlug } from '@/lib/utils/posts';
import { englishSwitchPath } from '@/lib/locales';

interface Props {
  en?: boolean;
  posts: CollectionEntry<'posts'>[];
  currentPostId: string;
}
const { en = false, posts, currentPostId } = Astro.props;
const published = new Map(posts.map(post => [post.data.series?.order, post]));
const currentOrder = posts.find(post => post.id === currentPostId)?.data.series?.order;
const total = roadmap.parts.reduce((sum, part) => sum + part.entries.length, 0);
const link = (slug: string) => en ? englishSwitchPath(`/posts/${slug}/`) : `/posts/${slug}/`;
---
<section class="series-map mt-8 mb-12 overflow-hidden rounded-2xl border border-border/80 bg-card/60 shadow-sm" aria-labelledby="ai-benchmark-map-heading" data-ai-benchmark-map>
  <div class="border-b border-border/70 bg-muted/35 px-5 py-5 sm:px-6">
    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted-foreground">{en ? 'Series map' : '연재 학습 지도'}</p>
    <h2 id="ai-benchmark-map-heading" class="text-xl font-black tracking-tight text-foreground sm:text-2xl">{en ? roadmap.englishTitle : roadmap.title}</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">{en ? `${published.size} of ${total} chapters published · Six parts` : `전체 ${total}편 중 ${published.size}편 공개 · 6개 파트`}</p>
    <progress class="mt-3 h-2 w-full accent-primary" value={published.size} max={total} aria-label={en ? 'Publication progress' : '연재 진행률'} />
  </div>
  <div class="space-y-2 p-4 sm:p-5">
    {roadmap.parts.map(part => (
      <details class="rounded-xl border border-border bg-background/70" open={part.entries.some(entry => entry.order === currentOrder)}>
        <summary class="cursor-pointer px-4 py-3 text-sm font-bold leading-6 text-foreground">
          Part {part.roman}. {en ? part.englishTitle : part.title}
          <span class="ml-2 text-xs font-medium text-muted-foreground">{part.entries.filter(entry => published.has(entry.order)).length}/{part.entries.length}</span>
        </summary>
        <ol class="space-y-2 border-t border-border/70 px-4 py-3">
          {part.entries.map(entry => {
            const post = published.get(entry.order);
            const current = entry.order === currentOrder;
            const title = en ? entry.englishTitle : entry.title;
            return (
              <li class="flex items-start gap-3 text-sm leading-6" data-ai-benchmark-order={entry.order}>
                <span class="w-7 shrink-0 font-mono text-xs leading-6 text-muted-foreground">{String(entry.order).padStart(2, '0')}</span>
                {current ? <span class="font-bold text-foreground" aria-current="page">{title}</span> : post ? <a class="text-foreground underline decoration-primary/40 underline-offset-4 hover:text-primary" href={link(getPostSlug(post))}>{title}</a> : <span class="text-muted-foreground">{title} <span class="text-xs">· {en ? 'Planned' : '예정'}</span></span>}
              </li>
            );
          })}
        </ol>
      </details>
    ))}
  </div>
</section>
