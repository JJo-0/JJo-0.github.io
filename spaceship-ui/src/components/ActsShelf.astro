---
import WritingListItem from '@/components/WritingListItem.astro';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { getReadTime } from '@/lib/utils/readTime';
import series from '@/data/acts-series.json';
import ezekielReport1 from '@/data/ezekiel-reports/report-1.html?raw';
import ezekielReport2 from '@/data/ezekiel-reports/report-2.html?raw';
import ezekielReport3 from '@/data/ezekiel-reports/report-3.html?raw';
import actsReport1 from '@/data/acts-reports/report-1.html?raw';
import actsReport2 from '@/data/acts-reports/report-2.html?raw';
import actsReport3 from '@/data/acts-reports/report-3.html?raw';
const actsTexts = [actsReport1, actsReport2, actsReport3];
const ezekielTexts = [ezekielReport1, ezekielReport2, ezekielReport3];
const allPosts = (await getPublishedPosts()).filter((post) => post.data.category === 'biblical-studies');
const groups = [
  { id: 'overview', title: '먼저 · 사도행전 전체 읽기', description: '책의 큰 구조, 역사 자료, 여러 해석 관점을 먼저 살펴봅니다.', entryGroups: ['overview'] },
  { id: 'acts-1-1-14', title: '사도행전 1장 1–14절', description: '1:1–5의 서문과 1:6–14의 회복·승천·기도 공동체를 각각 세 관점으로 읽습니다.', entryGroups: ['exegesis', 'exegesis-1-6-14'] },
];
const entries = series.entries.map((entry) => ({ ...entry, post: allPosts.find((post) => getPostSlug(post) === entry.slug) }));
const actsPassagePosts = allPosts.filter((post) => post.data.series?.id === 'acts-pentecost-study').sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));
const ezekielPosts = allPosts.filter((post) => post.data.series?.id === 'ezekiel-study').sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));
const otherPosts = allPosts.filter((post) => post.data.series?.id !== 'ezekiel-study' && post.data.series?.id !== 'acts-pentecost-study' && !series.entries.some((entry) => entry.slug === getPostSlug(post))).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<div data-acts-shelf class="acts-shelf">
  {groups.map((group) => <section class="acts-shelf__group" data-acts-group={group.id}>
    <header class="acts-shelf__header"><h3>{group.title}</h3><p>{group.description}</p></header>
    {entries.filter((entry) => group.entryGroups.includes(entry.group) && entry.post).map((entry) => entry.post && <div data-acts-card={entry.slug} data-acts-order={entry.order}>
      <WritingListItem post={entry.post} slug={entry.slug} readTime={getReadTime(entry.post.body || '')} />
    </div>)}
  </section>)}
  <aside class="acts-shelf__header" data-bible-coverage-gap aria-label="본문 연구 범위 안내"><h3>아직 자료가 없는 구간</h3><p>사도행전 1:15–26과 2:1–13의 본문 연구는 아직 제공되지 않았습니다. 공개된 연구는 범위별 자료이며, 모든 절을 연속해서 해설하는 주석은 아닙니다.</p></aside>
  {actsPassagePosts.length > 0 && <section class="acts-shelf__group" data-bible-group="acts-2-14-37"><header class="acts-shelf__header"><h3>사도행전 2장 14–37절</h3><p>베드로의 오순절 설교를 원어·문학·사회과학의 세 관점에서 읽는 전체 연구입니다. 앞서 안내한 자료 공백 다음의 독립된 본문 범위입니다.</p></header>{actsPassagePosts.map((post) => <WritingListItem {post} slug={getPostSlug(post)} readTime={getReadTime(actsTexts[(post.data.series?.order || 1) - 1])} />)}</section>}
  {ezekielPosts.length > 0 && <section class="acts-shelf__group" data-bible-group="ezekiel-2-1-3-11"><header class="acts-shelf__header"><h3>에스겔 2장 1절–3장 11절</h3><p>예언자 소명과 두루마리 섭취를 원어·문학·사회과학의 세 관점에서 읽는 전체 연구입니다.</p></header>{ezekielPosts.map((post) => <WritingListItem {post} slug={getPostSlug(post)} readTime={getReadTime(ezekielTexts[(post.data.series?.order || 1) - 1])} />)}</section>}
  {otherPosts.length > 0 && <section class="acts-shelf__group"><header class="acts-shelf__header"><h3>다른 성경 연구</h3></header>{otherPosts.map((post) => <WritingListItem {post} slug={getPostSlug(post)} readTime={getReadTime(post.body || '')} />)}</section>}
</div>
<style>
  .acts-shelf { min-width: 0; }
  .acts-shelf__group { margin: 2rem 0 3rem; }
  .acts-shelf__header { border-left: 3px solid var(--color-primary); padding: .35rem 0 .35rem 1rem; margin-bottom: 1rem; }
  .acts-shelf__header h3 { margin: 0; font-family: var(--font-editorial); font-size: clamp(1.2rem, 2vw, 1.6rem); color: var(--color-foreground); line-height: 1.4; }
  .acts-shelf__header p { margin: .5rem 0 0; font-size: .9rem; line-height: 1.7; color: var(--color-muted-foreground); }
</style>
