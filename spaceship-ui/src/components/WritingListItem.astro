---
import { englishPostPathForSlug } from '@/lib/locales';
import { formatDate } from '@/lib/utils/date';
import { getPostCategoryMeta, getPostTypeLabel } from '@/lib/taxonomy.mjs';

interface Props {
  post: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
      publicationTimeZone?: 'UTC' | 'Asia/Seoul';
      category: string;
      subcategory: string;
      type: string;
      tags: string[];
      lang?: string;
    };
  };
  slug: string;
  readTime: string;
  en?: boolean;
}

const { post, slug, readTime, en = false } = Astro.props;
const href = en ? englishPostPathForSlug(slug) : `/posts/${slug}`;
const linkSlug = en ? href.split('/').filter(Boolean).at(-1) : slug;
const category = getPostCategoryMeta(post.data.category, en);
// Root-scoped selectors avoid repeating an Astro scope attribute on every card node.
---

<article class="writing-list-item">
  <a
    href={href}
    data-english-card={en ? linkSlug : undefined}
    class="writing-item-link"
    data-post-transition-slug={linkSlug}
  >
      <div class="writing-item-heading">
        <h3
          class="writing-item-title"
          data-post-transition-title
        >
          {post.data.title}
        </h3>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="writing-item-date"
        >
          {formatDate(post.data.pubDate, post.data.publicationTimeZone)}
        </time>
      </div>

      <p class="writing-item-description">
        {post.data.description}
      </p>

      <div
        class="writing-item-meta"
      >
        <span>{category.shortLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{getPostTypeLabel(post.data.type)}</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.subcategory}</span>
        <span aria-hidden="true">·</span>
        <span>{readTime}</span>
      </div>

      <div
        class="writing-item-tags"
      >
        {post.data.tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
        {
          post.data.lang && post.data.lang !== 'en' && (
            <span class="writing-item-language">{post.data.lang}</span>
          )
        }
      </div>
  </a>
</article>

<style is:global>
  /* Reuse styles instead of repeating utility strings on every SSR card. */
  .writing-list-item { border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent); padding-block: 1.25rem; }
  .writing-list-item:first-child { padding-top: 0; }
  .writing-list-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .writing-list-item .writing-item-link { display: flex; flex-direction: column; gap: .5rem; border-radius: .75rem; margin-inline: -.75rem; padding: .5rem .75rem; text-decoration: none; }
  .writing-list-item .writing-item-link:hover { background: color-mix(in srgb, var(--color-accent) 70%, transparent); }
  .writing-list-item .writing-item-link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .writing-list-item:hover .writing-item-title { color: var(--color-primary); }
  .writing-list-item .writing-item-language { font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .writing-list-item .writing-item-heading { display: flex; flex-direction: column; gap: .25rem; }
  @media (min-width: 40rem) {
    .writing-list-item .writing-item-heading { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 1.25rem; }
  }
  .writing-list-item .writing-item-description {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-muted-foreground);
    max-width: 48rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .writing-list-item .writing-item-date {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .writing-list-item .writing-item-meta, .writing-list-item .writing-item-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.25rem;
    font-size: 11px;
    color: var(--color-muted-foreground);
  }
  .writing-list-item .writing-item-meta { column-gap: 0.625rem; font-weight: 700; }
  .writing-list-item .writing-item-meta > span:is(:first-child, :nth-child(3), :last-child) {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .writing-list-item .writing-item-tags { column-gap: 0.75rem; font-weight: 500; }
  .writing-list-item .writing-item-title {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    color: var(--color-foreground);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  @media (min-width: 40rem) { .writing-list-item .writing-item-title { font-size: 1.25rem; } }
</style>
