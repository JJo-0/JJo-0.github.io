---
import { formatDate } from '@/lib/utils/date';
import {
  getPostCategoryMeta,
  getPostTypeLabel,
} from '@/lib/taxonomy.mjs';

interface Props {
  post: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      subcategory: string;
      type: string;
      tags: string[];
      lang?: string;
    };
  };
  slug: string;
  readTime: string;
}

const { post, slug, readTime } = Astro.props;
const category = getPostCategoryMeta(post.data.category);
---

<article class="group border-b border-border/70 py-5 first:pt-0 last:border-b-0 last:pb-0">
  <a
    href={`/posts/${slug}`}
    class="block rounded-xl -mx-3 px-3 py-2 no-underline hover:bg-accent/70"
    data-post-transition-slug={slug}
  >
    <div class="flex flex-col gap-2">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-5">
        <h3
          class="text-base sm:text-lg font-black tracking-tight text-foreground group-hover:text-primary"
          data-post-transition-title
        >
          {post.data.title}
        </h3>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="shrink-0 text-[11px] font-bold uppercase tracking-widest text-muted-foreground tabular-nums"
        >
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <p class="text-sm leading-relaxed text-muted-foreground line-clamp-2 max-w-3xl">
        {post.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[11px] font-bold text-muted-foreground">
        <span class="uppercase tracking-wider">{category.shortLabel}</span>
        <span aria-hidden="true">·</span>
        <span class="uppercase tracking-wider">{getPostTypeLabel(post.data.type)}</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.subcategory}</span>
        <span aria-hidden="true">·</span>
        <span class="uppercase tracking-wider">{readTime}</span>
      </div>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-medium text-muted-foreground">
        {
          post.data.tags.slice(0, 4).map((tag) => (
            <span>#{tag}</span>
          ))
        }
        {post.data.lang && post.data.lang !== 'en' && (
          <span class="font-bold uppercase tracking-wider">{post.data.lang}</span>
        )}
      </div>
    </div>
  </a>
</article>
