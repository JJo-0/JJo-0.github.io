---
import { formatDate } from '@/lib/utils/date';

interface Props {
  post: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      lang?: string;
    };
  };
  slug: string;
  readTime: string;
}

const { post, slug, readTime } = Astro.props;
---

<article class="group border-b border-border/70 py-5 first:pt-0 last:border-b-0 last:pb-0">
  <a href={`/posts/${slug}`} class="block rounded-xl -mx-3 px-3 py-2 no-underline hover:bg-accent/70">
    <div class="flex flex-col gap-2">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-5">
        <h3 class="text-base sm:text-lg font-black tracking-tight text-foreground group-hover:text-primary">
          {post.data.title}
        </h3>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="shrink-0 text-[11px] font-bold uppercase tracking-widest text-muted-foreground tabular-nums"
        >
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <p class="text-sm leading-relaxed text-muted-foreground line-clamp-2 max-w-3xl">
        {post.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
        <span>{readTime}</span>
        {
          post.data.tags.slice(0, 3).map((tag) => (
            <span class="normal-case tracking-normal">#{tag}</span>
          ))
        }
        {post.data.lang && post.data.lang !== 'en' && <span>{post.data.lang}</span>}
      </div>
    </div>
  </a>
</article>
