---
import { formatDate } from '@/lib/utils/date';
import { getPostCategoryMeta, getPostTypeLabel } from '@/lib/taxonomy.mjs';

interface Props {
  post: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
      publicationTimeZone?: 'UTC' | 'Asia/Seoul';
      category: string;
      subcategory: string;
      type: string;
      tags: string[];
      lang?: string;
    };
  };
  slug: string;
  readTime: string;
}

const { post, slug, readTime } = Astro.props;
const category = getPostCategoryMeta(post.data.category);
---

<article class="group border-b border-border/70 py-5 first:pt-0 last:border-b-0 last:pb-0">
  <a
    href={`/posts/${slug}`}
    class="block rounded-xl -mx-3 px-3 py-2 no-underline hover:bg-accent/70"
    data-post-transition-slug={slug}
  >
    <div class="flex flex-col gap-2">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-5">
        <h3
          class="writing-item-title text-lg sm:text-xl text-foreground group-hover:text-primary"
          data-post-transition-title
        >
          {post.data.title}
        </h3>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="writing-item-date"
        >
          {formatDate(post.data.pubDate, post.data.publicationTimeZone)}
        </time>
      </div>

      <p class="writing-item-description">
        {post.data.description}
      </p>

      <div
        class="writing-item-meta"
      >
        <span>{category.shortLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{getPostTypeLabel(post.data.type)}</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.subcategory}</span>
        <span aria-hidden="true">·</span>
        <span>{readTime}</span>
      </div>

      <div
        class="writing-item-tags"
      >
        {post.data.tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
        {
          post.data.lang && post.data.lang !== 'en' && (
            <span class="font-bold uppercase tracking-wider">{post.data.lang}</span>
          )
        }
      </div>
    </div>
  </a>
</article>

<style>
  .writing-item-description {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-muted-foreground);
    max-width: 48rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .writing-item-date {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .writing-item-meta, .writing-item-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.25rem;
    font-size: 11px;
    color: var(--color-muted-foreground);
  }
  .writing-item-meta { column-gap: 0.625rem; font-weight: 700; }
  .writing-item-meta > span:is(:first-child, :nth-child(3), :last-child) {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .writing-item-tags { column-gap: 0.75rem; font-weight: 500; }
  .writing-item-title {
    font-family: var(--font-editorial);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
</style>
