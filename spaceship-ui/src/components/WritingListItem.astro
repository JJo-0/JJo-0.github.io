---
import { formatDate } from '@/lib/utils/date';
import {
  getPostCategoryMeta,
  getPostTypeLabel,
} from '@/lib/taxonomy.mjs';

interface Props {
  post: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      subcategory: string;
      type: string;
      tags: string[];
      lang?: string;
    };
  };
  slug: string;
  readTime: string;
}

const { post, slug, readTime } = Astro.props;
const category = getPostCategoryMeta(post.data.category);
---

<article class="writing-list-item group">
  <a
    href={`/posts/${slug}`}
    class="block no-underline"
    data-post-transition-slug={slug}
  >
    <div class="flex flex-col gap-2.5">
      <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
        <h3
          class="text-base sm:text-lg tracking-tight text-foreground"
          data-post-transition-title
        >
          {post.data.title}
        </h3>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="shrink-0 text-[10px] font-bold uppercase tracking-[0.13em] text-muted-foreground tabular-nums"
        >
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <p class="max-w-3xl text-sm leading-[1.75] text-muted-foreground line-clamp-2">
        {post.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[10px] font-bold text-muted-foreground">
        <span class="uppercase tracking-[0.12em]">{category.shortLabel}</span>
        <span aria-hidden="true">·</span>
        <span class="uppercase tracking-[0.12em]">{getPostTypeLabel(post.data.type)}</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.subcategory}</span>
        <span aria-hidden="true">·</span>
        <span class="uppercase tracking-[0.12em]">{readTime}</span>
      </div>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] font-medium text-muted-foreground/80">
        {
          post.data.tags.slice(0, 4).map((tag) => (
            <span>#{tag}</span>
          ))
        }
        {post.data.lang && post.data.lang !== 'en' && (
          <span class="font-bold uppercase tracking-wider">{post.data.lang}</span>
        )}
      </div>
    </div>
  </a>
</article>
