---
import '@/styles/global.css';
import { SITE } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchModal from '@/components/SearchModal.svelte';
import { ClientRouter } from 'astro:transitions';
import JsonLd from '@/components/JsonLd.astro';
import AdSense from '@/components/AdSense.astro';
import { getWebSiteSchema, getOrganizationSchema, getPersonSchema } from '@/lib/schemas';

import outfitFont400 from '@fontsource/outfit/files/outfit-latin-400-normal.woff2?url';
import outfitFont700 from '@fontsource/outfit/files/outfit-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  lang?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  usesChart?: boolean;
  showAds?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  lang,
  schema,
  noindex = false,
  usesChart = false,
  showAds = false,
} = Astro.props;
const pageLang = lang || SITE.lang;
const pageTitle = title ? `${title} | ${SITE.author}` : SITE.seoTitle;
const pageDescription = description || SITE.desc;
const pageOgImage = new URL(ogImage || SITE.ogImage, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const sectionIsPrivate =
  (!SITE.publicSections.projects && Astro.url.pathname.startsWith('/projects')) ||
  (!SITE.publicSections.appearances && Astro.url.pathname.startsWith('/appearances'));
const shouldNoIndex = noindex || sectionIsPrivate;

const defaultSchemas = [
  getWebSiteSchema(canonicalUrl.toString()),
  getOrganizationSchema(),
  getPersonSchema(),
];

const finalSchema = schema
  ? Array.isArray(schema)
    ? [...defaultSchemas, ...schema]
    : [...defaultSchemas, schema]
  : defaultSchemas;

const analyticsId = SITE.googleAnalyticsId;
const isGTM = analyticsId?.startsWith('GTM-');
const adsenseConfig = SITE.adsense;
const adsenseEnabled =
  showAds &&
  adsenseConfig?.mode === 'manual' &&
  /^ca-pub-\d{16}$/.test(adsenseConfig.clientId) &&
  /^\d+$/.test(adsenseConfig.adSlot);
const adsenseClientId = adsenseEnabled && adsenseConfig ? adsenseConfig.clientId : '';
const adsenseSlot = adsenseEnabled && adsenseConfig ? adsenseConfig.adSlot : '';

const gtmScript = `
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','${analyticsId}');
`;

const gaScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${analyticsId}');
`;
---

<html lang={pageLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={outfitFont400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={outfitFont700} as="font" type="font/woff2" crossorigin="anonymous" />

    {analyticsId && <link rel="preconnect" href="https://www.googletagmanager.com" />}
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    {adsenseClientId && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}
    {adsenseClientId && <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />}
    {usesChart && <link rel="preconnect" href="https://cdn.jsdelivr.net" />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    {SITE.naverSiteVerification && (
      <meta name="naver-site-verification" content={SITE.naverSiteVerification} />
    )}
    {SITE.bingSiteVerification && (
      <meta name="msvalidate.01" content={SITE.bingSiteVerification} />
    )}

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={shouldNoIndex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#0a0a0c" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.seoTitle} RSS Feed`}
      href="/rss.xml"
    />

    <script is:inline>
      (function () {
        const getThemePreference = () => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return 'system';
        };

        const setDarkClass = () => {
          const checkDark = (theme) => {
            if (theme === 'system') {
              return window.matchMedia('(prefers-color-scheme: dark)').matches;
            }
            return theme === 'dark';
          };

          const isDark = checkDark(getThemePreference());
          const contains = document.documentElement.classList.contains('dark');
          if (isDark && !contains) {
            document.documentElement.classList.add('dark');
          } else if (!isDark && contains) {
            document.documentElement.classList.remove('dark');
          }
        };

        setDarkClass();
        document.addEventListener('astro:after-swap', setDarkClass);
      })();
    </script>

    {
      usesChart && (
        <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
      )
    }

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.seoTitle} />
    <meta property="og:locale" content={pageLang.replace('-', '_')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageOgImage} />

    {
      analyticsId &&
        !isGTM && (
          <script
            is:inline
            async
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}
          />
        )
    }

    {
      analyticsId && (
        <script type="text/partytown" is:inline set:html={isGTM ? gtmScript : gaScript} />
      )
    }

    {
      adsenseClientId && (
        <>
          <meta name="google-adsense-account" content={adsenseClientId} />
          <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
            crossorigin="anonymous"
          />
        </>
      )
    }

    <JsonLd schema={finalSchema} />

    <ClientRouter fallback="swap" />
    <base href={SITE.base} />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:text-foreground focus:shadow-lg"
    >
      본문으로 건너뛰기
    </a>
    {
      isGTM && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${analyticsId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <div class="max-w-5xl 3xl:max-w-7xl mx-auto container-padding">
      <Header />
      <main id="main-content" class="py-12 sm:py-16 lg:py-24" tabindex="-1">
        <slot />
      </main>
      {adsenseEnabled && <AdSense clientId={adsenseClientId} adSlot={adsenseSlot} />}
      <Footer />
      <SearchModal client:idle />
    </div>
  </body>
</html>
