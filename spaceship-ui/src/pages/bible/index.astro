---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import ActsShelf from '@/components/ActsShelf.astro';
import { getPublishedPosts } from '@/lib/utils/posts';
import { getBreadcrumbSchema } from '@/lib/schemas';
const count = (await getPublishedPosts()).filter((post) => post.data.category === 'biblical-studies' && !post.data.tags.includes('frontier-one')).length;
const schema = getBreadcrumbSchema([
  { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
  { name: '성경', url: new URL('/bible', Astro.site).toString() },
]);
---
<Layout title="성경 · Biblical Studies" description="사도행전 전체 개관 세 편을 먼저 읽고, 1장 1–5절의 원어·문학·성령론 연구 세 편으로 이어지는 개인 성경 연구 아카이브입니다." {schema} lang="ko-KR" adsEnabled={false}>
  <Breadcrumbs items={[{ name: 'Writing', href: '/posts' }, { name: '성경', href: '/bible' }]} />
  <header class="mb-10 max-w-4xl border-t border-border pt-10 sm:pt-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">성경</p>
    <h1 class="bible-title text-4xl font-bold text-foreground sm:text-6xl">성경 · Biblical Studies</h1>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground sm:text-lg">성경 본문 주해, 문학·역사적 맥락과 신학적 쟁점을 탐구하는 개인 연구 기록입니다.{' '}<a class="inline-block whitespace-nowrap font-bold underline underline-offset-4" href="/notices/2026-09-11-biblical-studies-and-policies" aria-label="성경 공지: 저작권·면책·자료 이용 원칙">[공지]</a></p>
  </header>
  <section aria-labelledby="bible-posts-heading" class="mt-10">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-border pb-4"><h2 id="bible-posts-heading" class="text-2xl font-bold">공개된 연구 글</h2><span class="text-sm tabular-nums text-muted-foreground">{count}편</span></div>
    <ActsShelf />
  </section>
  <p class="mt-8 text-sm"><a href="/posts#biblical-studies" class="underline underline-offset-4">Writing의 성경 섹션으로 돌아가기</a></p>
</Layout>
<style>
  .bible-title { font-family: var(--font-editorial); line-height: 1.15; overflow-wrap: anywhere; }
</style>
