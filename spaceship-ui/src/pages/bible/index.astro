---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import WritingListItem from '@/components/WritingListItem.astro';
import ContentNotice from '@/components/ContentNotice.astro';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { getReadTime } from '@/lib/utils/readTime';
import { getBreadcrumbSchema } from '@/lib/schemas';

const posts = (await getPublishedPosts())
  .filter((post) => post.data.category === 'biblical-studies' && !post.data.tags.includes('frontier-one'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const schema = getBreadcrumbSchema([
  { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
  { name: '성경', url: new URL('/bible', Astro.site).toString() },
]);
---

<Layout title="성경 · Biblical Studies" description="성경 본문 주해 및 신학적 고찰을 위한 개인 연구 아카이브입니다. 프로젝트의 신학적 입장, 연구·인용 원칙과 공개된 글을 확인할 수 있습니다." {schema} lang="ko-KR" adsEnabled={false}>
  <Breadcrumbs items={[{ name: 'Writing', href: '/posts' }, { name: '성경', href: '/bible' }]} />
  <header class="mb-10 max-w-4xl border-t border-border pt-10 sm:pt-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Biblical Studies</p>
    <h1 class="bible-title text-4xl font-bold text-foreground sm:text-6xl">성경 본문 주해 및 신학적 고찰</h1>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground sm:text-lg">본문을 자세히 읽고, 해석의 근거를 확인하며, 신학적 질문을 기록합니다. 개인 연구와 교회·교단의 공식 입장을 구별하는 아카이브입니다.</p>
    <a class="mt-5 inline-block text-sm font-semibold underline underline-offset-4" href="/notices/2026-09-11-biblical-studies-and-policies">[공지] 성경 연구 아카이브 개설 및 콘텐츠 운영 원칙 선언</a>
  </header>

  <ContentNotice category="biblical-studies" />

  <section class="my-10 grid gap-4 sm:grid-cols-3" aria-label="연구 분야">
    <div class="rounded-xl border border-border bg-card/40 p-5">
      <h2 class="text-base font-bold">본문·원어·역사적 맥락</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">사용한 판본, 구문과 어휘의 의미, 본문비평 자료와 역사적 배경을 구별하여 읽습니다.</p>
    </div>
    <div class="rounded-xl border border-border bg-card/40 p-5">
      <h2 class="text-base font-bold">문학·수사학적 읽기</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">단락의 경계, 서사 구조, 반복과 대조, 책 전체에서 본문이 맡는 역할을 살펴봅니다.</p>
    </div>
    <div class="rounded-xl border border-border bg-card/40 p-5">
      <h2 class="text-base font-bold">신학적 고찰·수용사</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">정경적 연결과 여러 전통의 해석을 검토하며, 출처의 주장과 저자의 평가를 구분합니다.</p>
    </div>
  </section>

  <section aria-labelledby="bible-posts-heading" class="mt-12">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-border pb-4">
      <h2 id="bible-posts-heading" class="text-2xl font-bold">공개된 연구 글</h2>
      <span class="text-sm tabular-nums text-muted-foreground">{posts.length}편</span>
    </div>
    {
      posts.length > 0 ? posts.map((post) => (
        <WritingListItem {post} slug={getPostSlug(post)} readTime={getReadTime(post.body || '')} />
      )) : (
        <div class="rounded-xl border border-border bg-secondary/20 p-6 text-sm leading-relaxed text-muted-foreground">
          <p>현재 공개된 본문 연구 글은 없습니다. 먼저 프로젝트의 입장과 자료 이용 원칙을 안내합니다.</p>
          <a href="/bible/reading-guide" class="mt-3 inline-block font-semibold underline underline-offset-4">성경 글을 읽기 전에: 프로젝트 안내</a>
        </div>
      )
    }
  </section>
  <p class="mt-8 text-sm"><a href="/posts#biblical-studies">Writing의 성경 섹션으로 돌아가기</a></p>
</Layout>

<style>
  .bible-title {
    font-family: var(--font-editorial);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
</style>
