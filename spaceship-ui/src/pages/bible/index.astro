---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import ActsShelf from '@/components/ActsShelf.astro';
import { getPublishedPosts } from '@/lib/utils/posts';
import { getBreadcrumbSchema } from '@/lib/schemas';
const en = Astro.url.pathname.startsWith('/en/');
const path = (route: string) => en ? `/en${route}/` : route;
const title = en ? 'Biblical Studies' : '성경 · Biblical Studies';
const description = en ? 'Read the research by passage and explore the accompanying interactive studies and original Naver articles.' : '성경 본문 범위별 Naver 원문과 확보된 대화형 연구 자료를 연결합니다. 자료가 없는 구간도 함께 안내합니다.';
const count = (await getPublishedPosts()).filter((post) => post.data.category === 'biblical-studies' && !post.data.tags.includes('frontier-one')).length;
const schema = getBreadcrumbSchema([
  { name: 'Writing', url: new URL(path('/posts'), Astro.site).toString() },
  { name: en ? 'Biblical Studies' : '성경', url: new URL(path('/bible'), Astro.site).toString() },
]);
---
<Layout {title} {description} {schema} lang={en ? 'en' : 'ko-KR'} adsEnabled={false}>
  <Breadcrumbs homeHref={en ? '/en/' : '/'} items={[{ name: 'Writing', href: path('/posts') }, { name: en ? 'Biblical Studies' : '성경', href: path('/bible') }]} />
  <header class="mb-10 max-w-4xl border-t border-border pt-10 sm:pt-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">{en ? 'Scripture' : '성경'}</p>
    <h1 class="bible-title text-4xl font-bold text-foreground sm:text-6xl">{title}</h1>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground sm:text-lg">{en ? 'Personal studies in biblical exegesis, literary and historical context, and theological interpretation.' : '성경 본문 주해, 문학·역사적 맥락과 신학적 쟁점을 탐구하는 개인 연구 기록입니다.'}{' '}<a class="inline-block whitespace-nowrap font-bold underline underline-offset-4" href={path('/notices/2026-09-11-biblical-studies-and-policies')} aria-label={en ? 'Editorial notice and terms of use' : '성경 공지: 저작권·면책·자료 이용 원칙'}>{en ? '[Notice]' : '[공지]'}</a></p>
  </header>
  <section aria-labelledby="bible-posts-heading" class="mt-10">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-border pb-4"><h2 id="bible-posts-heading" class="text-2xl font-bold">{en ? 'Studies by passage' : '범위별 연구와 자료'}</h2><span class="text-sm tabular-nums text-muted-foreground">{count}{en ? ' articles' : '편'}</span></div>
    <ActsShelf {en} />
  </section>
  <p class="mt-8 text-sm"><a href={path('/posts') + '#biblical-studies'} class="underline underline-offset-4">{en ? 'Back to Biblical Studies in Writing' : 'Writing의 성경 섹션으로 돌아가기'}</a></p>
</Layout>
<style>
  .bible-title { font-family: var(--font-editorial); line-height: 1.15; overflow-wrap: anywhere; }
</style>
