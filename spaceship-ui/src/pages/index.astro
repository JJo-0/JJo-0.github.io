---
import ReadingAudio from '@/components/experience/ReadingAudio.astro';
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.svelte';
import PopularPosts from '@/components/PopularPosts.astro';
import MotionRuntime from '@/components/experience/MotionRuntime.astro';
import ExperienceCanvas from '@/components/experience/ExperienceCanvas.astro';
import '@/styles/world.css';
import { getReadTime } from '@/lib/utils/readTime';
import { getPostSlug } from '@/lib/utils/posts';
import { getLocalizedPosts } from '@/lib/localized-posts';
import { englishPostPathForSlug } from '@/lib/locales';
import { RESEARCH_FOCUS as koreanFocus } from '@/lib/research';
import { RESEARCH_FOCUS as englishFocus } from '@/lib/research-en';
import { POST_CATEGORIES } from '@/lib/taxonomy.mjs';
import { SITE } from '@/config';
import { getWritingGraph } from '@/lib/experience/writing-graph';

interface Props { en?: boolean }
const { en = false } = Astro.props;
const researchPath = en ? '/en/research/' : '/research';
const archivePath = en ? '/en/posts/' : '/posts';
const focusAreas = en ? englishFocus : koreanFocus;
const posts = (await getLocalizedPosts(en)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = posts.filter((post) => post.data.featured).slice(0, SITE.featuredPostsCount);
const latestPosts = posts.filter((post) => !post.data.featured).slice(0, SITE.latestPostsCount);
const postCategoryHashes = JSON.stringify(POST_CATEGORIES);
const postGraph = await getWritingGraph(en);
---

<Layout
  lang={en ? 'en' : undefined}
  description={en ? 'Robotics, AI, vision, and research engineering by Jiho Park.' : undefined}
  markdownAlternate={en ? undefined : '/index.md'}
  adsEnabled={!en}
>
  <div
    class="experience-page"
    data-experience-page="home"
    data-post-category-hashes={postCategoryHashes}
  >
    <MotionRuntime scope="home" />

    <div class="experience-world-shell" data-world-shell>
      <div class="experience-world-copy">
        <section class="experience-world-identity" aria-labelledby="home-identity">
          <p class="experience-kicker" data-motion="hero-kicker">01 / Park JiHo</p>

          <h1 id="home-identity" class="experience-display" aria-label="Park JiHo">
            <span class="experience-word-mask">
              <span class="experience-word" data-motion="hero-word">Park</span>
            </span>
            <span class="experience-word-mask">
              <span class="experience-word" data-motion="hero-word">JiHo</span>
            </span>
          </h1>

          <p class="experience-role" data-motion="hero-copy">Robotics × AI × Vision</p>
          <p class="experience-statement" data-motion="hero-copy">
            I build intelligent robotic systems that perceive, reason, and act around people.
          </p>
          <p class="experience-subcopy" data-motion="hero-copy">
            {en
              ? 'I connect perception, system integration, and learning for robots that work with people. This blog records the systems I build, the experiments I run, and what I learn.'
              : `사람과 함께 일하는 로봇을 위해 perception, system integration, learning을 연결하고 구현과 실험으로 검증합니다. ${SITE.homeHeroDescription}`}
          </p>

          <div class="experience-actions" data-motion="hero-copy">
            <a href={researchPath} class="experience-button experience-button--primary">
              Explore Research
              <span aria-hidden="true">↗</span>
            </a>
            <a href={archivePath} class="experience-button experience-button--secondary">
              Writing Archive
            </a>
          </div>

          <div class="experience-socials" data-motion="hero-copy" aria-label="Profile links">
            {
              Object.entries(SITE.social).map(([platform, link]) => (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${SITE.author}'s ${platform} profile`}
                >
                  {platform}
                </a>
              ))
            }
          </div>
        </section>

        <section
          class="experience-current-inline"
          data-stagger
          aria-labelledby="current-affiliations-heading"
        >
          <h2 id="current-affiliations-heading" class="sr-only">Current research affiliations</h2>
          <div class="experience-card experience-current-card" data-stagger-item>
            <span>M.S. Student</span>
            <strong>{en ? 'Sungkyunkwan University' : '성균관대학교'} · Control and Robotics Lab</strong>
          </div>
          <div class="experience-card experience-current-card" data-stagger-item>
            <span>Researcher</span>
            <strong>{en ? 'Korea Institute of Industrial Technology' : '한국생산기술연구원'}</strong>
          </div>
        </section>

        <section class="experience-journey" aria-labelledby="journey-heading" data-world-journey>
          <header class="experience-journey__intro" data-reveal>
            <p class="experience-section-label">Research Index</p>
            <h2 id="journey-heading">One practice.<br />Four lines of inquiry.</h2>
            <p class="experience-subcopy">
              {en
                ? 'Scroll through the four research areas to explore the map and the articles connected to each one.'
                : '아래로 이동하면 연구 지도가 각 연구축에 맞춰 갱신됩니다. 장식이 아니라 공개 연구 분류와 실제 Writing을 연결하는 탐색 도구입니다.'}
            </p>
          </header>

          {
            focusAreas.map((focus, index) => (
              <article
                id={`journey-${focus.id}`}
                class="experience-chapter scroll-mt-28"
                data-world-chapter={focus.id}
                data-research-section={focus.id}
                aria-labelledby={`home-${focus.id}-heading`}
              >
                <span class="experience-chapter__number">
                  {String(index + 1).padStart(2, '0')} / {focus.label}
                </span>
                <h3 id={`home-${focus.id}-heading`}>{focus.title}</h3>
                <p>{focus.description}</p>
                <a class="experience-chapter__link" href={`${researchPath}#${focus.id}`}>
                  Open research line <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </section>
      </div>

      <aside class="experience-world-stage-column" aria-label="Interactive research map">
        <div class="writing-atlas-stage">
        <figure
          id="writing-atlas"
          class="experience-visual-stage experience-world-stage"
          data-motion="hero-visual"
          data-world-stage
        >
          <ExperienceCanvas variant="home" graph={postGraph} />
          <span class="world-axis world-axis--x" aria-hidden="true"></span>
          <span class="world-axis world-axis--y" aria-hidden="true"></span>

          <div class="world-hud world-hud--top" aria-hidden="true">
            <span class="world-hud__eyebrow">Writing Atlas</span>
            <span class="world-hud__metric">
              {en
                ? `${postGraph.nodes.length} articles · ${postGraph.edges.length} links`
                : `글 ${postGraph.nodes.length}편 · 연결 ${postGraph.edges.length}개`}
            </span>
          </div>

          <nav class="sr-only" aria-label="Research map sections">
            {
              focusAreas.map((focus, index) => (
                <button
                  type="button"
                  class="world-hud__node"
                  data-constellation-node={focus.id}
                  data-world-target={`journey-${focus.id}`}
                  aria-label={`Focus ${focus.title}`}
                >
                  {String(index + 1).padStart(2, '0')} · {focus.label}
                </button>
              ))
            }
          </nav>

          <div class="experience-mouse-frame experience-mouse-frame--world">
            <button type="button" class="experience-profile-button" data-profile-animation
              data-profile-animation-src="/assets/profile/mouse_surprised-once.webp"
              aria-label={en ? 'Play profile animation' : '프로필 애니메이션 재생'}>
              <img
                src="/assets/profile/mouse_surprised-still.webp"
                alt={en ? 'Profile character' : '프로필 캐릭터'}
                width="256"
                height="256"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </button>
          </div>

          <figcaption class="sr-only">
            Interactive research map synchronized with the four public research lines.
          </figcaption>
        </figure>
        <ReadingAudio {en} atlas />
        </div>
      </aside>
    </div>

    {
      featuredPosts.length > 0 && (
        <section class="experience-section" aria-labelledby="featured-heading" data-reveal>
          <div class="experience-section-header">
            <h2 id="featured-heading" class="experience-section-label">
              Selected Writing
            </h2>
            <span aria-hidden="true" />
            <a href={archivePath} class="experience-section-link">
              All Writing ↗
            </a>
          </div>

          <div class="experience-writing-list" data-stagger>
            {featuredPosts.map((post) => (
              <div class="experience-writing-item" data-stagger-item>
                <PostCard {post} slug={getPostSlug(post)} href={en ? englishPostPathForSlug(getPostSlug(post)) : undefined} readTime={getReadTime(post.body || '')} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <PopularPosts {en} {posts} />

    <section class="experience-section" aria-labelledby="latest-heading" data-reveal>
      <div class="experience-section-header">
        <h2 id="latest-heading" class="experience-section-label">Latest Writing</h2>
        <span aria-hidden="true"></span>
        <a href={archivePath} class="experience-section-link">Archive ↗</a>
      </div>

      <div class="experience-writing-list" data-stagger>
        {
          latestPosts.map((post) => (
            <div class="experience-writing-item" data-stagger-item>
              <PostCard {post} slug={getPostSlug(post)} href={en ? englishPostPathForSlug(getPostSlug(post)) : undefined} readTime={getReadTime(post.body || '')} />
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <script>
    import { installProfileAnimation } from '@/lib/experience/profile-animation';
    installProfileAnimation();

    const decodeCategoryHash = () => {
      try {
        return decodeURIComponent(window.location.hash.slice(1));
      } catch {
        return null;
      }
    };

    const readPostCategories = (root: HTMLElement) => {
      try {
        const value = JSON.parse(root.dataset.postCategoryHashes || '[]');
        return Array.isArray(value)
          ? value.filter((item): item is string => typeof item === 'string')
          : [];
      } catch {
        return [];
      }
    };

    const redirectLegacyCategoryHash = () => {
      const englishHome = /^\/en\/?$/.test(window.location.pathname);
      if ((window.location.pathname !== '/' && !englishHome) || !window.location.hash) return;

      const root = document.querySelector('[data-post-category-hashes]');
      if (!(root instanceof HTMLElement)) return;

      const category = decodeCategoryHash();
      if (!category) return;

      const categories = readPostCategories(root);
      if (!categories.includes(category)) return;

      if (englishHome) window.location.replace(`/en/posts/#${category}`);
      else window.location.replace(`/posts#${category}`);
    };

    redirectLegacyCategoryHash();
    window.addEventListener('hashchange', redirectLegacyCategoryHash);
    document.addEventListener('astro:page-load', redirectLegacyCategoryHash);
  </script>
</Layout>
