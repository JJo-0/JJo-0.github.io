---
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.svelte';
import MotionRuntime from '@/components/experience/MotionRuntime.astro';
import ExperienceCanvas from '@/components/experience/ExperienceCanvas.astro';
import '@/styles/world.css';
import { getReadTime } from '@/lib/utils/readTime';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { RESEARCH_FOCUS } from '@/lib/research';
import { SITE } from '@/config';

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPosts = posts.filter((post) => post.data.featured).slice(0, SITE.featuredPostsCount);
const latestPosts = posts.filter((post) => !post.data.featured).slice(0, SITE.latestPostsCount);
---

<Layout>
  <div class="experience-page" data-experience-page="home">
    <MotionRuntime scope="home" />

    <div class="experience-world-shell" data-world-shell>
      <div class="experience-world-copy">
        <section class="experience-world-identity" aria-labelledby="home-identity">
          <p class="experience-kicker" data-motion="hero-kicker">01 / Park JiHo</p>

          <h1 id="home-identity" class="experience-display" aria-label="Park JiHo">
            <span class="experience-word-mask">
              <span class="experience-word" data-motion="hero-word">Park</span>
            </span>
            <span class="experience-word-mask">
              <span class="experience-word" data-motion="hero-word">JiHo</span>
            </span>
          </h1>

          <p class="experience-role" data-motion="hero-copy">Robotics × AI × Vision</p>
          <p class="experience-statement" data-motion="hero-copy">
            I build intelligent robotic systems that perceive, reason, and act around people.
          </p>
          <p class="experience-subcopy" data-motion="hero-copy">
            사람과 함께 일하는 로봇을 위해 perception, system integration, learning을 연결하고
            구현과 실험으로 검증합니다. {SITE.homeHeroDescription}
          </p>

          <div class="experience-actions" data-motion="hero-copy">
            <a href="/research" class="experience-button experience-button--primary">
              Enter Research World
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/posts" class="experience-button experience-button--secondary">
              Writing Archive
            </a>
          </div>

          <div class="experience-socials" data-motion="hero-copy" aria-label="Profile links">
            {
              Object.entries(SITE.social).map(([platform, link]) => (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${SITE.author}'s ${platform} profile`}
                >
                  {platform}
                </a>
              ))
            }
          </div>
        </section>

        <div class="experience-current-inline" data-stagger aria-label="Current affiliations">
          <div class="experience-card experience-current-card" data-stagger-item>
            <span>M.S. Student</span>
            <strong>성균관대학교 · Control and Robotics Lab</strong>
          </div>
          <div class="experience-card experience-current-card" data-stagger-item>
            <span>Researcher</span>
            <strong>한국생산기술연구원</strong>
          </div>
        </div>

        <section class="experience-journey" aria-labelledby="journey-heading" data-world-journey>
          <header class="experience-journey__intro" data-reveal>
            <p class="experience-section-label">Research Journey</p>
            <h2 id="journey-heading">One system.<br />Four research axes.</h2>
            <p class="experience-subcopy">
              아래로 이동할수록 같은 spatial world가 연구축을 따라 focus를 바꿉니다. 장식용
              3D가 아니라 공개 연구 분류와 실제 Writing을 연결하는 navigation model입니다.
            </p>
          </header>

          {
            RESEARCH_FOCUS.map((focus, index) => (
              <article
                class="experience-chapter"
                data-world-chapter={focus.id}
                data-research-section={focus.id}
                aria-labelledby={`home-${focus.id}-heading`}
              >
                <span class="experience-chapter__number">
                  {String(index + 1).padStart(2, '0')} / {focus.label}
                </span>
                <h3 id={`home-${focus.id}-heading`}>{focus.title}</h3>
                <p>{focus.description}</p>
                <a class="experience-chapter__link" href={`/research#${focus.id}`}>
                  Open research axis <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </section>
      </div>

      <aside class="experience-world-stage-column" aria-label="Interactive research world">
        <figure class="experience-world-stage" data-motion="hero-visual" data-world-stage>
          <ExperienceCanvas variant="home" />
          <span class="world-axis world-axis--x" aria-hidden="true"></span>
          <span class="world-axis world-axis--y" aria-hidden="true"></span>

          <div class="world-hud world-hud--top" aria-hidden="true">
            <span class="world-hud__eyebrow">JJO / Experience Engine</span>
            <span class="world-hud__metric">Adaptive GPU · SVG Safe</span>
          </div>

          <div class="world-hud world-hud--nodes" aria-hidden="true">
            {
              RESEARCH_FOCUS.map((focus, index) => (
                <span class="world-hud__node" data-constellation-node={focus.id}>
                  {String(index + 1).padStart(2, '0')} · {focus.label}
                </span>
              ))
            }
          </div>

          <div class="experience-mouse-frame experience-mouse-frame--world">
            <img
              src="/image/mouse_surprised.gif"
              alt={`${SITE.author} profile animation`}
              width="416"
              height="416"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <figcaption class="sr-only">
            Interactive research constellation synchronized with the four public research axes.
          </figcaption>
        </figure>
      </aside>
    </div>

    {
      featuredPosts.length > 0 && (
        <section class="experience-section" aria-labelledby="featured-heading" data-reveal>
          <div class="experience-section-header">
            <h2 id="featured-heading" class="experience-section-label">Selected Writing</h2>
            <span aria-hidden="true"></span>
            <a href="/posts" class="experience-section-link">All Writing ↗</a>
          </div>

          <div class="experience-writing-list" data-stagger>
            {featuredPosts.map((post) => (
              <div class="experience-writing-item" data-stagger-item>
                <PostCard
                  {post}
                  slug={getPostSlug(post)}
                  readTime={getReadTime(post.body || '')}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="experience-section" aria-labelledby="latest-heading" data-reveal>
      <div class="experience-section-header">
        <h2 id="latest-heading" class="experience-section-label">Latest Writing</h2>
        <span aria-hidden="true"></span>
        <a href="/posts" class="experience-section-link">Archive ↗</a>
      </div>

      <div class="experience-writing-list" data-stagger>
        {
          latestPosts.map((post) => (
            <div class="experience-writing-item" data-stagger-item>
              <PostCard
                {post}
                slug={getPostSlug(post)}
                readTime={getReadTime(post.body || '')}
              />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
