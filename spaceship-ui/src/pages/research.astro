---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import { RESEARCH_FOCUS } from '@/lib/research';
import { formatDate } from '@/lib/utils/date';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { getBreadcrumbSchema } from '@/lib/schemas';

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const focusWithPosts = RESEARCH_FOCUS.map((focus) => ({
  ...focus,
  posts: posts
    .filter((post) => post.data.tags.some((tag) => focus.tags.includes(tag)))
    .slice(0, 4),
}));

const schema = getBreadcrumbSchema([
  { name: 'Research', url: new URL('/research', Astro.site).toString() },
]);
---

<Layout
  title="Research"
  description="Park JiHo의 로보틱스, AI, 컴퓨터 비전 연구·엔지니어링 주제와 공개 기술 기록을 정리합니다."
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Research', href: '/research' }]} />

  <header class="max-w-3xl mb-14 sm:mb-18">
    <p class="text-xs font-black uppercase tracking-[0.24em] text-muted-foreground mb-4">
      Research & Engineering
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground leading-[1.03]">
      문제를 이해하고,<br class="hidden sm:block" /> 구현과 실험으로 확인합니다.
    </h1>
    <p class="mt-6 text-base sm:text-lg leading-relaxed text-muted-foreground max-w-2xl">
      로보틱스·AI·컴퓨터 비전에서 공부하고 실험한 내용을 공개 가능한 기술 글과 연구 노트로 연결합니다.
      저장소 목록보다 문제, 방법, 그리고 검증 과정이 보이도록 정리합니다.
    </p>
  </header>

  <div class="grid gap-6 lg:gap-8">
    {
      focusWithPosts.map((focus, index) => (
        <section
          id={focus.id}
          aria-labelledby={`${focus.id}-heading`}
          class="scroll-mt-28 rounded-2xl border border-border bg-card p-5 sm:p-7 lg:p-8"
        >
          <div class="grid lg:grid-cols-[0.85fr_1.4fr] gap-7 lg:gap-12">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-black tabular-nums text-muted-foreground">0{index + 1}</span>
                <span class="text-xs font-black uppercase tracking-[0.2em] text-muted-foreground">
                  {focus.label}
                </span>
              </div>
              <h2
                id={`${focus.id}-heading`}
                class="text-2xl sm:text-3xl font-black tracking-tight text-foreground"
              >
                {focus.title}
              </h2>
              <p class="mt-4 text-sm sm:text-base leading-relaxed text-muted-foreground">
                {focus.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-2">
                {focus.tags.slice(0, 5).map((tag) => (
                  <a
                    href={`/posts/tag/${tag}`}
                    class="rounded-full border border-border px-2.5 py-1 text-[11px] font-bold text-muted-foreground hover:bg-accent hover:text-foreground no-underline"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>

            <div>
              <p class="text-xs font-black uppercase tracking-[0.2em] text-muted-foreground mb-3">
                Selected public notes
              </p>
              <div class="divide-y divide-border">
                {focus.posts.length > 0 ? (
                  focus.posts.map((post) => (
                    <a
                      href={`/posts/${getPostSlug(post)}`}
                      class="group block py-4 first:pt-1 last:pb-1 no-underline"
                    >
                      <div class="flex items-start justify-between gap-5">
                        <div class="min-w-0">
                          <h3 class="font-black tracking-tight text-foreground group-hover:text-primary">
                            {post.data.title}
                          </h3>
                          <p class="mt-1 text-sm leading-relaxed text-muted-foreground line-clamp-2">
                            {post.data.description}
                          </p>
                        </div>
                        <time
                          datetime={post.data.pubDate.toISOString()}
                          class="shrink-0 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-muted-foreground tabular-nums"
                        >
                          {formatDate(post.data.pubDate)}
                        </time>
                      </div>
                    </a>
                  ))
                ) : (
                  <p class="py-4 text-sm text-muted-foreground">관련 공개 기록을 정리하고 있습니다.</p>
                )}
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="mt-16 sm:mt-20 border-t border-border pt-10 sm:pt-12">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5">
      <div class="max-w-2xl">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-muted-foreground mb-3">
          Research notes
        </p>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
          더 많은 구현·리서치 기록은 Writing에 있습니다.
        </h2>
        <p class="mt-3 text-sm sm:text-base text-muted-foreground leading-relaxed">
          주제별 태그와 연도별 아카이브에서 실험, 공부, 구현 과정을 이어서 볼 수 있습니다.
        </p>
      </div>
      <a
        href="/posts"
        class="inline-flex w-fit items-center rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground hover:opacity-90 no-underline"
      >
        Browse Writing
      </a>
    </div>
  </section>
</Layout>
