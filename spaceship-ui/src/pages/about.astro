---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import { render, getEntry } from 'astro:content';
import { getBreadcrumbSchema } from '@/lib/schemas';

const schema = getBreadcrumbSchema([
  { name: 'About', url: new URL('/about', Astro.site).toString() },
]);
import { Image } from 'astro:assets';
import profilePhoto from '@/site-assets/about_photo.jpg';

const socialIcons = {
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  website:
    '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
};

function getSocialIcon(name: string): string {
  const lowercaseName = name.toLowerCase();
  return socialIcons[lowercaseName as keyof typeof socialIcons] || socialIcons.website;
}

const aboutPost = await getEntry('about', 'index');
const { Content } = aboutPost ? await render(aboutPost) : { Content: null };
const aboutTitle = aboutPost?.data.title || `안녕하세요, ${SITE.author}입니다.`;
---

<Layout
  title="About"
  description={`${SITE.author} — AI, 로보틱스, 컴퓨터 비전과 자동화 시스템을 연구하고 기록합니다.`}
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'About', href: '/about' }]} />

  <div data-about-page class="about-page flex flex-col lg:flex-row gap-10 lg:gap-16">
    <aside class="flex-shrink-0 lg:w-72 space-y-8">
      <div class="w-full aspect-square">
        <Image
          src={profilePhoto}
          alt={`${SITE.author} profile photo`}
          width={400}
          height={400}
          widths={[200, 400, 800]}
          sizes="(max-width: 1024px) 100vw, 256px"
          class="about-portrait w-full h-full object-cover border border-border"
        />
      </div>

      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3">
          Connect
        </h2>
        <div class="space-y-1">
          {
            Object.entries(SITE.social).map(([name, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${SITE.author}'s ${name} page`}
                class="flex items-center gap-2.5 border-b border-border/70 px-0 py-3 group no-underline"
              >
                <div class="h-8 w-8 border border-border flex items-center justify-center text-muted-foreground group-hover:border-primary group-hover:text-primary transition-all flex-shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={getSocialIcon(name)}
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-sm text-foreground capitalize leading-tight">
                    {name}
                  </div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-muted-foreground group-hover:text-primary transition-colors flex-shrink-0"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </aside>

    <div class="flex-1 min-w-0">
      <h1
        data-about-title
        class="about-page-title text-4xl sm:text-5xl lg:text-6xl text-foreground leading-[1.03] mb-8"
      >
        {aboutTitle}
      </h1>
      <article data-about-content class="about-page-content prose max-w-none text-muted-foreground">
        {Content ? <Content /> : <p>Loading content...</p>}
      </article>
    </div>
  </div>
</Layout>

<style is:global>
  .about-page {
    border-top: 1px solid var(--color-border);
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .about-page-title {
    max-width: 46rem;
    font-family: var(--font-editorial);
    font-weight: 700;
    letter-spacing: -0.055em;
    text-wrap: balance;
    word-break: keep-all;
  }

  .about-page-content {
    max-width: 48rem;
    font-family: var(--font-reading);
    font-synthesis: none;
    line-height: 1.88;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .about-page-content :where(h2, h3, h4) {
    font-family: var(--font-editorial);
    letter-spacing: -0.025em;
  }

  .about-page-content :where(code, pre, kbd, samp) {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New',
      monospace;
  }

  .about-portrait {
    filter: saturate(0.82) contrast(0.98);
    box-shadow: 0.75rem 0.75rem 0 var(--color-secondary);
  }
</style>
