---
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/EnglishPostCard.astro';
import MotionRuntime from '@/components/experience/MotionRuntime.astro';
import ExperienceCanvas from '@/components/experience/ExperienceCanvas.astro';
import '@/styles/world.css';
import { getReadTime } from '@/lib/utils/readTime';
import { getEnglishPosts as getPublishedPosts, englishSlug as getPostSlug } from '@/lib/english';
import { RESEARCH_FOCUS } from '@/lib/research-en';
import { POST_CATEGORIES } from '@/lib/taxonomy.mjs';
import { SITE } from '@/config';
import { buildPostGraph } from '@/lib/experience/post-graph';

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = posts.filter((post) => post.data.featured).slice(0, SITE.featuredPostsCount);
const latestPosts = posts.filter((post) => !post.data.featured).slice(0, SITE.latestPostsCount);
const postCategoryHashes = JSON.stringify(POST_CATEGORIES);
const postGraph = buildPostGraph(posts);
---

<Layout lang="en" description="Robotics, AI, vision, and research engineering by Jiho Park." adsEnabled={false}>
  <div
    class="experience-page"
    data-experience-page="home"
    data-post-category-hashes={postCategoryHashes}
  >
    <MotionRuntime scope="home" />

    <div class="experience-world-shell" data-world-shell>
      <div class="experience-world-copy">
        <section class="experience-world-identity" aria-labelledby="home-identity">
          <p class="experience-kicker" data-motion="hero-kicker">01 / Park JiHo</p>

          <h1 id="home-identity" class="experience-display" aria-label="Park JiHo">
            <span class="experience-word-mask">
              <span class="experience-word" data-motion="hero-word">Park</span>
            </span>
            <span class="experience-word-mask">
              <span class="experience-word" data-motion="hero-word">JiHo</span>
            </span>
          </h1>

          <p class="experience-role" data-motion="hero-copy">Robotics × AI × Vision</p>
          <p class="experience-statement" data-motion="hero-copy">
            I build intelligent robotic systems that perceive, reason, and act around people.
          </p>
          <p class="experience-subcopy" data-motion="hero-copy">
            I connect perception, system integration, and learning for robots that work with people,
            and validate those connections through implementation and experiments.
          </p>

          <div class="experience-actions" data-motion="hero-copy">
            <a href="/en/research/" class="experience-button experience-button--primary">
              Explore Research
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/en/posts/" class="experience-button experience-button--secondary">
              Writing Archive
            </a>
          </div>

          <div class="experience-socials" data-motion="hero-copy" aria-label="Profile links">
            {
              Object.entries(SITE.social).map(([platform, link]) => (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${SITE.author}'s ${platform} profile`}
                >
                  {platform}
                </a>
              ))
            }
          </div>
        </section>

        <section
          class="experience-current-inline"
          data-stagger
          aria-labelledby="current-affiliations-heading"
        >
          <h2 id="current-affiliations-heading" class="sr-only">Current research affiliations</h2>
          <div class="experience-card experience-current-card" data-stagger-item>
            <span>M.S. Student</span>
            <strong>Sungkyunkwan University · Control and Robotics Lab</strong>
          </div>
          <div class="experience-card experience-current-card" data-stagger-item>
            <span>Researcher</span>
            <strong>Korea Institute of Industrial Technology</strong>
          </div>
        </section>

        <section class="experience-journey" aria-labelledby="journey-heading" data-world-journey>
          <header class="experience-journey__intro" data-reveal>
            <p class="experience-section-label">Research Index</p>
            <h2 id="journey-heading">One practice.<br />Four lines of inquiry.</h2>
            <p class="experience-subcopy">
              As you scroll, the research map follows each line of inquiry. It connects public
              research categories with the writing available in this English edition.
            </p>
          </header>

          {
            RESEARCH_FOCUS.map((focus, index) => (
              <article
                id={`journey-${focus.id}`}
                class="experience-chapter scroll-mt-28"
                data-world-chapter={focus.id}
                data-research-section={focus.id}
                aria-labelledby={`home-${focus.id}-heading`}
              >
                <span class="experience-chapter__number">
                  {String(index + 1).padStart(2, '0')} / {focus.label}
                </span>
                <h3 id={`home-${focus.id}-heading`}>{focus.title}</h3>
                <p>{focus.description}</p>
                <a class="experience-chapter__link" href={`/en/research/#${focus.id}`}>
                  Open research line <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </section>
      </div>

      <aside class="experience-world-stage-column" aria-label="Interactive research map">
        <figure
          class="experience-visual-stage experience-world-stage"
          data-motion="hero-visual"
          data-world-stage
        >
          <ExperienceCanvas variant="home" graph={postGraph} />
          <span class="world-axis world-axis--x" aria-hidden="true"></span>
          <span class="world-axis world-axis--y" aria-hidden="true"></span>

          <div class="world-hud world-hud--top" aria-hidden="true">
            <span class="world-hud__eyebrow">JJO / Writing Atlas</span>
            <span class="world-hud__metric">{postGraph.nodes.length} Articles · Live Relations</span
            >
          </div>

          <nav class="sr-only" aria-label="Research map sections">
            {
              RESEARCH_FOCUS.map((focus, index) => (
                <button
                  type="button"
                  class="world-hud__node"
                  data-constellation-node={focus.id}
                  data-world-target={`journey-${focus.id}`}
                  aria-label={`Focus ${focus.title}`}
                >
                  {String(index + 1).padStart(2, '0')} · {focus.label}
                </button>
              ))
            }
          </nav>


          <figcaption class="sr-only">
            Interactive research map synchronized with the four public research lines.
          </figcaption>
        </figure>
      </aside>
    </div>

    {
      featuredPosts.length > 0 && (
        <section class="experience-section" aria-labelledby="featured-heading" data-reveal>
          <div class="experience-section-header">
            <h2 id="featured-heading" class="experience-section-label">
              Selected Writing
            </h2>
            <span aria-hidden="true" />
            <a href="/en/posts/" class="experience-section-link">
              All Writing ↗
            </a>
          </div>

          <div class="experience-writing-list" data-stagger>
            {featuredPosts.map((post) => (
              <div class="experience-writing-item" data-stagger-item>
                <PostCard {post} slug={getPostSlug(post)} readTime={getReadTime(post.body || '')} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <p class="mt-10 text-sm leading-relaxed">Full-article translations are being added across the archive. <a href="/en/translations/">See translation coverage</a>; untranslated articles remain available in Korean.</p>
    <section class="experience-section" aria-labelledby="latest-heading" data-reveal>
      <div class="experience-section-header">
        <h2 id="latest-heading" class="experience-section-label">Latest English Research</h2>
        <span aria-hidden="true"></span>
        <a href="/en/news/" class="experience-section-link">English NEWS ↗</a>
      </div>

      <div class="experience-writing-list" data-stagger>
        {
          latestPosts.map((post) => (
            <div class="experience-writing-item" data-stagger-item>
              <PostCard {post} slug={getPostSlug(post)} readTime={getReadTime(post.body || '')} />
            </div>
          ))
        }
      </div>
    </section>
  </div>

</Layout>
