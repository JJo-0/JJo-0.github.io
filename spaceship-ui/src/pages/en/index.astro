---
import Layout from '@/layouts/Layout.astro';
import EnglishPostList from '@/components/EnglishPostList.astro';
---
<Layout title="English edition" description="Research explainers in English: AI, robotics, energy, semiconductors and life sciences." lang="en" languageAlternates={{"ko-KR":"/",en:"/en/","x-default":"/"}} adsEnabled={false}>
  <section style="max-width:64rem"><header style="border-bottom:1px solid var(--color-border);padding-bottom:2rem;margin-bottom:1rem">
  <h1 style="font-family:var(--font-editorial);font-size:clamp(2.3rem,5vw,4rem);line-height:1.12">Research, explained.</h1>
  <p style="max-width:48rem;line-height:1.8;margin-top:1.1rem">Full English translations with the evidence, assumptions and limitations preserved. This edition is being expanded; the Korean archive contains additional articles.</p>
  <p><a href="/en/rss.xml">Subscribe to the English RSS feed</a> · <a href="/news" lang="ko">한국어 전체 기록</a></p>
  </header><EnglishPostList /></section>
</Layout>
