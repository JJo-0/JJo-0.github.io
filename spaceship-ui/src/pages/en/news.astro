---
import Layout from '@/layouts/Layout.astro';
import EnglishPostList from '@/components/EnglishPostList.astro';
---
<Layout title="Frontier One — English" description="Evidence-led English explanations of new research and industrial developments." lang="en" languageAlternates={{"ko-KR":"/news/",en:"/en/news/","x-default":"/news/"}} adsEnabled={false}>
  <section style="max-width:64rem"><header style="border-bottom:1px solid var(--color-border);padding-bottom:2rem;margin-bottom:1rem">
  <h1 style="font-family:var(--font-editorial);font-size:clamp(2.3rem,5vw,4rem);line-height:1.12">Frontier One</h1>
  <p style="max-width:48rem;line-height:1.8;margin-top:1.1rem">New research and industrial developments, explained from first principles. Dates refer to the original Korean editions; English updates are identified within the articles.</p>
  <p><a href="/en/rss.xml">Subscribe to the English RSS feed</a> · <a href="/news" lang="ko">한국어 전체 기록</a></p>
  </header><EnglishPostList /></section>
</Layout>
