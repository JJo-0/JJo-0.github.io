---
import Article from '@/pages/posts/[...slug]/index.astro';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { getTranslationsBySource, getEnglishCard } from '@/lib/localized-posts';

export async function getStaticPaths() {
  const [posts, translations] = await Promise.all([getPublishedPosts(), getTranslationsBySource()]);
  return posts.map(post => {
    const sourceSlug = getPostSlug(post);
    const translation = translations.get(sourceSlug);
    return {
      params: { slug: translation?.data.slug ?? sourceSlug },
      props: { post, translation, englishCard: getEnglishCard(post, translation) },
    };
  });
}
const { post, translation, englishCard } = Astro.props;
---
<Article {...post} {translation} {englishCard} />
