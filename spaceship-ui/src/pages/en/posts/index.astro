---
import Layout from '@/layouts/Layout.astro';
import EnglishPostList from '@/components/EnglishPostList.astro';
---
<Layout title="English articles" description="The complete set of currently available English-language research notes." lang="en" languageAlternates={{"ko-KR":"/posts/",en:"/en/posts/","x-default":"/posts/"}} adsEnabled={false}>
  <section style="max-width:64rem"><header style="border-bottom:1px solid var(--color-border);padding-bottom:2rem;margin-bottom:1rem">
  <h1 style="font-family:var(--font-editorial);font-size:clamp(2.3rem,5vw,4rem);line-height:1.12">English articles</h1>
  <p style="max-width:48rem;line-height:1.8;margin-top:1.1rem">Only articles with a real English text appear here. An English title or a translation button is not a substitute for a translated article.</p>
  <p><a href="/en/rss.xml">Subscribe to the English RSS feed</a> · <a href="/news" lang="ko">한국어 전체 기록</a></p>
  </header><EnglishPostList /></section>
</Layout>
