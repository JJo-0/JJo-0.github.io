---
import Layout from '@/layouts/Layout.astro';
import WritingListItem from '@/components/WritingListItem.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import { getReadTime } from '@/lib/utils/readTime';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import {
  POST_CATEGORIES,
  getPostCategoryMeta,
} from '@/lib/taxonomy.mjs';
import { SITE } from '@/config';
import { getBreadcrumbSchema } from '@/lib/schemas';

const schema = getBreadcrumbSchema([
  { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
]);

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type PublishedPost = (typeof posts)[number];

interface CategorySection {
  id: string;
  label: string;
  shortLabel: string;
  description: string;
  posts: PublishedPost[];
}

const categorySections: CategorySection[] = (POST_CATEGORIES as readonly string[])
  .map((category) => ({
    id: category,
    ...getPostCategoryMeta(category),
    posts: posts.filter((post) => post.data.category === category),
  }))
  .filter((section) => section.posts.length > 0);

const tagCounts = posts.reduce(
  (acc, post) => {
    post.data.tags.forEach((tag) => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
    return acc;
  },
  {} as Record<string, number>,
);

const sortedTags = Object.entries(tagCounts)
  .sort(([, countA], [, countB]) => countB - countA)
  .slice(0, 18);
---

<Layout title="Writing" description={SITE.blogDescription} schema={schema}>
  <Breadcrumbs items={[{ name: 'Writing', href: '/posts' }]} />

  <header class="mb-10 sm:mb-12 max-w-3xl">
    <p class="text-xs font-black uppercase tracking-[0.22em] text-muted-foreground mb-3">
      Notes & Essays
    </p>
    <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-foreground leading-[1.05]">
      Writing
    </h1>
    <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed">
      글의 대표 분야, 콘텐츠 형식, 세부 기술 태그를 분리했습니다. 먼저 대분류를 고른 뒤
      같은 분야의 학습·구현·연구 기록을 이어서 볼 수 있습니다.
    </p>
  </header>

  <nav
    aria-label="Writing categories"
    class="mb-12 grid gap-3 sm:grid-cols-2 xl:grid-cols-4"
  >
    {
      categorySections.map((section) => (
        <a
          href={`/posts#${section.id}`}
          aria-controls={section.id}
          data-astro-reload
          class="rounded-xl border border-border bg-card/50 p-4 no-underline transition hover:-translate-y-0.5 hover:border-foreground/20 hover:bg-accent/50"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-black text-foreground">{section.label}</p>
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                {section.description}
              </p>
            </div>
            <span class="shrink-0 text-xs font-black tabular-nums text-muted-foreground">
              {section.posts.length}
            </span>
          </div>
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col gap-10 lg:flex-row lg:gap-14">
    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-14">
        {
          categorySections.map((section) => (
            <section id={section.id} aria-labelledby={`${section.id}-heading`} class="scroll-mt-28">
              <div class="mb-6 border-b border-border/70 pb-5">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-[11px] font-black uppercase tracking-[0.22em] text-muted-foreground">
                      {section.shortLabel}
                    </p>
                    <h2
                      id={`${section.id}-heading`}
                      class="mt-2 text-2xl font-black tracking-tight text-foreground sm:text-3xl"
                    >
                      {section.label}
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                      {section.description}
                    </p>
                  </div>
                  <span class="shrink-0 text-xs font-black tabular-nums text-muted-foreground">
                    {section.posts.length}
                  </span>
                </div>
              </div>

              <div>
                {section.posts.map((post) => (
                  <WritingListItem
                    {post}
                    slug={getPostSlug(post)}
                    readTime={getReadTime(post.body || '')}
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <aside class="flex-shrink-0 lg:w-64" aria-label="Writing navigation">
      <div class="space-y-5 lg:sticky lg:top-28 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:overscroll-contain lg:scroll-py-2 lg:pr-1">
        <section class="rounded-xl border border-border/70 bg-secondary/30 p-5">
          <h2 class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
            Categories
          </h2>
          <nav class="flex flex-col gap-1.5" aria-label="Writing category shortcuts">
            {
              categorySections.map((section) => (
                <a
                  href={`/posts#${section.id}`}
                  aria-controls={section.id}
                  data-astro-reload
                  class="flex items-center justify-between gap-3 rounded-lg px-2.5 py-2 text-xs font-bold text-foreground no-underline hover:bg-accent"
                >
                  <span>{section.shortLabel}</span>
                  <span class="text-muted-foreground tabular-nums">{section.posts.length}</span>
                </a>
              ))
            }
          </nav>
        </section>

        <section class="rounded-xl border border-border/70 bg-secondary/30 p-5">
          <h2 class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
            Semantic Topics
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              sortedTags.map(([tag, count]) => (
                <a
                  href={`/posts/tag/${tag}`}
                  class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-medium no-underline hover:border-foreground/20 hover:bg-accent"
                >
                  <span class="text-foreground">{tag}</span>
                  <span class="text-muted-foreground">{count}</span>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </aside>
  </div>
</Layout>
