---
import Layout from '@/layouts/Layout.astro';
import WritingListItem from '@/components/WritingListItem.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import '@/styles/writing.css';
import { getReadTime } from '@/lib/utils/readTime';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import {
  POST_CATEGORIES,
  getPostCategoryMeta,
} from '@/lib/taxonomy.mjs';
import { SITE } from '@/config';
import { getBreadcrumbSchema } from '@/lib/schemas';

const schema = getBreadcrumbSchema([
  { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
]);

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type PublishedPost = (typeof posts)[number];

interface CategorySection {
  id: string;
  label: string;
  shortLabel: string;
  description: string;
  posts: PublishedPost[];
}

const categorySections: CategorySection[] = (POST_CATEGORIES as readonly string[])
  .map((category) => ({
    id: category,
    ...getPostCategoryMeta(category),
    posts: posts.filter((post) => post.data.category === category),
  }))
  .filter((section) => section.posts.length > 0);

const tagCounts = posts.reduce(
  (acc, post) => {
    post.data.tags.forEach((tag) => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
    return acc;
  },
  {} as Record<string, number>,
);

const sortedTags = Object.entries(tagCounts)
  .sort(([, countA], [, countB]) => countB - countA)
  .slice(0, 18);
---

<Layout title="Writing" description={SITE.blogDescription} schema={schema}>
  <div data-writing-index>
    <Breadcrumbs items={[{ name: 'Writing', href: '/posts' }]} />

    <header class="writing-index-header">
      <p class="writing-index-kicker">Notes · Essays · Research Records</p>
      <h1 class="writing-index-title">Writing</h1>
      <p class="writing-index-lead">
        연구, 구현, 학습을 오래 읽을 수 있는 형태로 정리합니다. 대분류로 방향을 잡고,
        세부 태그와 콘텐츠 형식으로 필요한 기록까지 좁혀갈 수 있습니다.
      </p>
    </header>

    <nav aria-label="Writing categories" class="writing-category-grid">
      {
        categorySections.map((section) => (
          <a
            href={`#${section.id}`}
            aria-controls={section.id}
            data-astro-reload
            class="writing-category-link"
          >
            <div class="writing-category-link__top">
              <span class="writing-category-link__title">{section.label}</span>
              <span class="writing-category-link__count">{section.posts.length}</span>
            </div>
            <p class="writing-category-link__description line-clamp-3">
              {section.description}
            </p>
          </a>
        ))
      }
    </nav>

    <div class="writing-index-layout">
      <div class="min-w-0">
        {
          categorySections.map((section) => (
            <section
              id={section.id}
              aria-labelledby={`${section.id}-heading`}
              class="writing-category-section"
            >
              <header class="writing-category-heading">
                <div>
                  <p class="writing-category-heading__eyebrow">{section.shortLabel}</p>
                  <h2 id={`${section.id}-heading`}>{section.label}</h2>
                  <p>{section.description}</p>
                </div>
                <span class="writing-category-heading__count">{section.posts.length} records</span>
              </header>

              <div>
                {section.posts.map((post) => (
                  <WritingListItem
                    {post}
                    slug={getPostSlug(post)}
                    readTime={getReadTime(post.body || '')}
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <aside class="writing-index-aside" aria-label="Writing navigation">
        <section>
          <h2>Categories</h2>
          <nav class="writing-index-shortcuts" aria-label="Writing category shortcuts">
            {
              categorySections.map((section) => (
                <a
                  href={`#${section.id}`}
                  aria-controls={section.id}
                  data-astro-reload
                >
                  <span>{section.shortLabel}</span>
                  <span class="text-muted-foreground tabular-nums">{section.posts.length}</span>
                </a>
              ))
            }
          </nav>
        </section>

        <section>
          <h2>Semantic Topics</h2>
          <div class="writing-topic-list">
            {
              sortedTags.map(([tag, count]) => (
                <a href={`/posts/tag/${tag}`}>
                  <span>{tag}</span>
                  <span class="ml-1 text-muted-foreground">{count}</span>
                </a>
              ))
            }
          </div>
        </section>
      </aside>
    </div>
  </div>
</Layout>
