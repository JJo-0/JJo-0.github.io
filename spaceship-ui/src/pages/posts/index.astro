---
import Layout from '@/layouts/Layout.astro';
import WritingListItem from '@/components/WritingListItem.astro';
import ContentNotice from '@/components/ContentNotice.astro';
import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import { getReadTime } from '@/lib/utils/readTime';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { POST_CATEGORIES, getPostCategoryMeta } from '@/lib/taxonomy.mjs';
import { SITE } from '@/config';
import { getBreadcrumbSchema } from '@/lib/schemas';

const schema = getBreadcrumbSchema([
  { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
]);

const posts = (await getPublishedPosts())
  .filter((post) => !post.data.tags.includes('frontier-one'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

type PublishedPost = (typeof posts)[number];

interface CategorySection {
  id: string;
  label: string;
  shortLabel: string;
  description: string;
  posts: PublishedPost[];
}

const categorySections: CategorySection[] = (POST_CATEGORIES as readonly string[])
  .map((category) => ({
    id: category,
    ...getPostCategoryMeta(category),
    posts: posts.filter((post) => post.data.category === category),
  }))
  .filter((section) => section.posts.length > 0 || section.id === 'biblical-studies');

const tagCounts = posts.reduce(
  (acc, post) => {
    post.data.tags.forEach((tag) => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
    return acc;
  },
  {} as Record<string, number>
);

const sortedTags = Object.entries(tagCounts)
  .sort(([, countA], [, countB]) => countB - countA)
  .slice(0, 18);
---

<Layout title="Writing" description={`${SITE.blogDescription} 성경 본문 주해와 신학적 고찰을 함께 기록합니다.`} schema={schema}>
  <Breadcrumbs items={[{ name: 'Writing', href: '/posts' }]} />

  <header class="writing-intro mb-12 sm:mb-16 max-w-4xl">
    <p class="text-xs font-black uppercase tracking-[0.22em] text-muted-foreground mb-3">
      Notes & Essays
    </p>
    <h1
      class="writing-intro__title text-5xl sm:text-6xl lg:text-7xl text-foreground leading-[0.96]"
    >
      Writing
    </h1>
    <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed">
      기술·연구·생활과 성경에 관한 개인의 학습 기록입니다. 먼저 분야를 고른 뒤 관련 글을
      이어서 볼 수 있습니다. 최신 연구·산업 트리거는 News의 Frontier One에서 별도로 정리합니다.
    </p>
    <aside aria-label="고정 공지" class="mt-6 rounded-xl border border-border bg-secondary/30 p-5">
      <p class="text-xs font-bold tracking-wide text-muted-foreground">공지 · 2026-09-11 작성</p>
      <a href="/notices/2026-09-11-biblical-studies-and-policies/" class="mt-2 block text-base font-bold text-foreground underline underline-offset-4">성경 연구 아카이브 개설 및 콘텐츠 운영 원칙 선언</a>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">개인 연구의 입장, 인용과 AI 활용, 저작권·면책 및 수정 원칙을 안내합니다.</p>
    </aside>
    <p class="mt-4 text-sm text-muted-foreground">
      <a href="/policies/" class="underline underline-offset-4">운영·AI 활용 원칙</a>
      {' · '}
      <a href="/policies/disclaimer/" class="underline underline-offset-4">콘텐츠 활용·면책 안내</a>
      {' · '}
      <a href="/policies/copyright/" class="underline underline-offset-4">저작권·재사용</a>
    </p>
  </header>

  <nav
    aria-label="Writing categories"
    class="writing-index mb-14 grid sm:grid-cols-2 xl:grid-cols-4"
  >
    {
      categorySections.map((section) => (
        <a
          href={`#${section.id}`}
          aria-controls={section.id}
          data-astro-reload
          class="writing-index__item border border-border bg-card/40 p-4 no-underline hover:border-primary"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-black text-foreground">{section.label}</p>
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                {section.description}
              </p>
            </div>
            <span class="shrink-0 text-xs font-black tabular-nums text-muted-foreground">
              {section.posts.length}
            </span>
          </div>
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col gap-10 lg:flex-row lg:gap-14">
    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-14">
        {
          categorySections.map((section) => (
            <section id={section.id}
              aria-labelledby={`${section.id}-heading`}
              class="writing-category-section scroll-mt-28"
            >
              <div class="mb-6 border-b border-border/70 pb-5">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-[11px] font-black uppercase tracking-[0.22em] text-muted-foreground">
                      {section.shortLabel}
                    </p>
                    <h2
                      id={`${section.id}-heading`}
                      class="mt-2 text-2xl font-black tracking-tight text-foreground sm:text-3xl"
                    >
                      {section.label}
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                      {section.description}
                    </p>
                  </div>
                  <span class="shrink-0 text-xs font-black tabular-nums text-muted-foreground">
                    {section.posts.length}
                  </span>
                </div>
              </div>

              {section.id === 'biblical-studies' && (
                <div class="mb-6">
                  <ContentNotice category="biblical-studies" />
                  <a href="/bible/" class="text-sm font-bold underline underline-offset-4">성경 아카이브 · 프로젝트 안내</a>
                  {section.posts.length === 0 && (
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">현재 공개된 본문 연구 글은 없습니다. 프로젝트 소개와 읽기 전 안내를 먼저 확인해 주세요.</p>
                  )}
                </div>
              )}

              <div>
                {section.posts.map((post) => (
                  <WritingListItem
                    {post}
                    slug={getPostSlug(post)}
                    readTime={getReadTime(post.body || '')}
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <aside class="flex-shrink-0 lg:w-64" aria-label="Writing navigation">
      <div class="space-y-5">
        <section class="rounded-xl border border-border/70 bg-secondary/30 p-5">
          <h2 class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
            Categories
          </h2>
          <nav class="flex flex-col gap-1.5" aria-label="Writing category shortcuts">
            {
              categorySections.map((section) => (
                <a
                  href={`#${section.id}`}
                  aria-controls={section.id}
                  data-astro-reload
                  class="flex items-center justify-between gap-3 rounded-lg px-2.5 py-2 text-xs font-bold text-foreground no-underline hover:bg-accent"
                >
                  <span>{section.shortLabel}</span>
                  <span class="text-muted-foreground tabular-nums">{section.posts.length}</span>
                </a>
              ))
            }
          </nav>
        </section>

        <section class="rounded-xl border border-border/70 bg-secondary/30 p-5">
          <h2 class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
            Semantic Topics
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              sortedTags.map(([tag, count]) => (
                <a
                  href={`/posts/tag/${tag}`}
                  class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-medium no-underline hover:border-foreground/20 hover:bg-accent"
                >
                  <span class="text-foreground">{tag}</span>
                  <span class="text-muted-foreground">{count}</span>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .writing-intro {
    border-top: 1px solid var(--color-border);
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .writing-intro__title {
    font-family: var(--font-editorial);
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .writing-index {
    gap: 0;
  }

  .writing-index__item {
    margin-right: -1px;
    margin-bottom: -1px;
  }
</style>
