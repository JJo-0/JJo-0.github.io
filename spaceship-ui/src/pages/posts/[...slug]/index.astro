---
import Layout from '@/layouts/Layout.astro';
import '@/styles/code-blocks.css';
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/utils/date';
import TableOfContents from '@/components/TableOfContents.svelte';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { resolveSeriesPostTitle } from '@/lib/modern-ai-series';

import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import SocialShare from '@/components/SocialShare.svelte';
import SeriesNavigation from '@/components/SeriesNavigation.astro';
import LanguageSelector from '@/components/LanguageSelector.svelte';
import CTABlock from '@/components/CTABlock.astro';
import Comments from '@/components/Comments.svelte';
import Part4ReviewCorrections from '@/components/post/Part4ReviewCorrections.astro';
import { getBlogPostingSchema, getBreadcrumbSchema } from '@/lib/schemas';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post: CollectionEntry<'posts'>) => ({
    params: { slug: getPostSlug(post) },
    props: post,
  }));
}

type Props = CollectionEntry<'posts'>;

const post = Astro.props as Props;
const { Content, headings } = await render(post);

const effectiveSlug = getPostSlug(post);
const canonicalPostUrl = new URL(Astro.url.pathname, Astro.site).toString();
const displayTitle = resolveSeriesPostTitle(post.data.title, post.data.series);
const postTransitionName = `post-title-${effectiveSlug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const isModernAiSeries = post.data.series?.id === 'modern-artificial-intelligence';
const isModernAiPart4 = isModernAiSeries && post.data.series?.order === 4;

const modernAiReaderDescriptions: Record<number, string> = {
  1: 'AI·ML·DL의 관계에서 선형대수, 확률, 최적화, 퍼셉트론과 컨볼루션까지 현대 인공지능의 수학적 기초를 한 흐름으로 정리한다.',
  2: '분류·회귀·밀도추정에서 일반화, 정규화, 교차검증, SVM, 최소거리·베이즈 분류기와 차원의 저주까지 머신러닝의 기본 과제를 정리한다.',
  3: '퍼셉트론 학습과 XOR에서 MLP, Dropout·DropConnect, CNN, 1D·2D 컨볼루션과 PyTorch 모듈까지 신경망의 핵심 구조를 연결한다.',
  4: 'Lipschitz 연속성에서 GD·PSD·PGD·FGM·OGM, 복소수 하강방향, 선탐색과 로지스틱 회귀까지 기울기 기반 최적화를 단계적으로 정리한다.',
  5: '2D convolution과 ImageNet에서 AlexNet·VGG·GoogLeNet·ResNet·WRN·DenseNet·SE Network를 거쳐 현대 이미지 분류의 발전 흐름을 정리한다.',
};
const seriesOrder = isModernAiSeries ? post.data.series?.order : undefined;
const effectiveDescription =
  typeof seriesOrder === 'number' && modernAiReaderDescriptions[seriesOrder]
    ? modernAiReaderDescriptions[seriesOrder]
    : post.data.description;

const schemas = [
  getBlogPostingSchema({
    title: displayTitle,
    description: effectiveDescription,
    pubDate: post.data.pubDate,
    url: canonicalPostUrl,
    lang: post.data.lang,
    image: new URL(`/og/${effectiveSlug}.png`, Astro.site).toString(),
    tags: post.data.tags,
  }),
  getBreadcrumbSchema([
    { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
    { name: displayTitle, url: canonicalPostUrl },
  ]),
];
---

<Layout
  title={displayTitle}
  description={effectiveDescription}
  lang={post.data.lang}
  ogImage={`/og/${effectiveSlug}.png`}
  ogType="article"
  schema={schemas}
  usesChart={post.data.usesChart}
>
  <Breadcrumbs
    items={[
      { name: 'Writing', href: '/posts' },
      { name: displayTitle, href: '#' },
    ]}
  />

  <div class="article-layout lg:flex lg:gap-12" data-post-page-slug={effectiveSlug}>
    <div class="flex-1 min-w-0">
      <div class="article-header mb-10">
        <header class="flex flex-col gap-4">
          <div
            class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted-foreground font-bold uppercase tracking-widest"
          >
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            {
              post.data.draft && (
                <>
                  <span class="hidden sm:inline text-border">•</span>
                  <div class="flex items-center gap-1.5 text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-900/30 px-2 py-1 rounded">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    Draft
                  </div>
                </>
              )
            }
            {
              post.data.tags && post.data.tags.length > 0 && (
                <>
                  <span class="hidden sm:inline text-border">•</span>
                  <div class="flex flex-wrap gap-2 text-xs uppercase font-bold tracking-widest text-muted-foreground/80">
                    {post.data.tags.map((tag: string) => (
                      <span class="opacity-80">#{tag}</span>
                    ))}
                  </div>
                </>
              )
            }
          </div>

          <h1
            class="article-title text-4xl tracking-tight text-foreground sm:text-5xl lg:text-6xl"
            style={`view-transition-name: ${postTransitionName};`}
            data-post-transition-title
            data-post-transition-static
          >
            {displayTitle}
          </h1>

          <p class="article-deck text-lg text-muted-foreground border-l border-primary pl-5 py-1">
            {effectiveDescription}
          </p>
        </header>

        {
          post.data.series && (
            <SeriesNavigation seriesId={post.data.series.id} currentPostId={post.id} />
          )
        }

        {post.data.translatedPosts && <LanguageSelector translations={post.data.translatedPosts} />}
      </div>

      <article
        class:list={[
          'article-prose prose max-w-none mt-12 mb-16',
          isModernAiPart4 && 'part4-article',
        ]}
      >
        <Content />
        {isModernAiPart4 && <Part4ReviewCorrections />}
      </article>

      {post.data.showCTA !== false && <CTABlock />}

      <SocialShare client:visible url={canonicalPostUrl} />

      {post.data.showComments !== false && <Comments client:visible />}
    </div>

    <div class="hidden lg:block w-52 flex-shrink-0">
      <TableOfContents client:idle {headings} />
    </div>
  </div>

  <script>
    import '@/scripts/code-block-runtime.js';
  </script>
</Layout>

<style is:global>
  .article-header {
    border-top: 1px solid var(--color-border);
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .article-title {
    max-width: 52rem;
    font-family: var(--font-editorial);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .article-deck {
    max-width: 48rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .article-prose {
    max-width: 49rem;
  }

  .part4-article svg text:not([fill]) {
    fill: currentColor;
  }
</style>
