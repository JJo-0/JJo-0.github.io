---
import Layout from '@/layouts/Layout.astro';
import '@/styles/code-blocks.css';
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/utils/date';
import TableOfContents from '@/components/TableOfContents.svelte';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { resolveSeriesPostTitle } from '@/lib/modern-ai-series';

import Breadcrumbs from '@/components/Breadcrumbs.svelte';
import SocialShare from '@/components/SocialShare.svelte';
import SeriesNavigation from '@/components/SeriesNavigation.astro';
import LanguageSelector from '@/components/LanguageSelector.svelte';
import CTABlock from '@/components/CTABlock.astro';
import Comments from '@/components/Comments.svelte';
import Part4ReviewCorrections from '@/components/post/Part4ReviewCorrections.astro';
import { getBlogPostingSchema, getBreadcrumbSchema } from '@/lib/schemas';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post: CollectionEntry<'posts'>) => ({
    params: { slug: getPostSlug(post) },
    props: post,
  }));
}

type Props = CollectionEntry<'posts'>;

const post = Astro.props as Props;
const { Content, headings } = await render(post);

const effectiveSlug = getPostSlug(post);
const canonicalPostUrl = new URL(Astro.url.pathname, Astro.site).toString();
const displayTitle = resolveSeriesPostTitle(post.data.title, post.data.series);
const postTransitionName = `post-title-${effectiveSlug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const isModernAiPart4 =
  post.data.series?.id === 'modern-artificial-intelligence' && post.data.series.order === 4;

const schemas = [
  getBlogPostingSchema({
    title: displayTitle,
    description: post.data.description,
    pubDate: post.data.pubDate,
    url: canonicalPostUrl,
    lang: post.data.lang,
    image: new URL(`/og/${effectiveSlug}.png`, Astro.site).toString(),
    tags: post.data.tags,
  }),
  getBreadcrumbSchema([
    { name: 'Writing', url: new URL('/posts', Astro.site).toString() },
    { name: displayTitle, url: canonicalPostUrl },
  ]),
];
---

<Layout
  title={displayTitle}
  description={post.data.description}
  lang={post.data.lang}
  ogImage={`/og/${effectiveSlug}.png`}
  ogType="article"
  schema={schemas}
  usesChart={post.data.usesChart}
>
  <Breadcrumbs
    items={[
      { name: 'Writing', href: '/posts' },
      { name: displayTitle, href: '#' },
    ]}
  />

  <div class="reading-shell" data-post-page-slug={effectiveSlug}>
    <div class="reading-main">
      <header class="reading-header">
        <div class="reading-meta">
          <span>Writing / {post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {
            post.data.draft && (
              <span class="text-amber-700 dark:text-amber-300">Draft</span>
            )
          }
        </div>

        <h1
          class="reading-title"
          style={`view-transition-name: ${postTransitionName};`}
          data-post-transition-title
          data-post-transition-static
        >
          {displayTitle}
        </h1>

        <p class="reading-dek">{post.data.description}</p>

        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-x-3 gap-y-2 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-muted-foreground">
              {post.data.tags.map((tag: string) => (
                <span>#{tag}</span>
              ))}
            </div>
          )
        }

        {
          post.data.series && (
            <div class="mt-7">
              <SeriesNavigation seriesId={post.data.series.id} currentPostId={post.id} />
            </div>
          )
        }

        {
          post.data.translatedPosts && (
            <div class="mt-5">
              <LanguageSelector translations={post.data.translatedPosts} />
            </div>
          )
        }
      </header>

      <article class:list={['prose mb-16', isModernAiPart4 && 'part4-article']}>
        <Content />
        {isModernAiPart4 && <Part4ReviewCorrections />}
      </article>

      {post.data.showCTA !== false && <CTABlock />}

      <SocialShare client:visible url={canonicalPostUrl} />

      {post.data.showComments !== false && <Comments client:visible />}
    </div>

    <aside class="reading-aside" aria-label="Article table of contents">
      <TableOfContents client:idle {headings} />
    </aside>
  </div>

  <script>
    import '@/scripts/code-block-runtime.js';
  </script>
</Layout>

<style is:global>
  .part4-article svg text:not([fill]) {
    fill: currentColor;
  }
</style>
