---
import Layout from '@/layouts/Layout.astro';
import AnalyticsSetupGuide from '@/components/AnalyticsSetupGuide.astro';
import { SITE } from '@/config';
import { getPublishedPosts, getPostSlug } from '@/lib/utils/posts';
import { POST_CATEGORIES, getPostCategoryMeta } from '@/lib/taxonomy.mjs';

const posts = await getPublishedPosts();
const catalog = posts.flatMap((post) => {
  const slug = getPostSlug(post);
  const record = {
    title: post.data.title,
    category: post.data.category,
    tags: post.data.tags,
    isNews: post.data.tags.includes('frontier-one') || post.data.tags.includes('frontier-candidate'),
  };
  const paths = ['/posts/' + slug];
  if (post.data.lang.toLowerCase().startsWith('en')) paths.push('/en/posts/' + slug);
  return paths.map((path) => ({ path, ...record }));
});
const dashboardConfig = JSON.stringify({
  clientId: import.meta.env.PUBLIC_GOOGLE_OAUTH_CLIENT_ID || '',
  propertyId: import.meta.env.PUBLIC_GA4_PROPERTY_ID || '',
  gscSiteUrl: import.meta.env.PUBLIC_GSC_SITE_URL || SITE.website + '/',
  siteUrl: SITE.website,
  categories: Object.fromEntries(POST_CATEGORIES.map((key) => [key, getPostCategoryMeta(key).label])),
  catalog,
});
---

<Layout
  title="Analytics Dashboard"
  description="Google API 읽기 권한으로 실제 통계를 조회하는 관리자 분석 화면과 연결 설정 안내입니다."
  noindex={true}
  adsEnabled={false}
>
  <div class="mx-auto max-w-6xl space-y-8" data-analytics-dashboard data-config={dashboardConfig}>
    <header class="border-t border-border pt-10">
      <p class="text-xs font-black uppercase tracking-widest text-muted-foreground">Owner Workspace</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">Blog Analytics</h1>
      <p class="mt-4 max-w-3xl text-muted-foreground">
        Google Analytics 4와 Search Console의 실제 데이터를 읽습니다.
        로그인 토큰은 브라우저 메모리에서만 사용되며 GitHub Pages에 저장하지 않습니다.
      </p>
    </header>
    <section class="rounded-2xl border border-border p-5 sm:p-7" aria-label="분석 계정 연결">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold">Google 계정 연결</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            해당 GA4 속성과 Search Console 속성에 대한 읽기 권한이 필요합니다.
          </p>
        </div>
        <div class="flex gap-2">
          <button type="button" data-admin-login disabled class="rounded-lg bg-primary px-4 py-2 font-bold text-primary-foreground disabled:opacity-50">
            Google로 로그인
          </button>
          <button type="button" data-admin-logout hidden class="rounded-lg border border-border px-4 py-2 font-bold">
            로그아웃
          </button>
        </div>
      </div>
      <p data-admin-status role="status" aria-live="polite" class="mt-4 text-sm text-muted-foreground">
        연결 설정을 확인 중입니다.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        <a class="underline underline-offset-4" href="https://analytics.google.com/" target="_blank" rel="noopener noreferrer">Google Analytics</a>
        {' · '}
        <a class="underline underline-offset-4" href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer">Search Console</a>
      </p>
    </section>

    <AnalyticsSetupGuide oauthConfigured={Boolean(import.meta.env.PUBLIC_GOOGLE_OAUTH_CLIENT_ID)} propertyConfigured={/^\d+$/.test(import.meta.env.PUBLIC_GA4_PROPERTY_ID || '')} />

    <div data-admin-results hidden class="space-y-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-black">방문 통계</h2>
        <label class="flex items-center gap-3 text-sm font-bold">
          조회 기간
          <select data-admin-period class="rounded-lg border border-border bg-background px-3 py-2">
            <option value="1">일간 (어제)</option>
            <option value="7" selected>주간 (지난 7일)</option>
            <option value="30">월간 (지난 30일)</option>
          </select>
        </label>
      </div>
      <p class="text-sm text-muted-foreground">
        GA4 조회수(screenPageViews) 기준. 오늘을 제외한 완료 날짜 구간이며, 처리 지연으로 수치가 수정될 수 있습니다.
      </p>
      <div class="grid gap-5 lg:grid-cols-2">
        <section class="rounded-2xl border border-border p-5">
          <h3 class="mb-4 text-lg font-bold">인기 글 TOP 10</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead><tr class="border-b border-border"><th class="py-2 pr-3">글</th><th class="py-2 text-right">조회수</th></tr></thead>
              <tbody data-admin-top-posts></tbody>
            </table>
          </div>
        </section>
        <section class="rounded-2xl border border-border p-5">
          <h3 class="mb-4 text-lg font-bold">카테고리별 방문량</h3>
          <p class="mb-3 text-xs text-muted-foreground">블로그의 실제 글 카테고리 기준 · News는 별도 구분</p>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead><tr class="border-b border-border"><th class="py-2 pr-3">카테고리</th><th class="py-2 text-right">조회수</th></tr></thead>
              <tbody data-admin-categories></tbody>
            </table>
          </div>
        </section>
      </div>
      <section class="rounded-2xl border border-border p-5">
        <h3 class="mb-3 text-lg font-bold">주제별 관찰</h3>
        <p class="mb-3 text-xs text-muted-foreground">카테고리와 별개로 태그·제목으로 분류한 참고 지표입니다. 중복 집계될 수 있습니다.</p>
        <div data-admin-topics class="flex flex-wrap gap-3 text-sm"></div>
      </section>
      <section class="space-y-4">
        <h2 class="text-2xl font-black">Google 검색 유입</h2>
        <p class="text-sm text-muted-foreground">
          Search Console은 미국 태평양 시간 기준으로 최근 3일을 제외한 확정 데이터만 조회합니다.
          개인정보 보호 및 API 상위 행 제한으로 일부 검색어는 제공되지 않습니다.
        </p>
        <p class="text-sm text-muted-foreground" data-admin-gsc-status></p>
        <div class="grid gap-5 lg:grid-cols-2">
          <div class="rounded-2xl border border-border p-5">
            <h3 class="mb-4 text-lg font-bold">유입 검색어 TOP 20</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead><tr class="border-b border-border"><th class="py-2 pr-3">검색어</th><th class="py-2 text-right">클릭</th><th class="py-2 text-right">노출</th></tr></thead>
                <tbody data-admin-queries></tbody>
              </table>
            </div>
          </div>
          <div class="rounded-2xl border border-border p-5">
            <h3 class="mb-4 text-lg font-bold">검색 유입 페이지 TOP 10</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead><tr class="border-b border-border"><th class="py-2 pr-3">페이지</th><th class="py-2 text-right">클릭</th><th class="py-2 text-right">CTR</th></tr></thead>
                <tbody data-admin-search-pages></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  type CatalogEntry = { path: string; title: string; category: string; tags: string[]; isNews: boolean };
  type DashboardConfig = {
    clientId: string;
    propertyId: string;
    gscSiteUrl: string;
    siteUrl: string;
    categories: Record<string, string>;
    catalog: CatalogEntry[];
  };
  type TokenClient = { requestAccessToken: (options?: { prompt?: string }) => void };
  type ReportRow = {
    dimensionValues?: { value: string }[];
    metricValues?: { value: string }[];
  };
  type SearchRow = { keys: string[]; clicks: number; impressions: number; ctr: number; position: number };
  let accessToken: string | null = null;
  let activeRoot: HTMLElement | null = null;
  let activeClient: TokenClient | null = null;
  let reportRequest: AbortController | null = null;
  let tokenExpiryTimer: ReturnType<typeof setTimeout> | null = null;
  let reportEpoch = 0;

  function clearReportSession(root: HTMLElement | null, message?: string) {
    accessToken = null;
    reportEpoch += 1;
    reportRequest?.abort();
    reportRequest = null;
    if (tokenExpiryTimer) clearTimeout(tokenExpiryTimer);
    tokenExpiryTimer = null;
    if (!root) return;
    for (const selector of ['[data-admin-top-posts]', '[data-admin-categories]', '[data-admin-topics]', '[data-admin-queries]', '[data-admin-search-pages]', '[data-admin-gsc-status]']) {
      root.querySelector(selector)?.replaceChildren();
    }
    element<HTMLElement>(root, '[data-admin-results]').hidden = true;
    element<HTMLButtonElement>(root, '[data-admin-logout]').hidden = true;
    element<HTMLButtonElement>(root, '[data-admin-login]').hidden = false;
    if (message) status(root, message);
  }

  function element<T extends HTMLElement>(root: HTMLElement, selector: string): T {
    const target = root.querySelector<T>(selector);
    if (!target) throw new Error('Dashboard control missing: ' + selector);
    return target;
  }

  async function loadGoogleIdentity() {
    if ((window as any).google?.accounts?.oauth2) return;
    const existing = document.querySelector<HTMLScriptElement>('script[data-admin-google-login]');
    if (existing) {
      await new Promise<void>((resolve, reject) => {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('Google Identity SDK unavailable')), { once: true });
      });
      return;
    }
    await new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://accounts.google.com/gsi/client';
      script.async = true;
      script.dataset.adminGoogleLogin = 'true';
      script.onload = () => resolve();
      script.onerror = () => {
        script.remove();
        reject(new Error('Google Identity SDK unavailable'));
      };
      document.head.append(script);
    });
  }

  function normalizePath(input: string): string | null {
    try {
      const url = new URL(input, 'https://jjo-0.github.io');
      if (url.origin !== 'https://jjo-0.github.io') return null;
      const path = url.pathname.replace(/\/+$/, '');
      if (!/^\/(?:en\/)?posts\/[^/]+$/.test(path)) return null;
      return path;
    } catch {
      return null;
    }
  }

  function resetRows(parent: HTMLElement, message: string) {
    parent.replaceChildren();
    const row = document.createElement('tr');
    const cell = document.createElement('td');
    cell.colSpan = 3;
    cell.className = 'py-4 text-muted-foreground';
    cell.textContent = message;
    row.append(cell);
    parent.append(row);
  }

  function appendRow(parent: HTMLElement, first: string, second: string, third?: string, href?: string) {
    const tr = document.createElement('tr');
    tr.className = 'border-b border-border/60';
    const c1 = document.createElement('td');
    c1.className = 'py-2 pr-3';
    if (href) {
      const a = document.createElement('a');
      a.href = href;
      a.className = 'underline underline-offset-2 hover:text-primary';
      a.textContent = first;
      c1.append(a);
    } else {
      c1.textContent = first;
    }
    const c2 = document.createElement('td');
    c2.className = 'py-2 text-right tabular-nums';
    c2.textContent = second;
    tr.append(c1, c2);
    if (third !== undefined) {
      const c3 = document.createElement('td');
      c3.className = 'py-2 text-right tabular-nums';
      c3.textContent = third;
      tr.append(c3);
    }
    parent.append(tr);
  }

  const number = (value: number) => new Intl.NumberFormat('ko-KR').format(value);
  const status = (root: HTMLElement, message: string) => {
    element<HTMLElement>(root, '[data-admin-status]').textContent = message;
  };

  async function authorizedPost(url: string, body: unknown, signal: AbortSignal): Promise<any> {
    const response = await fetch(url, {
      method: 'POST',
      headers: { Authorization: 'Bearer ' + accessToken, 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      cache: 'no-store',
      signal,
    });
    if (!response.ok) {
      // Only Google's bounded error codes are shown; never echo response messages,
      // headers or tokens into the page or logs.
      const payload = await response.json().catch(() => null);
      const reason = payload?.error?.details?.find((detail: { reason?: unknown }) =>
        typeof detail.reason === 'string' && /^[A-Z_]{1,80}$/.test(detail.reason)
      )?.reason;
      const hint = response.status === 401 ? 'Google 인증 세션을 다시 연결해 주세요.' : '속성 ID·API 활성화·계정 권한을 확인해 주세요.';
      throw Object.assign(new Error('Google API HTTP ' + response.status + (reason ? ' [' + reason + ']' : '') + ' · ' + hint), { status: response.status });
    }
    return response.json();
  }

  function renderGA(root: HTMLElement, config: DashboardConfig, report: { rows?: ReportRow[] }) {
    const catalog = new Map(config.catalog.map((post) => [post.path.replace(/\/+$/, ''), post]));
    const grouped = new Map<string, number>();
    for (const row of report.rows ?? []) {
      const path = normalizePath(row.dimensionValues?.[0]?.value ?? '');
      if (!path) continue;
      const views = Number(row.metricValues?.[0]?.value);
      if (!Number.isFinite(views) || views <= 0) continue;
      grouped.set(path, (grouped.get(path) || 0) + views);
    }
    const ranked = [...grouped.entries()].sort((a, b) => b[1] - a[1]);
    const top = element<HTMLElement>(root, '[data-admin-top-posts]');
    const categories = element<HTMLElement>(root, '[data-admin-categories]');
    const topics = element<HTMLElement>(root, '[data-admin-topics]');
    top.replaceChildren();
    categories.replaceChildren();
    topics.replaceChildren();

    for (const [path, views] of ranked.slice(0, 10)) {
      appendRow(top, catalog.get(path)?.title || path, number(views), undefined, path);
    }
    if (!ranked.length) resetRows(top, '해당 기간에 집계된 게시물 조회수가 없습니다.');

    const categoryTotals = new Map<string, number>();
    const topicTotals = new Map<string, number>();
    for (const [path, views] of ranked) {
      const post = catalog.get(path);
      const category = post?.isNews ? 'News' : (config.categories[post?.category || ''] || '기타·이전 경로');
      categoryTotals.set(category, (categoryTotals.get(category) || 0) + views);
      if (!post) continue;
      const terms = (post.tags || []).join(' ') + ' ' + post.title;
      const semanticTopics = [
        ['Semiconductor', /semiconductor|반도체|wafer|chip|fab|lithography/i],
        ['Robotics', /robot|로봇|ros2|slam|physical.ai/i],
        ['AI / ML', /machine.learning|\bai\b|llm|transformer|learning/i],
        ['Research', /research|논문|paper|deep.research/i],
      ] as const;
      for (const [topic, pattern] of semanticTopics) {
        if (pattern.test(terms)) topicTotals.set(topic, (topicTotals.get(topic) || 0) + views);
      }
    }
    for (const [name, views] of [...categoryTotals].sort((a, b) => b[1] - a[1])) {
      appendRow(categories, name, number(views));
    }
    if (!categoryTotals.size) resetRows(categories, '집계 데이터가 없습니다.');
    for (const [name, views] of [...topicTotals].sort((a, b) => b[1] - a[1])) {
      const badge = document.createElement('span');
      badge.className = 'rounded-lg border border-border px-3 py-2';
      badge.textContent = name + ' · ' + number(views) + '회';
      topics.append(badge);
    }
    if (!topicTotals.size) topics.textContent = '태그 기반 주제별 조회수가 없습니다.';
  }

  function pacificDate(daysAgo: number) {
    const date = new Date(Date.now() - daysAgo * 86400000);
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit',
    }).formatToParts(date);
    const value = (type: string) => parts.find((part) => part.type === type)?.value || '';
    return value('year') + '-' + value('month') + '-' + value('day');
  }

  function renderGSC(root: HTMLElement, config: DashboardConfig, searchQueries: SearchRow[], searchPages: SearchRow[]) {
    const queries = element<HTMLElement>(root, '[data-admin-queries]');
    const pages = element<HTMLElement>(root, '[data-admin-search-pages]');
    queries.replaceChildren();
    pages.replaceChildren();
    for (const query of searchQueries.slice(0, 20)) {
      appendRow(queries, query.keys?.[0] || '(기타)', number(query.clicks), number(query.impressions));
    }
    if (!searchQueries.length) resetRows(queries, '제공 가능한 검색어 데이터가 없습니다.');
    for (const page of searchPages.slice(0, 10)) {
      const rawUrl = page.keys?.[0] || '';
      let href: string | undefined;
      try {
        const target = new URL(rawUrl);
        if (target.origin === new URL(config.siteUrl).origin) href = target.href;
      } catch { /* Reject unknown external URLs. */ }
      appendRow(pages, href ? new URL(href).pathname : rawUrl, number(page.clicks), (page.ctr * 100).toFixed(1) + '%', href);
    }
    if (!searchPages.length) resetRows(pages, '제공 가능한 검색 페이지 데이터가 없습니다.');
  }

  async function loadReports(root: HTMLElement, config: DashboardConfig) {
    if (!accessToken || activeRoot !== root) return;
    reportRequest?.abort();
    const request = new AbortController();
    reportRequest = request;
    const epoch = ++reportEpoch;
    const days = Number(element<HTMLSelectElement>(root, '[data-admin-period]').value);
    const googleProperty = config.propertyId;
    status(root, '분석 데이터를 조회하고 있습니다.');
    element<HTMLElement>(root, '[data-admin-results]').hidden = false;
    for (const selector of ['[data-admin-top-posts]', '[data-admin-categories]', '[data-admin-queries]', '[data-admin-search-pages]']) {
      resetRows(element(root, selector), '조회 중입니다.');
    }
    element(root, '[data-admin-topics]').replaceChildren();
    element(root, '[data-admin-gsc-status]').replaceChildren();
    const gaRequest = authorizedPost(
      'https://analyticsdata.googleapis.com/v1beta/properties/' + googleProperty + ':runReport',
      {
        dateRanges: [{ startDate: days + 'daysAgo', endDate: 'yesterday' }],
        dimensions: [{ name: 'pagePath' }],
        metrics: [{ name: 'screenPageViews' }],
        dimensionFilter: { filter: { fieldName: 'pagePath', stringFilter: { matchType: 'PARTIAL_REGEXP', value: '^/(en/)?posts/' } } },
        orderBys: [{ metric: { metricName: 'screenPageViews' }, desc: true }],
        limit: 10000,
      }, request.signal
    );
    const site = encodeURIComponent(config.gscSiteUrl);
    const gscDays = days === 1 ? 1 : days;
    const baseGsc = { startDate: pacificDate(gscDays + 2), endDate: pacificDate(3), type: 'web', dataState: 'final', rowLimit: 200 };
    const queriesRequest = authorizedPost('https://www.googleapis.com/webmasters/v3/sites/' + site + '/searchAnalytics/query', { ...baseGsc, dimensions: ['query'] }, request.signal);
    const pagesRequest = authorizedPost('https://www.googleapis.com/webmasters/v3/sites/' + site + '/searchAnalytics/query', { ...baseGsc, dimensions: ['page'] }, request.signal);

    const [ga, queries, pages] = await Promise.allSettled([gaRequest, queriesRequest, pagesRequest]);
    if (request.signal.aborted || epoch !== reportEpoch || activeRoot !== root || !accessToken) return;
    const authFailure = [ga, queries, pages].find((result) => result.status === 'rejected' && result.reason?.status === 401);
    if (authFailure?.status === 'rejected') {
      clearReportSession(root, authFailure.reason.message);
      return;
    }
    if (ga.status === 'fulfilled') {
      renderGA(root, config, ga.value);
      status(root, '방문 통계를 갱신했습니다. Search Console의 검색 유입 수치는 아래에서 확인할 수 있습니다.');
    } else {
      status(root, 'GA4 조회 실패: ' + ga.reason.message);
      resetRows(element(root, '[data-admin-top-posts]'), 'GA4 조회가 실패했습니다.');
      resetRows(element(root, '[data-admin-categories]'), 'GA4 조회가 실패했습니다.');
    }
    if (queries.status === 'fulfilled' && pages.status === 'fulfilled') {
      renderGSC(root, config, queries.value.rows || [], pages.value.rows || []);
      element<HTMLElement>(root, '[data-admin-gsc-status]').textContent =
        '확정 데이터 기간(태평양 시간): ' + baseGsc.startDate + ' ~ ' + baseGsc.endDate;
    } else {
      const reason = queries.status === 'rejected' ? queries.reason : pages.status === 'rejected' ? pages.reason : null;
      element<HTMLElement>(root, '[data-admin-gsc-status]').textContent =
        'Search Console 조회 실패: ' + (reason?.message || 'API 접근 확인 필요');
      resetRows(element(root, '[data-admin-queries]'), 'Search Console 조회가 실패했습니다.');
      resetRows(element(root, '[data-admin-search-pages]'), 'Search Console 조회가 실패했습니다.');
    }
  }

  function initializeDashboard() {
    const root = document.querySelector<HTMLElement>('[data-analytics-dashboard]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    activeRoot = root;
    let config: DashboardConfig;
    try {
      config = JSON.parse(root.dataset.config || '') as DashboardConfig;
    } catch {
      status(root, '대시보드 설정 오류입니다.');
      return;
    }
    const login = element<HTMLButtonElement>(root, '[data-admin-login]');
    const logout = element<HTMLButtonElement>(root, '[data-admin-logout]');
    const period = element<HTMLSelectElement>(root, '[data-admin-period]');
    if (!config.clientId || !/^\d+$/.test(config.propertyId)) {
      status(root, '설정 필요: GitHub Actions 변수 PUBLIC_GOOGLE_OAUTH_CLIENT_ID와 PUBLIC_GA4_PROPERTY_ID를 등록해야 합니다. 설정 문서: spaceship-ui/docs/analytics-dashboard.md');
      return;
    }
    loadGoogleIdentity()
      .then(() => {
        if (activeRoot !== root || !root.isConnected) return;
        const google = (window as any).google;
        activeClient = google.accounts.oauth2.initTokenClient({
          client_id: config.clientId,
          scope: 'https://www.googleapis.com/auth/analytics.readonly https://www.googleapis.com/auth/webmasters.readonly',
          callback: (result: { access_token?: string; error?: string; expires_in?: number }) => {
            if (activeRoot !== root) return;
            if (result.error || !result.access_token) {
              status(root, 'Google 인증이 완료되지 않았습니다. ' + (result.error || ''));
              return;
            }
            clearReportSession(root);
            accessToken = result.access_token;
            const lifetime = Number(result.expires_in);
            if (Number.isFinite(lifetime) && lifetime > 0) {
              tokenExpiryTimer = setTimeout(() => clearReportSession(root, 'Google 연결이 만료됐습니다. 다시 로그인해 주세요.'), Math.min(lifetime * 1000, 2147483647));
            }
            login.hidden = true;
            logout.hidden = false;
            void loadReports(root, config);
          },
        });
        login.disabled = false;
        status(root, '준비 완료. Google 계정으로 인증하면 실제 통계를 조회합니다.');
      })
      .catch(() => {
        if (activeRoot === root && root.isConnected) status(root, 'Google 로그인 SDK를 불러올 수 없습니다. 네트워크를 확인하세요.');
      });
    login.addEventListener('click', () => activeClient?.requestAccessToken({ prompt: 'select_account' }));
    logout.addEventListener('click', () => {
      const token = accessToken;
      clearReportSession(root, '로그아웃했습니다. 계정을 다시 연결할 수 있습니다.');
      if (token) (window as any).google?.accounts?.oauth2?.revoke(token, () => {});
    });
    period.addEventListener('change', () => { if (accessToken) void loadReports(root, config); });
  }

  initializeDashboard();
  document.addEventListener('astro:page-load', initializeDashboard);
  document.addEventListener('astro:before-swap', () => {
    clearReportSession(activeRoot);
    activeRoot = null;
    activeClient = null;
  });
</script>
