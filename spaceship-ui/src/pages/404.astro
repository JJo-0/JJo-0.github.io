---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="404: Page Not Found"
  description="The requested page does not exist. Use the sitemap, llms.txt, research map, or writing archive to recover."
  noindex
>
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <span class="text-8xl sm:text-9xl font-black text-primary/10 select-none">404</span>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-foreground -mt-8 sm:-mt-12 mb-6"
    >
      Page not found
    </h1>
    <p class="text-lg text-muted-foreground mb-10 max-w-md mx-auto">
      The page you were looking for doesn't exist or has been moved. Use the public indexes below
      to find the canonical page instead of guessing another path.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-bold hover:scale-105 transition-all no-underline"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Back to Home
      </a>
      <a
        href="/posts"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-secondary text-foreground font-bold hover:bg-accent transition-all no-underline"
      >
        Read the Blog
      </a>
    </div>

    <section
      class="mt-10 w-full max-w-xl rounded-2xl border border-border/70 bg-card/40 p-5 text-left"
      aria-labelledby="agent-recovery-heading"
      data-agent-recovery
    >
      <h2 id="agent-recovery-heading" class="mb-2 text-base font-bold text-foreground">
        Agent recovery
      </h2>
      <p class="mb-3 text-sm leading-6 text-muted-foreground">
        Automated clients should recover from this 404 through a machine-readable index or a known
        public section:
      </p>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a class="font-semibold text-foreground" href="/llms.txt">/llms.txt</a> — task-oriented agent guidance</li>
        <li><a class="font-semibold text-foreground" href="/sitemap-index.xml">/sitemap-index.xml</a> — canonical public URL discovery</li>
        <li><a class="font-semibold text-foreground" href="/research">/research</a> — research map and focus areas</li>
        <li><a class="font-semibold text-foreground" href="/posts">/posts</a> — technical writing archive</li>
      </ul>
    </section>
  </div>
</Layout>
