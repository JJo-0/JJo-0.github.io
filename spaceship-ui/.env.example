# Optional build-time public variables
# Copy to .env for local development or configure as GitHub Actions Variables/Secrets.

PUBLIC_GOOGLE_ANALYTICS_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_NAVER_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Public (not secret) browser-only OAuth dashboard configuration
PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
PUBLIC_GA4_PROPERTY_ID=
PUBLIC_GSC_SITE_URL=https://jjo-0.github.io/
# Automated export uses GitHub OIDC; no JSON private key is created.
# Configure GA4_WORKLOAD_IDENTITY_PROVIDER and GA4_SERVICE_ACCOUNT_EMAIL in Actions Variables.
# GA4_ACCESS_TOKEN is generated for the export step only. Never store it in .env.
