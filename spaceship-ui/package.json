{
  "name": "spaceship",
  "type": "module",
  "version": "1.3.0",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/rendered-markdown-audit.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "lefthook install",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check:all": "pnpm check && pnpm lint",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:fix-desc": "node scripts/seo-fix-desc.mjs",
    "post:check": "node scripts/post-content-contract.mjs",
    "taxonomy:check": "node scripts/taxonomy-contract.mjs && python3 ../scripts/normalize_tags_current.py --check",
    "runtime:check": "node scripts/runtime-contract.mjs",
    "code-block:check": "node scripts/code-block-contract.mjs",
    "category-route:check": "node scripts/category-route-contract.mjs",
    "semiconductor:check": "node scripts/semiconductor-universe-audit.mjs",
    "semiconductor:links-check": "node scripts/semiconductor-company-links-audit.mjs",
    "semiconductor:private-links-check": "node scripts/semiconductor-private-company-links-audit.mjs",
    "semiconductor:global-links-check": "node scripts/semiconductor-global-company-links-audit.mjs",
    "semiconductor:process-links-check": "node scripts/semiconductor-process-resources-audit.mjs",
    "semiconductor:process-hardening-check": "node scripts/semiconductor-process-hardening-audit.mjs",
    "semiconductor:component-links-check": "node scripts/semiconductor-equipment-component-links-audit.mjs",
    "experience:check": "node scripts/experience-contract.mjs",
    "adaptive:check": "node scripts/adaptive-performance-contract.mjs",
    "renderer-retry:check": "node scripts/renderer-retry-contract.mjs",
    "renderer:check": "node scripts/renderer-contract.mjs",
    "transition:check": "node scripts/transition-contract.mjs",
    "modern-ai:check": "node scripts/modern-ai-series-audit.mjs",
    "modern-ai:part1-reader-check": "node scripts/modern-ai-part1-reader-audit.mjs",
    "modern-ai:part2-check": "node scripts/modern-ai-part2-audit.mjs",
    "modern-ai:part3-check": "node scripts/modern-ai-part3-audit.mjs",
    "modern-ai:part4-check": "node scripts/modern-ai-part4-audit.mjs && node scripts/modern-ai-part4-provenance-audit.mjs",
    "modern-ai:lesson-check": "node scripts/modern-ai-formula-lesson-audit.mjs",
    "modern-ai:part3-lesson-check": "node scripts/modern-ai-part3-lesson-audit.mjs",
    "modern-ai:part4-lesson-check": "node scripts/modern-ai-part4-lesson-audit.mjs",
    "formula-guide:check": "node scripts/formula-guide-context-contract.mjs",
    "content:check": "pnpm taxonomy:check && pnpm post:check && node scripts/content-integrity.mjs && node scripts/modern-ai-formula-audit.mjs && pnpm modern-ai:check && pnpm modern-ai:part1-reader-check && pnpm modern-ai:part2-check && pnpm modern-ai:part3-check && pnpm modern-ai:part4-check && pnpm modern-ai:lesson-check && pnpm modern-ai:part3-lesson-check && pnpm modern-ai:part4-lesson-check && pnpm formula-guide:check && pnpm runtime:check && pnpm code-block:check && pnpm category-route:check && pnpm semiconductor:check && pnpm semiconductor:links-check && pnpm semiconductor:private-links-check && pnpm semiconductor:global-links-check && pnpm semiconductor:process-links-check && pnpm semiconductor:process-hardening-check && pnpm semiconductor:component-links-check && pnpm experience:check && pnpm adaptive:check && pnpm renderer-retry:check && pnpm renderer:check && pnpm transition:check && pnpm rendered:check",
    "rendered:check": "node scripts/rendered-content-quality.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.5",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource/outfit": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.5",
    "gsap": "^3.13.0",
    "katex": "^0.18.4",
    "mermaid": "^11.13.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "satori": "^0.25.0",
    "satori-html": "^0.3.2",
    "svelte": "^5.53.13",
    "tailwindcss": "^4.2.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.1",
    "@astrojs/svelte": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@evilmartians/lefthook": "^2.1.4",
    "@types/three": "0.185.3",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-svelte": "^3.15.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte-check": "^4.4.5",
    "svelte-eslint-parser": "^1.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1"
    }
  }
}
